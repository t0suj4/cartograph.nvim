gainst the bound', function ()\n    local times = { ['/wt/HEAD'] = { 10, 11, 30, 10, 10 }, ['/repo'] = { 10.5, 10.8, 10.4, 11, 10.6 } }\n    local i = { ['/wt/HEAD'] = 0, ['/repo'] = 0 }\n    local env = fake(function (dir) i[dir] = i[dir] + 1; return ('x %s ms'):format(times[dir][i[dir]]) end)\n    local r = X.run({ baseline = 'HEAD', instruments = { { kind = 'ab', file = '/abs/t.lua', extract = 'x ([%d.]+) ms', runs = 5, bound = 1.10 } } }, env)\n    local seq = {}\n    for _, c in ipairs(env.calls) do seq[#seq + 1] = c.dir == '/wt/HEAD' and 'B' or 'V' end\n    eq('BVBVBVBVBV', table.concat(seq), 'interleaved')\n    eq({ 10, 10.6 }, { r.rows[1].baseline, r.rows[1].variant }, 'the medians — the outlier 30 does not move them')\n    eq(true, r.rows[1].pass, '10.6 <= 10 x 1.10')\n    local slow = X.run({ baseline = 'HEAD', instruments = { { kind = 'ab', file = '/abs/t.lua', extract = 'x ([%d.]+) ms', runs = 1, bound = 1.01 } } },\n        fake(function (dir) return dir == '/repo' and 'x 20 ms' or 'x 10 ms' end))\n    eq(false, slow.rows[1].pass)\nend)\n\ntest('experiment: a relative instrument file is the VARIANT checkout\\'s, on both sides; worktrees are dropped even when an instrument raises', function ()\n    local env = fake(function (dir, argv) error('boom in ' .. dir) end)\n    local r = X.run({ baseline = 'HEAD', instruments = { { kind = 'join', file = 'tools/x.lua' } } }, env)\n    eq(false, r.rows[1].pass); ok(tostring(r.rows[1].detail):find('raised', 1, true), r.rows[1].detail)\n    eq({ '/wt/HEAD' }, env.dropped, 'the baseline worktree is removed')\n    local env2 = fake(function () return 'ROW\\tk\\tv\\n' end)\n    X.run({ baseline = 'HEAD', instruments = { { kind = 'join', file = 'tools/x.lua' } } }, env2)\n    for _, c in ipairs(env2.calls) do ok(c.argv:find('@/repo/tools/x.lua', 1, true), 'both sides run the variant\\'s instrument: ' .. c.argv) end\nend)\n\ntest('experiment: a check instrument passes on its pattern; an unknown kind is a failing row, not an accept', function ()\n    local r = X.run({ instruments = { { kind = 'check', file = '/abs/c.lua', pattern = '0 refused;.*, 0 differ;' }, { kind = 'nope' } } },\n        fake(function () return 'CMREG 33 compiled, 0 refused; compile 2.1 s; residual 411 KB; 7000 subjects, 0 differ; match\\n' end))\n    eq(true, r.rows[1].pass); eq(false, r.rows[2].pass); eq(false, r.accept)\nend)\n\ntest('experiment: a tactic with compare = <pattern> is NO REGRESSION — the same capture as the baseline passes, whatever the claim', function ()\n    local P = '(%d+ agree, %d+ differ, %d+ no sample, %d+ refused)'\n    local function out(t) return '{\\n  holds = false,\\n  why = \"' .. t .. ' (plain) — first: resolve refused\",\\n  value = {}\\n}\\n' end\n    local same = X.run({ baseline = 'HEAD', instruments = { { kind = 'tactic', tactic = 'derive-accept', compare = P } } },\n        fake(function () return out('27 agree, 0 differ, 6 no sample, 1 refused') end))\n    eq(true, same.rows[1].pass, same.rows[1].detail)\n    local worse = X.run({ baseline = 'HEAD', instruments = { { kind = 'tactic', tactic = 'derive-accept', compare = P } } },\n        fake(function (dir) return out(dir == '/repo' and '26 agree, 1 differ, 6 no sample, 1 refused' or '27 agree, 0 differ, 6 no sample, 1 refused') end))\n    eq(false, worse.rows[1].pass)\n    eq('baseline 27 agree, 0 differ, 6 no sample, 1 refused -> variant 26 agree, 1 differ, 6 no sample, 1 refused', worse.rows[1].detail)\n    local nobase = X.run({ instruments = { { kind = 'tactic', tactic = 'derive-accept', compare = P } } }, fake(function () return out('1 agree, 0 differ, 0 no sample, 0 refused') end))\n    eq(false, nobase.rows[1].pass, 'compare needs a baseline')\nend)"}},"bytes":812},{"decided_by":"tactic","id":"1791397852.339856-edit","decisions":[],"verb":"edit","invocation":{"verb":"edit","touched":[".claude/skills/cartograph/references/questions.md"],"args":{"after":"| Does every algebra DERIVATION, COMPILED by mix, agree with itself interpreted — on the arguments a real suite passes? (the compiler's acceptance; also its code size) | `nvim --headless -u NONE -l tools/toolbelt.lua run derive-accept - [ops=a,b] [through=1] [opaque=M.x,…] [reuse=eager] [cap=12] [suite=<spec.lua>] [plant=<op>]` — the suite (default the vendored donor suite) runs under a permissive busted shim with the derivations bound into the algebra; each operator's first `cap` distinct argument lists are TAPPED; its closure is assembled (mixalg.program; `through=1` follows the basis, `opaque` kept primitives — default admits / admits_slice / match / entails), specialized all-dynamic (`reuse=eager` for the eager policy) and run on every sample against the interpreted derivation. Rows: class agree / differ / nosample / refused, the first differing sample, residual BYTES and FUNCTIONS (and dead functions dropped). CLAIM: none differs, none refused, something compared, and the CONTROL held (two different results of a derivation compared as different — a dead comparison would call every residual right); `plant=<op>` is the negative control (that op's compiled result altered: it must read differ). 2026-10-06: plain 27 agree / 0 differ / 6 no sample / 1 refused (resolve, CART-1505) in 1,757,156 B; through the same, 4,781,341 B. `static=first [groups=4]`: each op's samples GROUPED by their first argument, a residual specialized to each (the compiled form of a template-first verb) — 2026-10-07 through: 23 agree / 2 differ (dig, rewrite: pre-existing) / 3 refused. Restores the algebra table and the JIT it switches off. ⚠ COVERAGE (CART-1538): each row carries `cov = { lines, lines_hit, arms, arms_hit }` — how much of its RESIDUAL the tapped samples ran (a line hook in the guard; an arm counts when its first statement ran) — and the claim line says it: 2026-10-07 plain, 21.0% of lines and 14.5% of branch arms (match 37 of 491 arms, primary_key 8 of 506). \"agree\" is about the paths the suite reaches. THE DERIVED CLIENT (`fuzz=N [points=8] [keep=0.4] [seed=1538]`, CART-1538): fnpeer turns each operator's case split into a peergen model and the generated client drives the derivation interpreted and its residual with N more seeded inputs; rows carry `fuzz` counts (ok / ok differ / err / err with another message / mixed / budget / decode) and any ok-differ, mixed or message difference makes the row DIFFER. 2026-10-07, fuzz=120: 26 agree / 1 differ (generalize, a real bug, CART-1540), arms 14.5% -> 21.8% over 2,760 inputs; without fuzz the run is unchanged. SYNTHESIZED SAMPLES (CART-1538): an operator the suite never calls gets arguments built from OTHER operators' samples and NATIVE results (diff_regions: pairs of sampled terms; unit / admits_template: a sampled template and one of its holes; extract_call / extract_call_of: native extract's record and its call's term; kv_eq: kv_generalize's records) — rows carry `synthesized`; and a call's ARGUMENTS after it are compared too (diff_regions answers into `out`). 2026-10-07: 33 agree, 0 differ, 0 no sample, 1 refused (resolve, CART-1505), plain and through. CART-1483 |","file":".claude/skills/cartograph/references/questions.md","before":"| Does every algebra DERIVATION, COMPILED by mix, agree with itself interpreted — on the arguments a real suite passes? (the compiler's acceptance; also its code size) | `nvim --headless -u NONE -l tools/toolbelt.lua run derive-accept - [ops=a,b] [through=1] [opaque=M.x,…] [reuse=eager] [cap=12] [suite=<spec.lua>] [plant=<op>]` — the suite (default the vendored donor suite) runs under a permissive busted shim with the derivations bound into the algebra; each operator's first `cap` distinct argument lists are TAPPED; its closure is assembled (mixalg.program; `through=1` follows the basis, `opaque` kept primitives — default admits / admits_slice / match / entails), specialized all-dynamic (`reuse=eager` for the eager policy) and run on every sample against the interpreted derivation. Rows: class agree / differ / nosample