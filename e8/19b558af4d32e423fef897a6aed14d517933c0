 ['values.yaml'] = 'image:\\n  repo: shop\\n  tag: \"1.2\"\\nport: 8080\\nextra: false\\n',\n    ['templates/_helpers.tpl'] = '{{- define \"shop.image\" -}}\\n{{ .Values.image.repo }}:{{ .Values.image.tag }}\\n{{- end -}}\\n',\n    ['templates/deployment.yaml'] = table.concat({\n        'apiVersion: apps/v1', 'kind: Deployment', 'metadata:', '  name: {{ .Release.Name }}-shop', 'spec:',\n        '  template:', '    spec:', '      containers:', '      - name: shop', '        image: {{ include \"shop.image\" . }}',\n        '        ports:', '        - containerPort: {{ .Values.port }}',\n        '{{- if .Values.extra }}', '        args: [--extra]', '{{- end }}', '  minReadySeconds: {{ len .Values.image }}' }, '\\n') .. '\\n',\n}\nlocal function read(p) local fd = assert(io.open(p)); local s = fd:read('a'); fd:close(); return s end\nlocal function docs(text) -- the YAML documents of a render, comments and separators dropped\n    local out = {}\n    for d in (text .. '\\n---\\n'):gmatch('(.-)\\n?%-%-%-[^\\n]*\\n') do\n        d = vim.trim((d:gsub('# Source:[^\\n]*\\n?', '')))\n        if d ~= '' then out[#out + 1] = d end\n    end\n    return out\nend\n\ntest('helmprov: the render IS Helm\\'s — every file\\'s documents equal `helm template`\\'s', function ()\n    ready()\n    if not H.binary() then skip 'no helm binary to compare against' end\n    local root = chart(CHART)\n    local p = assert(P.render(root, { release = 'r1' }))\n    local R = assert(H.render(root, { release = 'r1' }))\n    local n = 0\n    for _, rel in ipairs(R.files) do\n        local f = p.files[rel]\n        ok(f, 'helmprov renders ' .. rel)\n        eq(docs(read(R.dir .. '/' .. rel)), docs(f.content), rel)\n        n = n + 1\n    end\n    eq(1, n, 'one rendered file (the helper renders nothing)')\nend)\n\ntest('helmprov: every TEXT span reproduces the template source at its location; an action sits just inside its {{', function ()\n    ready()\n    local root = chart(CHART)\n    local p = assert(P.render(root, { release = 'r1' }))\n    local f = p.files['shop/templates/deployment.yaml']\n    ok(f and #f.spans > 0, 'spans recorded')\n    local src = vim.split(read(root .. '/templates/deployment.yaml'), '\\n', { plain = true })\n    local text, action, prev = 0, 0, 0\n    for _, sp in ipairs(f.spans) do\n        ok(sp.start >= prev, 'spans in order, not overlapping')\n        prev = sp['end']\n        local file, line, col = P.loc(sp.loc)\n        if file == 'templates/deployment.yaml' then\n            local at = table.concat(src, '\\n', line):sub(col + 1)\n            if sp.kind == 'text' then\n                eq(f.content:sub(sp.start + 1, sp['end']), at:sub(1, sp['end'] - sp.start), sp.loc)\n                text = text + 1\n            else\n                local before = table.concat(src, '\\n', line):sub(1, col)\n                ok(before:match('{{%-?%s*$'), sp.loc .. ' is the pipeline just inside an action\\'s {{'); action = action + 1\n            end\n        end\n    end\n    ok(text > 0 and action > 0, ('both kinds checked (%d text, %d action)'):format(text, action))\nend)\n\ntest('helmprov: USES of a values path — inside an included helper, by ancestor and descendant; an unread branch is absent', function ()\n    ready()\n    local p = assert(P.render(chart(CHART), { release = 'r1' }))\n    local function sites(path) local l = {} for _, u in ipairs(P.uses(p, path)) do l[#l + 1] = u.path .. '@' .. u.file .. ':' .. u.line end return l end\n    eq({ 'image.repo@templates/_helpers.tpl:2', 'image.tag@templates/_helpers.tpl:2' }, sites('image'),\n        'the reads sit in the HELPER, where `.Values.image.*` is evaluated, not on the include line')\n    eq({ 'image.tag@templates/_helpers.tpl:2', 'image@templates/deployment.yaml:16' }, sites('image.tag'),\n        '`len .Values.image` reads all of image, so it is a use of image.tag')\n    eq({ 'port@templates/deployment.yaml:12' }, sites('port'))\n    eq({ 'extra@templates/deployment.yaml:13' }, sites('extra'), 'the condition is a read')\n    eq({}, sites('nope'))\nend)\n\ntest('helmprov: POSITION of a rendered byte and LOCATE of a document\\'s text map back to the template', function ()\n    ready()\n    local p = assert(P.render(chart(CHART), { release = 'r1' }))\n    local name = 'shop/templates/deployment.yaml'\n    local c = p.files[name].content\n    local b = c:find('containerPort', 1, true) - 1\n    local file, line, col, kind = P.position(p, name, b)\n    eq({ 'templates/deployment.yaml', 12, 10, 'text' }, { file, line, col, kind }, 'inside a text span: exact')\n    local l = assert(P.locate(p, 'Deployment', 'r1-shop', 'shop:1.2'))\n    eq('templates/deployment.yaml', l.file); eq(10, l.line); ok(l.kind ~= 'text', 'the image was written by an action')\n    eq(nil, P.locate(p, 'Deployment', 'other', 'shop'))\nend)\n\ntest('helmprov: PATH_AT names the values key under the cursor; CHART_OF finds the chart; USE_ITEMS are quickfix rows', function ()\n    ready()\n    local root = chart(CHART)\n    local buf = vim.fn.bufadd(root .. '/values.yaml'); vim.fn.bufload(buf)\n    eq('image.tag', P.path_at(buf, 2, 3))\n    eq('port', P.path_at(buf, 3, 0))\n    eq(vim.fn.fnamemodify(root, ':p'):gsub('/$', ''), P.chart_of(root .. '/templates/deployment.yaml'))\n    local items, src = P.use_items(root, 'image.tag')\n    eq('rendered', src)\n    eq(2, #items); eq(2, items[1].lnum); ok(items[1].filename:match('_helpers%.tpl$')); eq(16, items[2].lnum)\n    vim.api.nvim_buf_delete(buf, { force = true })\nend)\n\ntest('helmprov: without a render the use sites fall back to the STATIC reads, said so', function ()\n    if not pcall(vim.treesitter.get_string_parser, '', 'yaml') then skip 'no yaml parser' end\n    local root = chart(CHART)\n    local render = P.render\n    P.render = function () return nil, 'stubbed' end\n    local okc, items, src = pcall(P.use_items, root, 'port')\n    P.render = render\n    ok(okc, tostring(items))\n    eq('static', src)\n    eq(1, #items); eq(12, items[1].lnum)\nend)\n"},"verb":"edit"},"verb":"edit"},{"id":"1790898232.394018-edit","invocation":{"touched":[".claude/skills/cartograph/references/questions.md"],"args":{"after":"| Which Helm templates are WRONG while every tool reports success — a values typo that renders empty, a values key nothing reads, a record separator the chomp deletes, a checksum annotation that does not roll the pod? | `local L = require 'cartograph.helmlint'; local r = L.lint(<chart dir>, { render = true|false }); print(table.concat(L.lines(r), '\\n'))` — templates read with the `helm` tree-sitter grammar: `dangling-values-path` (`.Values.a.b` read, values.yaml never defines it; a read guarded by `if`/`with` on that path, piped to or an ARGUMENT of `default` / `required` / `coalesce` is not one; \"defined up to\" names the prefix), `orphan-value` (a defined leaf no read covers; subchart keys and `global` excluded; REFUSED when a template reads `.Values` whole or via `index`), `chomped-separator` (a `range` inside a YAML block scalar `key: |` whose closing `{{- end` chomps the blank line between records — LDIF/PEM; the license-header chomp idiom is not one), `checksum-under-coverage` (needs the render: a `checksum/…` pod annotation's hashed values / included files against the values read by the template that produces each ConfigMap / Secret the pod references). Frontiers said: a library chart (its helpers read the includer's values), `.Values` relative to a rebound dot in range/with, and static values as a hypothetical release (`helm upgrade` reuses the last values). Measured: microservices-demo 1 finding (orphan `googleCloudOperations.metrics`, verified), helm's testcharts 2 dangling (both deliberate fixtures) after the library rule. MCP: `helm_chart` (rows), `k8s_findings` (the post-pass on this graph), `helm_stages` (stages and drift of the graph root). CART-0156 |\n| Where is a Helm VALUE used — from the `values.yaml` key under my cursor to every template line that reads it, helpers included — and which template line WROTE a given rendered byte or field? | `:CartographHelmUses` on a values key (the key path from the YAML tree: `images.tag` on `tag:` under `images:`) fills the quickfix with every read; `:CartographHelmLint` lints the chart of the buffer. In Lua: `local P = require 'cartograph.helmprov'; local p = P.render(<chart>, { release, namespace, values = { f }, set = { 'k=v' } })` — HELM'S OWN ENGINE over a copy of text/template that keeps what the executor knows (tools/helmprov, built OFFLINE on first use against the local helm checkout and the Go module cache): `p.files[<chart>/templates/x.yaml]` = { content, spans = { { start, end, loc = 'file:line:col', kind } } } (every rendered byte range → the template node that wrote it; a text span reproduces its source byte for byte; an action's loc is its pipeline, just inside `{{`), `p.reads` = { { path, loc } } (every evaluated `.Values` chain, at the node that evaluated it — inside an included helper, not on the include line). `P.uses(p, 'a.b')` (reads of it, a descendant, or an ancestor: `toYaml .Values.a` uses a.b), `P.position(p, file, byte)` (exact template file/line/col), `P.locate(p, kind, name, text)` (a rendered document's text → its template position), `P.path_at(buf, row, col)`, `P.use_items(chart, path)` (quickfix rows; falls back to helmlint's STATIC reads when it does not build, said `static`). Frontiers: bytes an `include` writes are attributed to the include action (the helper's reads are not lost); `.Values` relative to a dot rebound by range/with is not a read; only the branches this values set takes are seen (CART-0871 is all branches). Measured on microservices-demo: 13/13 rendered files equal `helm template`'s documents, 530/530 text spans reproduce their source, 327 reads; `images.tag` → 11 sites. CART-0870 |\n","file":".claude/skills/cartograph/references/questions.md","before":"| Which Helm templates are WRONG while every tool reports success — a values typo that renders empty, a values key nothing reads, a record separator the chomp deletes, a checksum annotation that does not roll the pod? | `local L = require 'cartograph.helmlint'; local r = L.lint(<chart dir>, { render = true|false }); print(table.concat(L.lines(r), '\\n'))` — templates read with the `helm` tree-sitter grammar: `dangling-values-path` (`.Values.a.b` read, values.yaml never defines it; a read guarded by `if`/`with` on that path, piped to or an ARGUMENT of `default` / `required` / `coalesce` is not one; \"defined up to\" names the prefix), `orphan-value` (a defined leaf no read covers; subchart keys and `global` excluded; REFUSED when a template reads `.Values` whole or via `index`), `chomped-separator` (a `range` inside a YAML block scalar `key: |` whose closing `{{- end` chomps the blank line between records — LDIF/PEM; the license-header chomp idiom is not one), `checksum-under-coverage` (needs the render: a `checksum/…` pod annotation's hashed values / included files against the values read by the template that produces each ConfigMap / Secret the pod references). Frontiers said: a library chart (its helpers read the includer's values), `.Values` relative to a rebound dot in range/with, and static values as a hypothetical release (`helm upgrade` reuses the last values). Measured: microservices-demo 1 finding (orphan `googleCloudOperations.metrics`, verified), helm's testcharts 2 dangling (both deliberate fixtures) after the library rule. MCP: `helm_chart` (rows), `k8s_findings` (the post-pass on this graph), `helm_stages` (stages and drift of the graph root). CART-0156 |\n"},"verb":"edit"},"verb":"edit"}],"explained":252059,"entries":[{"invocation":{"touched":["tools/helmprov/LICENSE-go"],"args":{"after":"Copyright 2009 The Go Authors.\n\nRedistribution and use in source and binary forms, with or without\nmodification, are permitted provided that the following conditions are\nmet:\n\n   * Redistributions of source code must retain the above copyright\nnotice, 