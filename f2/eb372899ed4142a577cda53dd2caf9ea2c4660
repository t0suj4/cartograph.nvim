ed calls named; 55 s, mostly the graph's extraction. ⚠ A bare field name (`at`) also matches unrelated records' fields — root it (`rooted=`) where a producer has a stable base. CART-1345 |"},"verb":"edit"},"verb":"edit","id":"1791022534.082771-edit"}],"commit":"f2eb372899ed4142a577cda53dd2caf9ea2c4660","explained":10484,"entries":[{"bytes":737,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"touched":["lua/cartograph/consumers.lua"],"args":{"file":"lua/cartograph/consumers.lua","before":"        -- INTERPROC 1-HOP: the WHOLE record (not a derived sub-value) passed to\n        -- a resolvable same-file helper → FOLLOW it (taint that helper's matching\n        -- param, resolve_params re-walks the body). Coverage no longer stops here.\n        if not esc and self.helpers[callee] then\n            local sl2, sc2 = cur:range()\n            local idx = 0\n            for ch in p:iter_children() do\n                if ch:named() then\n                    idx = idx + 1\n                    local cl, cc = ch:range()\n                    if cl == sl2 and cc == sc2 then break end\n                end\n            end\n            self.props[#self.props + 1] = { name = callee, idx = idx, kind = kindof(taint) }\n            return\n        end\n        self.escapes[#self.escapes + 1] = { line = l, col = c, kind = esc or 'arg',\n            via = via, detail = callee .. '()' }\n        return","after":"        -- (the argument's POSITION: the helper follow uses it, and so does record-flow across files — CART-1345)\n        local sl2, sc2 = cur:range()\n        local idx = 0\n        for ch in p:iter_children() do\n            if ch:named() then\n                idx = idx + 1\n                local cl, cc = ch:range()\n                if cl == sl2 and cc == sc2 then break end\n            end\n        end\n        -- INTERPROC 1-HOP: the WHOLE record (not a derived sub-value) passed to\n        -- a resolvable same-file helper → FOLLOW it (taint that helper's mat