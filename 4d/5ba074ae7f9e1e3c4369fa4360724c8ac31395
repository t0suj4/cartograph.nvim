artograph/mix.lua","before":"--- the residual program as a Lua chunk: its functions, forward-declared, and `return <entry>`\nfunction M.print(res)\n    local out = {}\n    local names = {}\n    for i, n in ipairs(res.order) do names[i] = n end\n    out[#out + 1] = 'local ' .. table.concat(names, ', ')\n    for _, n in ipairs(res.order) do\n        local f = res.funcs[n]\n        out[#out + 1] = 'function ' .. n .. '(' .. table.concat(f.params, ', ') .. ')'\n        pblock(f.body, '    ', out)\n        out[#out + 1] = 'end'\n    end\n    out[#out + 1] = 'return ' .. res.entry\n    return table.concat(out, '\\n') .. '\\n'\nend"}},"verb":"edit"},{"bytes":127,"decided_by":"tactic","decisions":[],"id":"1791148432.415174-edit","invocation":{"touched":["lua/cartograph/mix.lua"],"verb":"edit","args":{"file":"lua/cartograph/mix.lua","after":"local pblock, pexpr\n-- (while printing a program of many functions: the table its functions are fields of — M.print sets it)\nlocal FNTABLE = nil","before":"local pblock, pexpr"}},"verb":"edit"},{"bytes":1292,"decided_by":"tactic","decisions":[],"id":"1791148562.933468-edit","invocation":{"touched":["tests/mix_spec.lua"],"verb":"edit","args":{"after":"test('mix: a constructor\\'s LAST POSITIONAL field EXPANDS a call\\'s values — `{ unpack(t) }` copies the whole list, statically and at run time (CART-1461)', function ()\n    ready()\n    local src = [[\nlocal function two() return 7, 8 end\nlocal function child(path, i)\n    local p = { unpack(path) }\n    p[#p + 1] = i\n    return p\nend\nlocal function f(path, d)\n    local a = child(path, d)\n    local b = { 0, unpack(path) }\n    local c = { k = 1, two() }\n    local e = { [2] = 5, two() }\n    local g = { 1, 2, unpack(d) }\n    return table.concat(a, '/') .. '|' .. table.concat(b, '/') .. '|' .. c[1] .. c[2] .. c.k .. '|' .. e[1] .. e[2] .. '|' .. table.concat(g, '/')\nend\n]]\n    local o = original(src, 'f')\n    -- (path static: the expansion is computed; d dynamic: the tables ho