erb":"edit"},"decisions":[],"bytes":785},{"decided_by":"tactic","id":"1791987828.319488-edit","verb":"edit","invocation":{"args":{"before":"            if sum.over then sum.w, sum.nk, sum.gpk = {}, 0, nil end\n            if was and signature(sum) == signature(was) then sum = was else changed = changed + 1 end\n","file":"lua/cartograph/effects.lua","after":"            settle_captured(store, sum, members)\n            if sum.over then sum.w, sum.nk, sum.gpk = {}, 0, nil end\n            if was and signature(sum) == signature(was) then sum = was else changed = changed + 1 end\n"},"touched":["lua/cartograph/effects.lua"],"verb":"edit"},"decisions":[],"bytes":49},{"decided_by":"tactic","id":"1791987828.359853-edit","verb":"edit","invocation":{"args":{"before":"local IOKEY = '\\1io\\31'\n","file":"lua/cartograph/effects.lua","after":"local IOKEY = '\\1io\\31'\n-- the module var named `name` in `file` (a file-level local the extractor minted) -> its id | nil\nlocal fv_memo = setmetatable({}, { __mode = 'k' })\nlocal function file_var(store, file, name)\n    local per = fv_memo[store]\n    if not per or per.gen ~= store.generation then per = { gen = store.generation }; fv_memo[store] = per end\n    local m = per[file]\n    if not m then\n        m = {}\n        for _, n in ipairs(store.by_file[file] or {}) do if n.kind == 'var' and n.name and m[n.name] == nil then m[n.name] = n.id end end\n        per[file] = m\n    end\n    return m[name]\nend\n-- ★ A CAPTURED WRITE SETTLES AT ITS OWNER (CART-1693): `\\1cap:<file>:<row:col>:<name>:<i>` is a store into a value a\n-- closure captured from the function at row:col. Every function it reaches by inheritance writes state it does not\n-- own — except the OWNER: there a captured LOCAL is its own (a closure filling `acc` is the owner's business, not an\n-- effect of calling it) and a captured PARAMETER is that parameter's mutation (pwx). A `chunk` owner is module state:\n-- never settled\nlocal function settle_captured(store, sum, members)\n    local own\n    for key in pairs(sum.w) do\n        if key:sub(1, 5) == '\\1cap:' then\n            local file, r, c, i = key:match('^\\1cap:(.-):(%d+):(%d+):[^:]*:(%d+)\\31$')\n            if file then\n                if not own then\n                    own = {}\n                    local at = require 'cartograph.at'\n                    for _, fid in ipairs(members) do\n                        local n = store.node(fid)\n                        if n and n.range then own[(n.file or '') .. ':' .. at.sl(n.range) .. ':' .. at.sc(n.range)] = true end\n                    end\n                end\n                if own[file .. ':' .. r .. ':' .. c] then\n                    sum.w[key] = nil; sum.nk = sum.nk - 1\n                    if sum.gpk then sum.gpk[key] = nil end\n                    if i ~= '0' then sum.pwx = sum.pwx or {}; sum.pwx[tonumber(i)] = true end\n                end\n            end\n        end\n    end\nend\n"},"touched":["lua/cartograph/effects.lua"],"verb":"edit"},"decisions":[],"bytes":2020},{"decided_by":"tactic","id":"1791988396.813082-edit","verb":"edit","invocation":{"args":{"before":"local function edge(data, fn_name, var_name)\n","after":"test('effects: a store through an ALIAS or a CAPTURED name writes — settled at the owner: its local is its own, its param is pwx (CART-1693)', function ()\n    if not ready('lua') then return end\n    local root = vim.fn.tempname(); vim.fn.mkdir(root, 'p')\n    local fd = assert(io.open(root .. '/m.lua', 'w'))\n    fd:write(table.concat({\n        'local M = {}',\n        'local state = { cur = 1 }',\n        'local f',\n        'do local s = state; f = function () s.cur = nil end end',              -- a block local aliasing module state\n        'function M.alias() local q = state; q.cur = nil end',                   -- a local alias\n        'local function factory(p) return function () p.cur = nil end end',     -- writes the factory's parameter\n        'local function each(xs, fn) for _, x in ipairs(xs) do fn(x) end end',\n        'function M.collect(xs) local acc = {}; each(xs, function (x) acc[#acc + 1] = x end); return acc end',\n        'function M.fill(t) local function put(x) t[x] = true end; put(1) end',  -- its inner function writes its param\n        'function M.own() local t = {}; t.x = 1; return t end',                  -- a fresh table of its own\n        'function M.direct() state.cur = nil end',\n        'M.f, M.factory = f, factory',\n        'return M', '' }, '\\n'))\n    fd:close()\n    store.ingest(ts.extract(root))\n    local by = {}\n    for _, n in ipairs(store.data.nodes) do if n.name then by[n.name] = by[n.name] or n.id end end\n    local function lab(name) return effects.purity(store, by[name]) end\n    eq('writes', lab('f'), 'a closure writing a block local that aliases module state')\n    eq('writes', lab('M.alias'), 'a write through a local alias of module state')\n    local s = effects.summaries(store)\n    local function wkeys(name) local ks = {}; for k in pairs(s[by[name]].w) do ks[#ks + 1] = (k:gsub('^.-::', ''):gsub('\\31', '.')) end; table.sort(ks); return table.concat(ks, ' ') end\n    eq('var:state@1.cur', wkeys('M.alias'), 'the aliased var and its field')\n    eq('var:state@1.cur', wkeys('f'), 'through the block local too')\n    eq('pure', lab('factory'), 'the factory writes nothing when called')\n    eq('writes', lab('factory#ret'), 'its closure writes the captured parameter')\n    eq('pure', lab('M.collect'), 'a closure filling the OWNER\\'s fresh local: the owner stays pure')\n    eq('writes', lab('each#cb'), 'though the closure itself writes captured state')\n    eq('writes', lab('M.fill'), 'an inner function writing the owner\\'s param: the owner mutates its param')\n    ok(s[by['M.fill']].pwx and s[by['M.fill']].pwx[1], 'as pwx[1]')\n    eq('pure', lab('M.own'), 'a table the function made itself')\n    eq('writes', lab('M.direct'), 'a direct module write, as before')\nend)\n\nlocal function edge(data, fn_name, var_name)\n","file":"tests/paramfx_spec.lua"},"touched":["tests/paramfx_spec.lua"],"verb":"edit"},"decisions":[],"bytes":2730},{"decided_by":"tactic","id":"1791988421.020263-edit","verb":"edit","invocation":{"args":{"before":"            if owner == fnnode then return nil end -- (the writer's own param or local: pw, or a fresh table)","file":"lua/cartograph/spec/lua.lua","after":"            if owner == fnnode then return nil end -- (the writer's own param or local: pw, or a fresh table — settling at the owner would drop it anyway; this keeps every local write from minting a fact)"},"touched":["lua/cartograph/spec/lua.lua"],"verb":"edit"},"decisions":[],"bytes":207},{"decided_by":"tactic","id":"1791988421.141099-edit","verb":"edit","invocation":{"args":{"before":"M.VERSION = 269 -- v269:","file":"lua/cartograph/cache.lua","after":"M.VERSION = 270 -- v270: a lua function node carries sw — its stores through a CAPTURED or ALIASED name (`local q = state; q.cur = nil`, a closure writing its factory's parameter), so effects no longer reads those writers as pure (CART-1693). v269:"},"touched":["lua/cartograph/cache.lua"],"verb":"edit"},"decisions":[],"bytes":7076},{"decided_by":"tactic","id":"1791988421.212416-edit","verb":"edit","invocation":{"args":{"before":"`effects.summaries(store)[fn_id]` holds the reasons:","file":".claude/skills/cartograph/references/questions.md","after":"`effects.summaries(store)[fn_id]` holds the reasons (2026-10-14, CART-1693: a store through a LOCAL ALIAS of module state — `local q = state; q.cur = nil`, a block local a closure captures — writes that var, and a store into a value CAPTURED from an enclosing function writes a pseudo-var `\\1cap:<file>:<owner row:col>:<name>:<param>` that settles at its OWNER: the owner's own local is internal, its parameter is its `pwx`; repo: 1,148 labels to writes — inner helpers filling their owner's tables — narrow −244 facts, none gained):"},"touched":[".claude/skills/cartograph/references/questions.md