it"},{"invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"before":"-- ★ THE EARLY-EXIT GUARD (CART-1433): `if c[k] then return c[k] end … c[k] = v` — a statement BEFORE the write, in a\n-- block that encloses it, that returns when the written chain is present (directly or through a `local v = c[k]` alias)\n-- makes the write set-once exactly as `if not c[k] then … end` does. Only a language that declares the hooks\n-- (G.block / G.alias_of / G.exit_guard) is scanned, only function-body blocks (never the chunk: a load-time write is no\n-- memo, and a big file's top level would make this quadratic), and at most EXIT_SCAN statements back per block — the\n-- classifier runs per write x per ancestor and is measured hot. The chain text is computed only when a candidate\n-- statement is found.\nlocal EXIT_SCAN = 32\n-- does this block hold ANY `if … then … return … end` at all? Asked once per block (most have none, and the scan below is\n-- then skipped); memoized for the CURRENT SOURCE only — a node id is reused once its tree is freed, so the memo is\n-- one-slot per file, keyed by the source text it was made from\nlocal exit_src, exit_has = nil, {}\nlocal function block_has_exit(blk, src)\n    if exit_src ~= src then exit_src, exit_has = src, {} end\n    local id = blk:id()\n    local v = exit_has[id]\n    if v == nil then\n        v = false\n        for st in blk:iter_children() do\n            if st:named() and st:type() == 'if_statement' then\n                local body = st:field('consequence')[1]\n                local last = body and body:named_child(body:named_child_count() - 1)\n                if last and last:type() == 'return_statement' then v = true; break end\n            end\n        end\n        exit_has[id] = v\n    end\n    return v\nend\n-- the `local v = <chain>` aliases among the statements before `stmt` (at most EXIT_SCAN back) — for an absence test\n-- spelled on the alias: `local v = c[k]; if not v then … c[k]