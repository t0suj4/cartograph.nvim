; eq(8, f1(3))\n    ok(t1:find('WF = (WF or 10)', 1, true), t1)\n    e1.WF = nil\n    eq(12, f1(2), 'the lazy default, at run time')\n    -- a field under a known table: the read of the field is by path too\n    local G = { t = {} }\n    local f2 = run('local function f(x)\\n  if x then G.t.seen = x end\\n  return G.t.seen\\nend\\n', { ['G.t'] = G.t }, { G = G })\n    eq(2, f2(2)); eq(2, G.t.seen); eq(2, f2(false))\n    -- a host global\n    local f3, _, e3 = run('local function f(x)\\n  LAST = x\\n  return x\\nend\\n', {})\n    eq(4, f3(4)); eq(4, e3.LAST)\n    -- still refused: several targets, and a read of a global nothing names\n    ok(not pcall(MX.mix, assert(R.read('local function f(x)\\n  A, B = x, x\\n  return x\\nend\\n', 'lua')), 'f', { 'D' }, {}), 'two global targets')\n    ok(not pcall(MX.mix, assert(R.read('local function f(x)\\n  WF = WF or 10\\n  return WF + x\\nend\\n', 'lua')), 'f', { 'D' }, {}), 'an unknown global read')\nend)","before":"        eq(fd0(3), fd1(3))\n    end\nend)"},"touched":["tests/mix_spec.lua"],"verb":"edit"},"decisions":[],"verb":"edit"},{"id":"1791251925.419707-edit","bytes":268,"decided_by":"tactic","invocation":{"args":{"after":"    -- a host global — written by a helper called on STATIC arguments, which must not run at specialization time\n    local f3, _, e3 = run('local function mark(v) LAST = v end\\nlocal function f(x)\\n  mark(1)\\n  return x\\nend\\n', {})\n    eq(4, f3(4)); eq(1, e3.LAST)","file":"tests/mix_spec.lua","before":"    -- a host global\n    local f3, _, e3 = run('local function f(x)\\n  LAST = x\\n  return x\\nend\\n', {})\n    eq(4, f3(4)); eq(4, e3.LAST)"},"touched":["tests/mix_spec.lua"],"verb":"edit"},"decisions":[],"verb":"edit"}]}
