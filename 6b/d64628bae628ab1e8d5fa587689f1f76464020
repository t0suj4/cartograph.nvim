cesses with their cwd in each tree; a relative instrument file is the variant's (both\n-- sides run the same instrument). ~40 min on this machine.\n-- (derive-accept's claim fails while any op is refused — resolve is, since CART-1505 — so the gate is NO REGRESSION:\n-- the same tally as the baseline)\nlocal TALLY = '(%d+ agree, %d+ differ, %d+ no sample, %d+ refused)'\nreturn {\n    name = 'mix-battery',\n    baseline = 'HEAD',\n    instruments = {\n        { name = 'mix + algebra specs', kind = 'specs', specs = { 'mix_spec', 'mixgaps_spec', 'mixalg_spec', 'compiledverb_spec',\n            'saturate_spec', 'mixproj_spec', 'algebra_spec', 'algebradonor_spec', 'kvterm_spec', 'fnpeer_spec' } },\n        { name = 'derive-accept plain', kind = 'tactic', tactic = 'derive-accept', compare = TALLY },\n        { name = 'derive-accept through', kind = 'tactic', tactic = 'derive-accept', params = { through = 1 }, compare = TALLY },\n        { name = 'derive-accept + the derived client', kind = 'tactic', tactic = 'derive-accept', params = { fuzz = 120 }, compare = TALLY },\n        { name = 'compiled matchers equal A.match', kind = 'check', file = 'tools/experiments/instruments/cmreg.lua', pattern = '0 refused;.*, 0 differ;' },\n        { name = \"mix's sets unchanged (row join)\", kind = 'join', file = 'tools/experiments/instruments/lowersets.lua' },\n        { name = 'compile time (33 matchers)', kind = 'ab', file = 'tools/experiments/instruments/cmreg.lua', extract = 'compile ([%d.]+) s', runs = 5, bound = 1.10 },\n        { name = 'lowering time (derivations)', kind = 'ab', file = 'tools/experiments/instruments/lowertime.lua', extract = 'derivations%(%d+%) ([%d.]+) ms', runs = 5, bound = 1.15 },\n    },\n}"}},"bytes":599,"decided_by":"tactic","id":"1791395729.375394-edit"},{"decisions":[],"verb":"edit","invocation":{"touched":["tests/experiment_spec.lua"],"verb":"edit","args":{"file":"tests/experiment_spec.lua","before":"    local r = X.run({ instruments = { { kind = 'check', file = '/abs/c.lua', pattern = '0 refused;.*, 0 differ;' }, { kind = 'nope' } } },\n        fake(function () return 'CMREG 33 compiled, 0 refused; compile 2.1 s; residual 411 KB; 7000 subjects, 0 differ; match\\n' end))\n    eq(true, r.rows[1].pass); eq(false, r.rows[2].pass); eq(false, r.accept)\nend)","after":"    local r = X.run({ instruments = { { kind = 'check', file = '/abs/c.lua', pattern = '0 refused;.*, 0 differ;' }, { kind = 'nope' } } },\n        fake(function () return 'CMREG 33 compiled, 0 refused; compile 2.1 s; residual 411 KB; 7000 subjects, 0 differ; match\\n' end))\n    eq(true, r.rows[1].pass); eq(false, r.rows[2].pass); eq(false, r.accept)\nend)\n\ntest('experiment: a tactic with compare = <pattern> is NO REGRESSION — the same capture as the baseline passes, whatever the claim', function ()\n    local P = '(%d+ agree, %d+ differ, %d+ no sample, %d+ refused)'\n    local function out(t) return '{\\n  holds = false,\\n  why = \"' .. t .. ' (plain) — first: resolve refused\",\\n  value = {}\\n}\\n' end\n    local same = X.run({ baseline = 'HEAD', instruments = { { kind = 'tactic', tactic = 'derive-accept', compare = P } } },\n        fake(function () return out('27 agree, 0 differ, 6 no sample, 1 refused') end))\n    eq(true, same.rows[1].pass, same.rows[1].detail)\n    local worse = X.run({ baseline = 'HEAD', instruments = { { kind = 'tactic', tactic = 'derive-accept', compare = P } } },\n        fake(function (dir) return out(dir == '/repo' and '26 agree, 1 differ, 6 no sample, 1 refused' or '27 agree, 0 differ, 6 no sample, 1 refused') end))\n    eq(false, worse.rows[1].pass)\n    eq('baseline 27 agree, 0 differ, 6 no sample, 1 refused -> variant 26 agree, 1 differ, 6 no sample, 1 refused', worse.rows[1].detail)\n    local nobase = X.run({ instruments = { { kind = 'tactic', tactic = 'derive-accept', compare = P } } }, fake(function () return out('1 agree, 0 differ, 0 no sample, 0 refused') end))\n    eq(false, nobase.rows[1].pass, 'compare needs a baseline')\nend)"}},"bytes":1327,"decided_by":"tactic","id":"1791395741.081008-edit"},{"decisions":[],"verb":"edit","invocation":{"touched":[".claude/skills/cartograph/references/questions.md"],"verb":"edit","args":{"file":".claude/skills/cartograph/references/questions.md","before":"| Does every algebra DERIVATION, COMPILED by mix, agree with itself interpreted — on the arguments a real suite passes? (the compiler's acceptance; also its code size) | `nvim --headless -u NONE -l tools/toolbelt.lua run derive-accept - [ops=a,b] [through=1] [opaque=M.x,…] [reuse=eager] [cap=12] [suite=<spec.lua>] [plant=<op>]` — the suite (default the vendored donor suite) runs under a permissive busted shim with the derivations bound into the algebra; each operator's first `cap` distinct argument lists are TAPPED; its closure is assembled (mixalg.program; `through=1` follows the basis, `opaque` kept primitives — default admits / admits_slice / match / entails), specialized all-dynamic (`reuse=eager` for the eager policy) and run on every sample against the interpreted derivation. Rows: class agree / differ / nosample / refused, the first differing sample, residual BYTES and FUNCTIONS (and dead functions dropped). CLAIM: none differs, none refused, something compared, and the CONTROL held (two different results of a derivation compared as different — a dead comparison would call every residual right); `plant=<op>` is the negative control (that op's compiled result altered: it must read differ). 2026-10-06: plain 27 agree / 0 differ / 6 no sample / 1 refused (resolve, CART-1505) in 1,757,156 B; through the same, 4,781,341 B. `static=first [groups=4]`: each op's samples GROUPED by their first argument, a residual specialized to each (the compiled form of a template-first verb) — 2026-10-07 through: 23 agree / 2 differ (dig, rewrite: pre-existing) / 3 refused. Restores the algebra table and the JIT it switches off. ⚠ COVERAGE (CART-1538): each row carries `cov = { lines, lines_hit, arms, arms_hit }` — how much of its RESIDUAL the tapped samples ran (a line hook in the guard; an arm counts when its first statement ran) — and the claim line says it: 2026-10-07 plain, 21.0% of lines and 14.5% of branch arms (match 37 of 491 arms, primary_key 8 of 506). \"agree\" is about the paths the suite reaches. THE DERIVED CLIENT (`fuzz=N [points=8] [keep=0.4] [seed=1538]`, CART-1538): fnpeer turns each operator's case split into a peergen model and the generated client drives the derivation interpreted and its residual with N more seeded inputs; rows carry `fuzz` counts (ok / ok differ / err / err with another message / mixed / budget / decode) and any ok-differ, mixed or message difference makes the row DIFFER. 2026-10-07, fuzz=120: 26 agree / 1 differ (generalize, a real bug, CART-1540), arms 14.5% -> 21.8% over 2,760 inputs; without fuzz the run is unchanged. CART-1483 |","after":"| Does every algebra DERIVATION, COMPILED by mix, agree with itself interpreted — on the arguments a real suite passes? (the compiler's acceptance; also its code size) | `nvim --headless -u NONE -l tools/toolbelt.lua run derive-accept - [ops=a,b] [through=1] [opaque=M.x,…] [reuse=eager] [cap=12] [suite=<spec.lua>] [plant=<op>]` — the suite (default the vendored donor suite) runs under a permissive busted shim with the derivations bound into the algebra; each operator's first `cap` distinct argument lists are TAPPED; its closure is assembled (mixalg.program; `through=1` follows the basis, `opaque` kept primitives — default admits / admits_slice / match / entails), specialized all-dynamic (`reuse=eager` for the eager policy) and run on every sample against the interpreted derivation. Rows: class agree / differ / nosample / refused, the first differing sample, residual BYTES and FUNCTIONS (and dead functions dropped). CLAIM: none differs, none refused, something compared, and the CONTROL held (two different results of a derivation compared as different — a dead comparison would call