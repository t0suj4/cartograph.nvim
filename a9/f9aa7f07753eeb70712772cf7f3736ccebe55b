 stamp')\n    eq(l1, SC.loaded_tree(d), 'the loaded tree is pinned')\n    vim.fn.delete(d, 'rf')\nend)\n\ntest('stampcache: CARTOGRAPH_STAMPCACHE=0 is a log that remembers nothing (the A/B that proves a cache changes no answer)', function ()"},"touched":["tests/stampcache_spec.lua"],"verb":"edit"},"bytes":1504,"decided_by":"tactic","id":"1791110855.896446-edit","decisions":[],"verb":"edit"},{"invocation":{"args":{"file":".claude/skills/cartograph/references/questions.md","before":"`SC.file(path)` (a file's CONTENT hash, memoized per process — never an mtime: CART-1301),","after":"`SC.file(path)` / `SC.tree(dir)` (a file's / a directory's CONTENT hash — never an mtime as the KEY: CART-1301; memoized beside the file's stat signature and re-read only when it moved, so a long-lived process sees an edit: CART-1431), `SC.loaded(path)` / `SC.loaded_tree(dir)` (the same for CODE THIS PROCESS RUNS: pinned at the first ask — an edit on disk does not change the loaded code),"},"touched":[".claude/skills/cartograph/references/questions.md"],"verb":"edit"},"bytes":1411,"decided_by":"tactic","id":"1791110908.210901-edit","decisions":[],"verb":"edit"}]}
