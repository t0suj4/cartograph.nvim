] or 0) + 1 end; return k end\n    -- 'unfold': a one-return helper is substituted by default, kept a residual function when the hook says no\n    local U = 'local function sq(y) return y * y end\\nlocal function f(x) return sq(x) + 1 end\\n'\n    local T = assert(R.read(U, 'lua'))\n    local t0, s0 = MX.mix(T, 'f', { 'D' }, {})\n    local t1, s1 = MX.mix(T, 'f', { 'D' }, {}, { decide = function () return nil end })\n    eq(t0, t1, 'a hook that answers nothing is no change')\n    ok((kinds(s0).unfold or 0) >= 1, vim.inspect(s0.decisions))\n    eq('f', s0.decisions[1].ctx.fn == nil and 'f' or 'f')\n    local t2, s2 = MX.mix(T, 'f', { 'D' }, {}, { decide = function (kind) if kind == 'unfold' then return false end end })\n    ok(s2.functions > s0.functions, ('unfold refused: %d residual functions, %d before'):format(s2.functions, s0.functions))\n    eq(false, s2.decisions[1].choice); eq(true, s2.decisions[1].default)\n    local f2 = assert(load(t2, 'r', 't', setmetatable({ MIXK = {} }, { __index = _G })))()\n    eq(original(U, 'f')(7), f2(7))\n    -- 'grow': the growing continuation is retried with its closure dynamic by default; vetoed, the refusal stands\n    local G = 'local function g(x, k)\\n    if x > 0 then return g(x - 1, function (y) return k(y) + 1 end) end\\n    return k(x)\\nend\\nlocal function f(x)\\n    return g(x, function (y) return y end)\\nend\\n'\n    local _, sg = MX.mix(assert(R.read(G, 'lua')), 'f', { 'D' }, {})\n    ok((kinds(sg).grow or 0) >= 1, 'the retry was a logged decision')\n    local okv = pcall(MX.mix, assert(R.read(G, 'lua')), 'f', { 'D' }, {}, { decide = function (kind) if kind == 'grow' then return false end end })\n    eq(false, okv, 'vetoed: refused')\n    -- 'fold': a PURE primitive computes on static arguments by default; answered false, it is called at run time\n    local P = 'local function f(x) return twice(3) + x end\\n'\n    local prims = { twice = function (n) return n * 2 end }\n    local tp = MX.mix(assert(R.read(P, 'lua')), 'f', { 'D' }, {}, { prims = prims, pure = { twice = true } })\n    ok(not tp:find('twice', 1, true), 'folded\\n' .. tp)\n    local tq, sq = MX.mix(assert(R.read(P, 'lua')), 'f', { 'D' }, {}, { prims = prims, pure = { twice = true }, decide = function (kind) if kind == 'fold' then return false end end })\n    ok(tq:find('twice(3)', 1, true), 'not folded\\n' .. tq)\n    eq('twice', sq.decisions[1].ctx.prim)\nend)\n\ntest('mix: a table a CALLEE\\'s closure stores into","file":"tests/mix_spec.lua"},"verb":"edit","touched":["tests/mix_spec.lua"]},"verb":"edit","id":"1791247060.370259-edit"},{"invocation":{"args":{"before":"    eq('f', s0.decisions[1].ctx.fn == nil and 'f' or 'f')","after":"    local ud\n    for _, d in ipairs(s0.decisions) do if d.kind == 'unfold' then ud = d end end\n    eq('sq', ud.ctx.fn, 'the context names the callee'); eq('D', ud.ctx.division)\n    ok(type(ud.ctx.chain) == 'table', 'and the active calls')","file":"tests/mix_spec.lua"},"verb":"edit","touched":["tests/mix_spec.lua"]},"verb":"edit","id":"1791247070.057467-edit"},{"invocation":{"args":{"before":"        ok(prims['fix__B.dbl'] ~= nil, 'as a primitive')","after":"        ok(prims['fix__B.dbl'] ~= nil, 'as a primitive')\n        -- (the DECISION HOOK, CART-1501: each followed site is a 'follow' decision — logged, and answerable per site)\n        local _, _, _, _, rep = MA.program('M.use', { path }, { through = true })\n        local fl = {}\n        for _, dd in ipairs(rep.decisions) do if dd.kind == 'follow' then fl[#fl + 1] = dd.ctx.target end end\n        table.sort(fl)\n        eq({ 'M.dbl', 'M.inc', 'M.inc' }, fl, 'B.dbl, B.inc and the alias inc2: three sites')\n        local hk = MA.program('M.use', { path }, { through = true, decide = function (kind, ctx)\n            if kind == 'follow' and ctx.name == 'B.inc' then return false end end })\n        ok(hk:find('fix__B.inc(', 1, true) and hk:find('M_dbl(a)', 1, true) and hk:find('M_inc(a)', 1, true),\n            'B.inc left a primitive at that site only; the alias still follows\\n' .. hk)","file":"tests/mixalg_spec.lua"},"verb":"edit","touched":["tests/mixalg_spec.lua"]},"verb":"edit","id":"1791247080.251210-edit"},{"invocation":{"args":{"before":"    eq(false, okv, 'vetoed: refused')","after":"    eq(false, okv, 'vetoed: refused')\n    -- 'generalize': the whistle's answer for a counter that grows (n over a dynamic list); vetoed, the depth refuses\n    local W = 'local function walk(t, n)\\n  n = n or 1\\n  if n > #t then return 0 end\\n  return t[n] + walk(t, n + 1)\\nend\\nlocal function f(t) return walk(t) end\\n'\n    local _, sw = MX.mix(assert(R.read(W, 'lua')), 'f', { 'D' }, {})\n    ok((kinds(sw).generalize or 0) >= 1, vim.inspect(kinds(sw)))\n    local okw = pcall(MX.mix, assert(R.read(W, 'lua')), 'f', { 'D' }, {}, { decide = function (kind) if kind == 'generalize' then return false end end })\n    eq(false, okw, 'vetoed: refused')","file":"tests/mix_spec.lua"},"verb":"edit","touched":["tests/mix_spec.lua"]},"verb":"edit","id":"1791247107.131528-edit"},{"invocation":{"args":{"before":"| Can a derivation be specialized THROUGH its basis — `B.join` followed into the algebra's own code, so mix specializes it on a static template instead of calling it opaque? | `MA.program(key, nil, { snapshot = true, through = true [, opaque = { ['M.x'] = true }] })` (CART-1500): a captured table's FIELD (`B.join`) or a captured ALIAS (`local label = M.node_label`) whose value IS a definition of the program's files is followed into the closure and rewritten to its mangled name; the algebra's DATA fields the followed code reads (`M.OBSERVED`) become knowns; `opaque` keeps named definitions as primitives (a NARROWED domain). D.match through the basis: 84 definitions (64 from the algebra), every basis call followed, lowers with nothing refused. Mix gaps it surfaced, fixed: a callee's closure-stored parameter now forces the CALLER's variable dynamic (a `local ids = {}` handed to `content_id` — never a shared constant); a closure that keeps growing is retried DYNAMIC on a depth refusal too (a growing continuation `g(x-1, function (y) return k(y) + 1 end)` now specializes, equal to the original). Then (2026-10-06): a SINGLE-VALUED call as an expanding last argument — a named program function or a statically known closure that returns one value on every path — fills one parameter and leaves the rest nil (rung 3 for that case: `M.rep(M.join_domain(…))`); a static NIL embeds every value in the whistle (`put(t, path, sub)` then `i = i or 1`: the index generalizes instead of 120 program points). RESULT, D.match through the basis with `admits`/`admits_slice`/`match`/`entails` OPAQUE (narrowed): it specializes (4,801 residual lines), equal to the derivation on every sample; fair timing (fresh process each, interleaved, median of 5) us/call: derived 50.2, compiled with the basis opaque 65.3, THROUGH the basis 38.7, hand 15.4 — 1.3x faster than the derivation, 2.5x from hand-written. OPEN: through `admits` (not opaque) the unfold explodes the budget. `tests/mixalg_spec.lua`, `tests/mix_spec.lua`. CART-1500 |","after":"| Can a derivation be specialized THROUGH its basis — `B.join` followed into the algebra's own code, so mix specializes it on a static template instead of calling it opaque? | `MA.program(key, nil, { snapshot = true, through = true [, opaque = { ['M.x'] = true }] })` (CART-1500): a captured table's FIELD (`B.join`) or a captured ALIAS (`local label = M.node_label`) whose value IS a definition of the program's files is followed into the closure and rewritten to its mangled name; the algebra's DATA fields the followed code reads (`M.OBSERVED`) become knowns; `opaque` keeps named definitions as primitives (a NARROWED domain). D.match through the basis: 84 definitions (64 from the algebra), every basis call followed, lowers with nothing refused. Mix gaps it surfaced, fixed: a callee's closure-stored parameter now forces the CALLER's variable dynamic (a `local ids = {}` handed to `content_id` — never a shared constant); a closure that keeps growing is retried DYNAMIC on a depth refusal too (a growing continuation `g(x-1, function (y) return k(y) + 1 end)` now specializes, equal to the original). Then (2026-10-06): a SINGLE-VALUED call as an expanding last argument — a named program function or a statically known closure that returns one value on every path — fills one parameter and leaves the rest nil (rung 3 for that case: `M.rep(M.join_domain(…))`); a static NIL embeds every value in the whistle (`put(t, path, sub)` then `i = i or 1`: the index generalizes instead of 120 program points). RESULT, D.match through the basis with `admits`/`admits_slice`/`match`/`entails` OPAQUE (narrowed): it specializes (4,801 residual lines), equal to the derivation on every sample; fair timing (fresh process each, interleaved, median of 5) us/call: derived 50.2, compiled with the basis opaque 65.3, THROUGH the basis 38.7, hand 15.4 — 1.3x faster than the derivation, 2.5x from hand-written. OPEN: through `admits` (not opaque) the unfold explodes the budget. `tests/mixalg_spec.lua`, `tests/mix_spec.lua`. CART-1500 |\n| What did the SPECIALIZER decide, and what if one decision went the other way? (interaction points in an autonomous compiler) | The DECISION HOOK (CART-1501): `MX.specialize(prog, f, division, statics, { decide = function (kind, ctx, default) … end })` — answering nil keeps the default (today's rule; a run without the hook is unchanged), any other answer replaces it; every decision is LOGGED in `res.decisions` (`MX.mix`: `stats.decisions`) as `{ kind, ctx, default, choice }`. Kinds: `fold` (a pure primitive computed on static arguments; ctx.prim), `unfold` (a one-return callee substituted, or kept a residual function), `generalize` (the whistle's answer — `{ [param] = true }` to make dynamic, false = refuse; ctx.refusal, ctx.ancestor), `grow` (a growing continuation retried with its closures dynamic; ctx.closures). ctx: `fn`, `division`, `at` (source position through the line map), `chain` (active calls, innermost first). mixalg through mode adds `follow` (`MA.program(…, { through = true, decide = … })`, `report.decisions`; ctx.from, ctx.name, ctx.target), asked once per site; a run with a hook bypasses the program cache. NOT YET: policies over the hook — a recorded plan replayed, an interactive driver, an oracle trying both; today's only alternative policy is `opts.reuse = 'eager'`. Overhead: none measured (33 compiled matchers, 4.84 s vs 4.76 s, same residual). `tests/mix_spec.lua`, `tests/mixalg_spec.lua`. CART-1501 |","file":".claude/skills/cartograph/references/questions.md"},"verb":"edit","touched":[".claude/skills/cartograph/references/questions.md"]},"verb":"edit","id":"1791247210.049273-edit"}],"entries":[{"bytes":24,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"before":"        local f2 = generalization(anc, fr)\n        if not f2 then error(r, 0) end","after":"        -- (EVERY active call of g, nearest first — not the nearest alone: a CPS matcher's nearest call of go_kids is the\n        -- level ABOVE, a shorter template list it cannot embed, while the call it grew from sits further up — CART-1500)\n        local function above(a)\n            local p = a and a.parent\n            if not p then return nil end\n            if p.g == g then return p end\n            return above(p)\n        end\n        local function first_answer(a)\n            if not a then return nil end\n            return generalization(a, fr) or first_answer(above(a))\n        end\n        local f2 = first_answer(anc)\n        if not f2 then error(r, 0) end","file":"lua/cartograph/mix.lua"},"verb":"edit","touched":["lua/cartograph/mix.lua"]},"id":"1791243171.237903-edit"},{"bytes":2767,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"before":"    local res = { funcs = {}, order = {} }\n    local memo, btcache = {}, {}","after":"    local res = { funcs = {}, order = {} }\n    -- ── THE DECISION HOOK (CART-1501) ────────────────────────────────────────────────────────────────────────────────\n    -- every choice the specializer makes at a DECISION POINT is asked through opts.decide(kind, ctx, default) — nil\n    -- keeps the default, which is today's rule, so a run without the hook is unchanged — and LOGGED in res.decisions as\n    -- { kind, ctx, default, choice }: a run can be read, replayed, and ONE decision flipped (USER, 2026-10-06: \"insert\n    -- interaction points so it's easier to explore — right now the compiler is pretty much autonomous\"). Kinds:\n    --   'fold'        a pure primitive computed on static arguments (default true; false = called at run time)\n    --   'unfold'      a call whose residual body is one `return e`, substituted in place (default true; false = a\n    --                 residual function)\n    --   'generalize'  the whistle's answer for a configuration that grew: { [param] = true } to make dynamic (default:\n    --                 the join's holes; false = refuse)\n    --   'grow'        a continuation that kept growing, retried with its closure arguments dynamic (default true;\n    --                 false = refuse)\n    -- ctx: { fn, division, at (the source position, through the line map), chain (the active calls, innermost first) }\n    -- plus the kind's own fields. Policies over this hook are later work.\n    res.decisions = {}\n    local function decide(kind, ctx, default)\n        local choice = default\n        if opts.decide then\n            local c = opts.decide(kind, ctx, default)\n            if c ~= nil then choice = c end\n        end\n        res.decisions[#res.decisions + 1] = { kind = kind, ctx = ctx, default = default, choice = choice }\n        return choice\n    end\n    -- a frame's context for the hook\n    local function ctx_of(fr, extra)\n        local chain = {}\n        local f = fr and fr.parent\n        for _ = 1, 12 do\n            if not f then break end\n            chain[#chain + 1] = f.g\n            f = f.parent\n        end\n        local c = { fn = fr and fr.g, division = fr and fr.division and table.concat(fr.division, '') or nil,\n            at = fr and fr.at and prog.where and prog.where(fr.at) or (fr and fr.at), chain = chain }\n        for k, v in pairs(extra or {}) do c[k] = v end\n        return c\n    end\n    -- (the 'fold' decision is made once per primitive, before any binding time is computed)\n    if next(XPURE) then\n        local kept = {}\n        for name in pairs(XPURE) do\n            if decide('fold', { prim = name }, true) then kept[name] = true end\n        end\n        XPURE = kept\n    end\n    local memo, btcache = {}, {}","file":"lua/cartograph/mix.lua"},"verb":"edit","touched":["lua/cartograph/mix.lua"]},"id":"1791246972.112048-edit"},{"bytes":99,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"before":"            if okk then return M.substitute(inl, subst) end\n        end\n        local name, extra = point(T, division, svals, fr)","after":"            if okk and decide('unfold', ctx_of(fr), true) then return M.substitute(inl, subst) end\n        end\n        local name, extra = point(T, division, svals, fr)","file":"lua/cartograph/mix.lua"},"verb":"edit","touched":["lua/cartograph/mix.lua"]},"id":"1791246972.281006-edit"},{"bytes":144,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"before":"        local f2 = generalization(anc, fr)\n        if not f2 then error(r, 0) end","after":"        local f2 = generalization(anc, fr)\n        f2 = decide('generalize', ctx_of(fr, { refusal = r.refusal, ancestor = anc.division and table.concat(anc.division, '') }), f2 or false)\n        if not f2 then error(r, 0) end","file":"lua/cartograph/mix.lua"},"verb":"edit","touched":["lua/cartograph/mix.lua"]},"id":"1791246972.451195-edit"},{"bytes":237,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"before":"         