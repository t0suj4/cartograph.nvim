-- notifies with it); `opts.skip` = { [name] = true } leaves a pass out (the loss report skips the session-bound\n--- `dblink`). Returns { [name] = { results… } }.\nfunction M.run(data, opts)\n    opts = opts or {}\n    local out = {}\n    for _, p in ipairs(M.PASSES) do\n        if not (opts.skip and opts.skip[p.name]) then\n            local r = { p.run(data) }\n            out[p.name] = r\n            if opts.say then\n                local msg, level = p.say(unpack(r))\n                if msg then opts.say(msg, level) end\n            end\n        end\n    end\n    return out\nend\n\nreturn M\n"},"touched":["lua/cartograph/postpass.lua"],"verb":"edit"},"verb":"edit"},{"id":"1790922797.818996-edit","invocation":{"args":{"after":"-- cartograph.helmgraph — a chart's values IN THE GRAPH (CART-1313): keys are vars, template reads are sited uses, and\n-- the cockpit's existing var view answers \"where is this value used\".\nlocal G = require 'cartograph.helmgraph'\nlocal store = require 'cartograph.store'\n\nlocal function ready() if not pcall(vim.treesitter.get_string_parser, '', 'helm') then skip 'no helm grammar' end end\nlocal function tree(files)\n    local root = vim.fn.tempname()\n    for rel, text in pairs(files) do\n        vim.fn.mkdir(vim.fn.fnamemodify(root .. '/' .. rel, ':h'), 'p')\n        local fd = assert(io.open(root .. '/' .. rel, 'w')); fd:write(text); fd:close()\n    end\n    return root\nend\nlocal CHART = {\n    ['shop/Chart.yaml'] = 'apiVersion: v2\\nname: shop\\nversion: 0.1.0\\n',\n    ['shop/values.yaml'] = 'image:\\n  repo: shop\\n  tag: \"1.0\"\\nresources: {}\\nports:\\n- 80\\n- 443\\n',\n    ['shop/templates/_helpers.tpl'] = '{{- define \"shop.image\" -}}\\n{{ .Values.image.repo }}:{{ .Values.image.tag }}\\n{{- end -}}\\n',\n    ['shop/templates/deploy.yaml'] = table.concat({\n        'kind: Deployment', 'spec:', '  image: {{ include \"shop.image\" . }}', '  tag: {{ .Values.image.tag }}',\n        '  limits: {{ .Values.resources.limits }}', '  nope: {{ .Values.missing.key }}',\n        '{{- with .Values.image }}', '  repo: {{ .repo }}', '{{- end }}', '  ports: {{ .Values.ports }}' }, '\\n') .. '\\n',\n}\n\ntest('helmgraph: every values key a VAR at its line; every template read a USE sited at the read; undefined and relative reads counted', function ()\n    ready()\n    local data = { root = tree(CHART), nodes = {}, edges = {} }\n    local s = G.attach(data)\n    local keys = {}\n    for _, n in ipairs(data.nodes) do if n.hv == 'key' then keys[#keys + 1] = n.name .. '@' .. (n.range.start.line + 1) end end\n    table.sort(keys)\n    eq({ 'image.repo@2', 'image.tag@3', 'image@1', 'ports@5', 'resources@4' }, keys, 'a list is one key: Helm reads it whole')\n    local uses = {}\n    for _, e in ipairs(data.edges) do\n        if e.hv == 'reads' then\n            local lines = vim.tbl_map(function (a) return a.start.line + 1 end, e.at)\n            uses[#uses + 1] = e.from:match('[^/]+$') .. ' -> ' .. e.to:match('::(.*)$') .. ' ' .. table.concat(lines, ',')\n        end\n    end\n    table.sort(uses)\n    eq({\n        '_helpers.tpl -> image.repo 2', '_helpers.tpl -> image.tag 2',\n        'deploy.yaml -> image 7',          -- (the `with` condition reads image whole)\n        'deploy.yaml -> image.tag 4',\n        'deploy.yaml -> ports 10',\n        'deploy.yaml -> resources 5',      -- (resources.limits reads INTO the key values.yaml defines)\n    }, uses)\n    eq(1, s.undefined, '.Values.missing.key: nothing values.yaml defines')\n    eq(1, s.relative, '`.repo` inside with: not an absolute path')\n    local V = require 'cartograph.validate'\n    eq('schema: OK', (V.report(V.check(data)) or ''):match('^schema: OK'))\nend)\n\ntest('helmgraph: the cockpit\\'s VAR view of a values key lists the templates that read it', function ()\n    ready()\n    local data = { root = tree(CHART), nodes = {}, edges = {} }\n    G.attach(data)\n    data.schema = 1\n    store.ingest(data)\n    local readers = vim.tbl_map(function (u) return u.from:match('[^/]+$') .. ':' .. #u.at end, store.topo():var_used_by_detail('shop/values.yaml::image.tag'))\n    table.sort(readers)\n    eq({ '_helpers.tpl:1', 'deploy.yaml:1' }, readers)\nend)\n","file":"tests/helmgraph_spec.lua","before":""},"touched":["tests/helmgraph_spec.lua"],"verb":"edit"},"verb":"edit"},{"id":"1790922810.669121-edit","invocation":{"args":{"after":"    eq(0, s.relative, '`.repo` inside with is not a .Values read to the STATIC reader at all (the symbolic render attributes it, CART-1302)')","file":"tests/helmgraph_spec.lua","before":"    eq(1, s.relative, '`.repo` inside with: not an absolute path')"},"touched":["tests/helmgraph_spec.lua"],"verb":"edit"},"verb":"edit"},{"id":"1790922836.522087-edit","invocation":{"args":{"after":"| Will Kubernetes ACCEPT this object as written — which fields does it silently DROP (an unknown key: a typo, or the `nindent 8` that should be 10), which values does it REJECT (a string for an int, a bool annotation, an unquoted version label) — and for a chart, which template line wrote it? | `local S = require 'cartograph.k8sschema'; local fs = S.check_text(<yaml text>)` → { { kind, name, path = 'spec.template.spec.containers[1].image', problem = 'unknown-field' \\| 'wrong-type', expected, got, hint, line } } + the documents of kinds it does not know (custom resources, counted); `S.text(f)` one line. The object is read as the API server parses it (sigs.k8s.io/yaml over go-yaml v2 = yamlvalue's `helm` profile: `true` a bool, `\"true\"` a string) and walked against `cartograph.k8sapi_schema` — every field of every kind DERIVED from Kubernetes' own Go API types + apimachinery meta/v1 by `tools/k8sapi.lua` (554 types; aliases resolved; Quantity / IntOrString / Time by import path; `--check` = drift). Hints: `belongs under spec` (one level too shallow), one level up, `did you mean imagePullPolicy?`; kustomize patch `$`-directives are not fields. For a chart `S.check_render(helmprov render)` locates each