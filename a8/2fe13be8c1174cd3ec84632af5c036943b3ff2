ext(T, opts)\n    opts = opts or {}\n    if opts.lossless == false then return function () return true end, {} end\n    local toks = M.tokens(T)\n    return function (text)\n        for _, s in ipairs(toks) do if not text:find(s, 1, true) then return false end end\n        return true\n    end, toks\nend\n\nreturn M\n","file":"lua/cartograph/prefilter.lua","before":""},"verb":"edit"},"verb":"edit"},{"id":"1791013062.404935-edit","invocation":{"touched":["lua/cartograph/prefilter.lua"],"args":{"after":"    walk(T.body or T)\n    table.sort(out, function (x, y) if #x ~= #y then return #x > #y end return x < y end)\n    return out","file":"lua/cartograph/prefilter.lua","before":"    walk(T.body or T)\n    table.sort(out, function (x, y) if #x ~= #y then return #x > #y end return x < y end)\n    local _ = a\n    return out"},"verb":"edit"},"verb":"edit"},{"id":"1791013062.444856-edit","invocation":{"touched":["lua/cartograph/prefilter.lua"],"args":{"file":"lua/cartograph/prefilter.lua","after":"function M.tokens(T)\n    local seen, out = {}, {}","before":"function M.tokens(T)\n    local a = A()\n    local seen, out = {}, {}"},"verb":"edit"},"verb":"edit"},{"id":"1791013062.485104-edit","invocation":{"touched":["lua/cartograph/prefilter.lua"],"args":{"after":"","file":"lua/cartograph/prefilter.lua","before":"local function A() return require('cartograph.algebra').load() end\n"},"verb":"edit"},"verb":"edit"},{"id":"1791013081.499986-edit","invocation":{"touched":["lua/cartograph/byexample.lua"],"args":{"file":"lua/cartograph/byexample.lua","after":"    local scan = files_in(store, opts.scope or 'all', opts.lang)\n    local edits, touched, stamps, per, total, unread = {}, {}, {}, {}, 0, {}\n    -- ★ THE PREFILTER (cartograph.prefilter): a file whose text lacks a fixed token of EVERY rule cannot hold a match —\n    -- a sound necessary condition, so it is skipped before it is parsed (CARTOGRAPH_PREFILTER=0 turns it off)\n    local filters = {}\n    if os.getenv('CARTOGRAPH_