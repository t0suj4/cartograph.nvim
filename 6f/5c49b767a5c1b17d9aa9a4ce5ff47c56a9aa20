ded_by":"tactic"},{"decisions":[],"id":"1791171734.305310-edit","bytes":577,"invocation":{"touched":["lua/cartograph/refresh.lua"],"verb":"edit","args":{"file":"lua/cartograph/refresh.lua","before":"    local only\n    if cutoff then\n        only = {}\n        for f in pairs(dirty) do only[f] = true end\n    end\n    stats.relinked = ts.relink(data, dirty, { only = only })","after":"    local only, names\n    if cutoff then\n        only, names = {}, {}\n        for f in pairs(dirty) do only[f] = true end\n        -- the names the refreshed files define, before and after (and their tails): the calls whose refusals can\n        -- name these files' ids\n        local function add(n)\n            if n.name then names[n.name] = true; local t = n.name:match('([%w_]+)$'); if t then names[t] = true end end\n        end\n        for _, olds in pairs(old_by_file) do for _, x in ipairs(olds) do add(x) end end\n        for _, x in ipairs(mini.nodes) do add(x) end\n    end\n    stats.relinked = ts.relink(data, dirty, { only = only, names = names })"}},"verb":"edit","decided_by":"tactic"},{"decisions":[],"id":"1791172432.242881-edit","bytes":936,"invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"file":"lua/cartograph/providers/treesitter.lua","before":"    local n = 0\n    for _, p in ipairs(RESOLVE_PASSES) do\n        n = n + (p.run(ctx) or 0)\n        for i = 1, cv.n do\n            if cget(i, 'to') and not cget(i, 'prov') then cset(i, 'prov', p.name) end\n        end\n    end\n    return n\nend","after":"    local n = 0\n    -- ★ A PASS THAT READS THE WHOLE CALL POPULATION (`whole = true`) gets the whole graph's calls even when the\n    -- driver handed a SUBSET (ts.relink's early cutoff, CART-1439): its evidence is global — resolve_self's type map\n    -- reads ABSENCE as positive evidence, so a subset types more than the whole graph does (refresh-parity's third\n    -- difference: a `self:walk` the full graph refuses as ambiguous). The pass then resolves over every call, as the\n    -- full relink would; the rest see only the subset.\n    local whole_data = ctx.whole_data\n    for _, p in ipairs(RESOLVE_PASSES) do\n        local saved_cv, saved_data = ctx.cv, ctx.data\n        if p.whole and whole_data then ctx.data = whole_data; ctx.cv = require('cartograph.callview').of(whole_data) end\n        n = n + (p.run(ctx) or 0)\n        local pcv = ctx.cv\n        ctx.cv, ctx.data = saved_cv, saved_data\n        for i = 1, pcv.n do\n            if pcv.get(i, 'to') and not pcv.get(i, 'prov') then pcv.set(i, 'prov', p.name) end\n        end\n    end\n    return n\nend"}},"verb":"edit","decided_by":"tactic"},{"decisions":[],"id":"1791172432.571502-edit","bytes":54,"invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"after":"    { name = 'self', whole = true, run = function (x)","before":"    { name = 'self', run = function (x)","file":"lua/cartograph/providers/treesitter.lua"}},"verb":"edit","decided_by":"tactic"},{"decisions":[],"id":"1791172432.897977-edit","bytes":137,"invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"file":"lua/cartograph/providers/treesitter.lua","before":"    n = n + run_resolve_passes({ calls = vdata.calls, data = vdata, exact = exact, resolve = resolve,","after":"    n = n + run_resolve_passes({ calls = vdata.calls, data = vdata, whole_data = only and data or nil, exact = exact, resolve = resolve,"}},"verb":"edit","decided_by":"tactic"},{"decisions":[],"id":"1791172997.943665-edit","bytes":590,"invocation":{"touched":["lua/cartograph/config.lua"],"verb":"edit","args":{"file":"lua/cartograph/config.lua","before":"M.federated_resolve = vim.env.CARTOGRAPH_FEDERATED == '1'","after":"M.federated_resolve = vim.env.CARTOGRAPH_FEDERATED == '1'\n\n-- INCREMENTAL REFRESH (CART-1439, EARLY CUTOFF): a save whose files keep their INTERFACE re-resolves only the calls\n-- that edit can change (ts.relink opts.only). 