{"version":1,"replay":[{"invocation":{"touched":["lua/cartograph/spec/lua.lua"],"verb":"edit","args":{"before":"    -- stdlib receivers must not tail-match a project def: string.format\n    -- would otherwise link to the one module that defines M.format","after":"    -- a BARE call reaches a bare name only: Lua has no implicit receiver, so `tonumber(x)` is never some file's\n    -- `T.tonumber` (the resolver's tail join otherwise links it there, CART-1487)\n    bare_calls_bind_bare = true,\n    -- stdlib receivers must not tail-match a project def: string.format\n    -- would otherwise link to the one module that defines M.format","file":"lua/cartograph/spec/lua.lua"}},"verb":"edit","id":"1791228024.776730-edit"},{"invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"before":"local function cap_node(ns)\n    if type(ns) == 'table' and ns[1] ~= nil then return ns[#ns] end\n    return ns\nend","after":"local function cap_node(ns)\n    if type(ns) == 'table' and ns[1] ~= nil then return ns[#ns] end\n    return ns\nend\n\n-- A MULTI-ASSIGNMENT's value for ONE of its names (CART-1488): a vars query `(list (identifier) @vname) (list (_)\n-- @value)` hands every name the FIRST value — `local pack_u32, getter = bytecol.pack_u32, bytecol.reader_u32` made\n-- `getter` an alias of pack_u32 (a wrong call edge), and const-fold would read `local a, b = 'x', 'y'` as b = 'x'.\n-- Name i takes value i; past the last value (`local a, b = f()`: b is f's SECOND return) it has none. A name and\n-- value under one parent, or a single name, are left as captured.\nlocal function pair_value(vnamen, valn)\n    if not (vnamen and valn) then return valn end\n    local np, vp = vnamen:parent(), valn:parent()\n    if not (np and vp) or np == vp or np:id() == vp:id() then return valn end\n    local function items(p)\n        local out = {}\n        for i = 0, p:named_child_count() - 1 do\n            local c = p:named_child(i)\n            if c:type() ~= 'comment' then out[#out + 1] = c end\n        end\n        return out\n    end\n    local names = items(np)\n    if #names < 2 then return valn end\n    local idx\n    for i, c in ipairs(names) do if c:id() == vnamen:id() then idx = i end end\n    if not idx then return valn end\n    return items(vp)[idx]\nend\nM._pair_value = pair_value","file":"lua/cartograph/providers/treesitter.lua"}},"verb":"edit","id":"1791228153.889126-edit"},{"invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"before":"                elseif vdefn and vnamen then\n                    handle_var(vdefn, vnamen, valn)","file":"lua/cartograph/providers/treesitter.lua","after":"                elseif vdefn and vnamen then\n                    handle_var(vdefn, vnamen, M._pair_value(vnamen, valn)) -- (via M: M.extract is at the 60-upvalue limit)"}},"verb":"edit","id":"1791228154.287374-edit"},{"invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"before":"        if q then\n            for _, match in q:iter_matches(tsroot, src, 0, -1, MATCH_OPTS) do\n                local defn, namen, vdefn, vnamen, valn, adefn, vdecln, rdefn","after":"        if q then\n            local vseen = {} -- (a multi-assignment's name is matched once per value it pairs with: handled ONCE)\n            for _, match in q:iter_matches(tsroot, src, 0, -1, MATCH_OPTS) do\n                local defn, namen, vdefn, vnamen, valn, adefn, vdecln, rdefn","file":"lua/cartograph/providers/treesitter.lua"}},"verb":"edit","id":"1791228179.363470-edit"},{"invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"before":"                    handle_var(vdefn, vnamen, M._pair_value(vnamen, valn)) -- (via M: M.extract is at the 60-upvalue limit)","file":"lua/cartograph/providers/treesitter.lua","after":"                    if not vseen[vnamen:id()] then\n                        vseen[vnamen:id()] = true\n                        handle_var(vdefn, vnamen, M._pair_value(vnamen, valn)) -- (via M: M.extract is at the 60-upvalue limit)\n                    end"}},"verb":"edit","id":"1791228179.749828-edit"},{"invocation":{"touched":["lua/cartograph/cache.lua"],"verb":"edit","args":{"before":"M.VERSION = 214 -- v214: A SAVE NO LONGER RE-APPENDS SITES (CART-1439): xlang.link and relink's module ownership appended every site again on each save (our tree: 39,671 -> 45,602 at-sites over three saves); a cache written after saves held the inflated counts","after":"M.VERSION = 215 -- v215: THREE RESOLUTION FIXES, ONE BUMP (the cache holds linked graphs; 65bb8cc and bc7560c shipped without moving it): a rebound parameter is no param write (CART-1484, the `pw` fact); a same-file name defined several times is bound by LEXICAL scope (CART-1059, Lua samefile 670 -> 33); a bare Lua call binds bare names only and a multi-assignment pairs name i with value i (CART-1487/1488: 714 bare calls had been linked to a wrong qualified def)\n-- v214: A SAVE NO LONGER RE-APPENDS SITES (CART-1439): xlang.link and relink's module ownership appended every site again on each save (our tree: 39,671 -> 45,602 at-sites over three saves); a cache written after saves held the inflated counts","file":"lua/cartograph/cache.lua"}},"verb":"edit","id":"1791228205.898005-edit"},{"invocation":{"touched":["tests/barecall_spec.lua"],"verb":"edit","args":{"before":"","after":"-- BARE CALLS AND MULTI-ASSIGNMENT ALIASES (CART-1487, CART-1488). Lua has no implicit receiver: a bare `tonumber(x)` is\n-- the builtin, never some file's `T.tonumber` field function — the resolver's tail join linked 714 such calls on lua/\n-- to a wrong definition and refused ~3,100 more as ambiguous. And a multi-assignment handed every name the FIRST\n-- value, so `local pack, getter = lib.pack, lib.reader` aliased getter to pack. Pinned both ways: the field function\n-- is still reached through its qualified spelling, and a single-name alias still resolves.\n\nlocal ts = require 'cartograph.providers.treesitter'\n\nlocal FILES = {\n    ['lib.lua'] = table.concat({\n        'local M = {}',\n        'M.FAMILIES = {}',\n        'function M.FAMILIES.tonumber(x) return x end',\n        'function M.pack(x) return x end',\n        'function M.reader(x) return x end',\n        'function M.make() return 1, 2 end',\n        'return M', '' }, '\\n'),\n    ['use.lua'] = table.concat({\n        'local lib = require(\"lib\")',\n        'local pack, getter = lib.pack, lib.reader',\n        'local one = lib.reader',\n        'local first, second = lib.make()',\n        'local M = {}',\n        'function M.go(s)',\n        '  local n = tonumber(s)',\n        '  local q = lib.FAMILIES.tonumber(s)',\n        '  return pack(n), getter(n), one(n), second(n)',\n        'end',\n        'return M', '' }, '\\n'),\n}\n\nlocal function extract()\n    local root = vim.fn.tempname(); vim.fn.mkdir(root, 'p')\n    for rel, src in pairs(FILES) do local fd = assert(io.open(root .. '/' .. rel, 'w')); fd:write(src); fd:close() end\n    local data = ts.extract(root)\n    vim.fn.delete(root, 'rf')\n    local cv = require('cartograph.callview').of(data)\n    local by = {}\n    for i = 1, cv.n do\n        local k = cv.get(i, 'full') or cv.get(i, 'callee')\n        local r = cv.get(i, 'refused')\n        by[k] = { to = cv.get(i, 'to'), refused = type(r) == 'table' and r.rule or r }\n    end\n    return by\nend\n\ntest('bare call: Lua `tonumber(x)` is the builtin — never a qualified `T.tonumber` of another file; the field function is still reached by its qualified name (CART-1487)', function ()\n    if not parser_available('lua') then skip 'no lua parser' end\n    local by = extract()\n    eq(nil, by.tonumber.to, 'the bare builtin links to no project definition')\n    eq(nil, by.tonumber.refused, 'and is not refused as ambiguous either')\n    eq('lib.lua::M.FAMILIES.tonumber@2', by['lib.FAMILIES.tonumber'].to)\nend)\n\ntest('multi-assignment: name i takes value i — `local pack, getter = lib.pack, lib.reader` aliases each to its own member; a name past the last value is no alias (CART-1488)', function ()\n    if not parser_available('lua') then skip 'no lua parser' end\n    local by = extract()\n    eq('lib.lua::M.pack@3', by.pack.to)\n    eq('lib.lua::M.reader@4', by.getter.to, 'the SECOND name, the second value')\n    eq('lib.lua::M.reader@4', by.one.to, 'a single-name alias still resolves')\n    eq(nil, by.second.to, '`local first, second = lib.make()`: second is make\\'s second return, no alias')\nend)","file":"tests/barecall_spec.lua"}},"verb":"edit","id":"1791228259.313208-edit"},{"invocation":{"touched":["tests/barecall_spec.lua"],"verb":"edit","args":{"before":"        by[k] = { to = cv.get(i, 'to'), refused = type(r) == 'table' and r.rule or r }","file":"tests/barecall_spec.lua","after":"        by[k] = { to = cv.get(i, 'to'), refused = type(r) == 'table' and r.rule or r, ext = cv.get(i, 'ext') }"}},"verb":"edit","id":"1791228286.991028-edit"},{"invocation":{"touched":["tests/barecall_spec.lua"],"verb":"edit","args":{"before":"test('bare call: Lua `tonumber(x)` is the builtin — never a qualified `T.tonumber` of another file; the field function is still reached by its qualified name (CART-1487)', function ()\n    if not parser_available('lua') then skip 'no lua parser' end\n    local by = extract()\n    eq(nil, by.tonumber.to, 'the bare builtin links to no project definition')\n    eq(nil, by.tonumber.refused, 'and is not refused as ambiguous either')\n    eq('lib.lua::M.FAMILIES.tonumber@2', by['lib.FAMILIES.tonumber'].to)\nend)","file":"tests/barecall_spec.lua","after":"test('bare call: Lua `tonumber(x)` is the builtin — never a qualified `T.tonumber` of another file: no link, no ambiguity, an EXTERNAL disposition (CART-1487)', function ()\n    if not parser_available('lua') then skip 'no lua parser' end\n    local by = extract()\n    eq(nil, by.tonumber.to, 'the bare builtin links to no project definition')\n    eq(nil, by.tonumber.refused, 'and is not refused as ambiguous either')\n    ok(by.tonumber.ext ~= nil, 'it is disposed as external')\nend)"}},"verb":"edit","id":"1791228287.061621-edit"},{"invocation":{"touched":["tests/barecall_spec.lua"],"verb":"edit","args":{"before":"-- value, so `local pack, getter = lib.pack, lib.reader` aliased getter to pack. Pinned both ways: the field function\n-- is still reached through its qualified spelling, and a single-name alias still resolves.","file":"tests/barecall_spec.lua","after":"-- value, so `local pack, getter = lib.pack, lib.reader` aliased getter to pack. Pinned both ways: a single-name alias\n-- still resolves. (`lib.FAMILIES.tonumber(s)` — a nested field through the alias — is refused `blocked`: CART-1489.)"}},"verb":"edit","id":"1791228294.701336-edit"},{"invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"before":"                    if not vseen[vnamen:id()] then\n                        vseen[vnamen:id()] = true\n                        handle_var(vdefn, vnamen, M._pair_value(vnamen, valn)) -- (via M: M.extract is at the 60-upvalue limit)\n                    end","after":"                    -- (handle_var keeps a name's FIRST match only — seen_var, the cross-product guard — and the query\n                    -- pairs every name with the first value first: pair_value picks the name's own value)\n                    handle_var(vdefn, vnamen, M._pair_value(vnamen, valn)) -- (via M: M.extract is at the 60-upvalue limit)","file":"lua/cartograph/providers/treesitter.lua"}},"verb":"edit","id":"1791228378.540354-edit"},{"invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"before":"            local vseen = {} -- (a multi-assignment's name is matched once per value it pairs with: handled ONCE)","file":"lua/cartograph/providers/treesitter.lua","after":""}},"verb":"edit","id":"1791228378.921716-edit"},{"invocation":{"touched":["tests/userequire_spec.lua"],"verb":"edit","args":{"before":"    ok(resolved(data, 'user6.lua', 'lib.lua::Lib.fmt@1'), 'bare fmt() was linked to Lib.fmt (a tail guess)')","file":"tests/userequire_spec.lua","after":"    -- (the resolver USED to link bare fmt() to Lib.fmt by tail; Lua has no implicit receiver, so it no longer guesses —\n    -- CART-1487 — and the use must still be no finding)\n    ok(not resolved(data, 'user6.lua', 'lib.lua::Lib.fmt@1'), 'bare fmt() is NOT linked to Lib.fmt (no tail guess)')"}},"verb":"edit","id":"1791228465.043440-edit"},{"invocation":{"touched":["tests/userequire_spec.lua"],"verb":"edit","args":{"before":"    eq('other-name', row(classify(data), 'user6.lua').class,\n        'the environment carries `fmt`, and lib.lua defines only `Lib.fmt`')","file":"tests/userequire_spec.lua","after":"    eq(nil, row(classify(data), 'user6.lua'),\n        'no cross-file use reaches lib.lua at all: nothing to classify (it was `other-name` while the tail guess linked it)')"}},"verb":"edit","id":"1791228474.736346-edit"},{"invocation":{"touched":["lua/cartograph/spec/contract.lua"],"verb":"edit","args":{"before":"    dot_calls_are_methods = 'SCOPE&KEY',\n    hash_qualified = 'SCOPE&KEY',","file":"lua/cartograph/spec/contract.lua","after":"    dot_calls_are_methods = 'SCOPE&KEY',\n    bare_calls_bind_bare = 'SCOPE&KEY', -- no implicit receiver: a bare call never tail-matches `T.f` (CART-1487)\n    hash_qualified = 'SCOPE&KEY',"}},"verb":"edit","id":"1791228490.508147-edit"},{"invocation":{"touched":["tests/fixtures/luaoracle/alpha.lua"],"verb":"edit","args":{"before":"-- also defined in beta.lua; called BARE (roll(1)) in user.lua so the call is\n-- genuinely ambiguous — no require-alias receiver for module-alias to narrow\nfunction M.roll(n)\n  return n\nend","after":"-- a GLOBAL, also defined in beta.lua; called BARE (roll(x)) in user.lua, so the\n-- call is genuinely ambiguous: whichever file loads last owns the global. (It was\n-- `M.roll` in both until CART-1487 — a bare call cannot