{"version":1,"entries":[{"bytes":1,"decided_by":"tactic","id":"1791228378.921716-edit","decisions":[],"verb":"edit","invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"file":"lua/cartograph/providers/treesitter.lua","before":"            local vseen = {} -- (a multi-assignment's name is matched once per value it pairs with: handled ONCE)","after":""}}},{"bytes":592,"decided_by":"tactic","id":"1791229653.565866-edit","decisions":[],"verb":"edit","invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"file":"lua/cartograph/providers/treesitter.lua","before":"M._lexical_pick = lexical_pick","after":"M._lexical_pick = lexical_pick\n\n-- can definition `n` RECEIVE a `x:f()` call (CART-1491)? The colon passes x as the first argument, so in a language\n-- whose spec sets `colon_calls_pass_self` (Lua) the target is a method — `T:f`, or a first parameter `self`. A plain\n-- function (`M.root(...)`, a local `is_closing`) never is: `tree:root()` had been linked to ecosystem's M.root.\nfunction M._takes_self(n)\n    if n.kind == 'method' or tostring(n.name):find(':', 1, true) then return true end\n    local p = n.params\n    return type(p) == 'table' and (p[1] == 'self' or (type(p[1]) == 'table' and p[1].name == 'self'))\nend"}}},{"bytes":200,"decided_by":"tactic","id":"1791229653.736278-edit","decisions":[],"verb":"edit","invocation":{"touched":["lua/cartograph/spec/lua.lua"],"verb":"edit","args":{"file":"lua/cartograph/spec/lua.lua","before":"    bare_calls_bind_bare = true,","after":"    bare_calls_bind_bare = true,\n    -- `x:f()` passes x as the first argument: its target is a method (`T:f` or a first parameter `self`), never a\n    -- plain function of the same name (CART-1491)\n    colon_calls_pass_self = true,"}}},{"bytes":107,"decided_by":"tactic","id":"1791229653.826904-edit","decisions":[],"verb":"edit","invocation":{"touched":["lua/cartograph/spec/contract.lua"],"verb":"edit","args":{"file":"lua/cartograph/spec/contract.lua","before":"    bare_calls_bind_bare = 'SCOPE&KEY', -- no implicit receiver: a bare call never tail-matches `T.f` (CART-1487)","after":"    bare_calls_bind_bare = 'SCOPE&KEY', -- no implicit receiver: a bare call never tail-matches `T.f` (CART-1487)\n    colon_calls_pass_self = 'SCOPE&KEY', -- `x:f()` reaches a method only, never a plain `M.f` (CART-1491)"}}},{"bytes":795,"decided_by":"tactic","id":"1791229751.137442-edit","decisions":[],"verb":"edit","invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"file":"lua/cartograph/providers/treesitter.lua","before":"    local p = n.params\n    return type(p) == 'table' and (p[1] == 'self' or (type(p[1]) == 'table' and p[1].name == 'self'))\nend","after":"    local p = n.params\n    return type(p) == 'table' and (p[1] == 'self' or (type(p[1]) == 'table' and p[1].name == 'self'))\nend\n\n-- a resolution VETO (CART-1491): `x:f()` resolved to a definition that cannot receive self, in a language whose spec\n-- sets colon_calls_pass_self, is no edge — a `blocked` refusal naming the candidate. It only VETOES: an ambiguous set\n-- is left as it is, because dropping its impossible members turns a refusal into a name-only guess about the receiver\n-- (measured: `fd:close()` → mcp's Client:close, `node:named()` → band's Band:named). -> the refusal, or nil.\nfunction M._method_veto(target, name, file)\n    if not (target and name and file and tostring(name):find(':', 1, true)) then return nil end\n    local _, spec = elang_for(file)\n    if not (spec and spec.colon_calls_pass_self) or M._takes_self(target) then return nil end\n    return tsutil.refusal('blocked', { target })\nend"}}},{"bytes":176,"decided_by":"tactic","id":"1791229761.571544-edit","decisions":[],"verb":"edit","invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"file":"lua/cartograph/providers/treesitter.lua","before":"                    local pick = M._lexical_pick(refused.cands, p.file, from and node_index[from], p.at, parent_fn, node_index) -- (via M: this function is at the 60-upvalue limit)\n                    if pick then target, inferred, refused = pick, false, nil end\n                end","after":"                    local pick = M._lexical_pick(refused.cands, p.file, from and node_index[from], p.at, parent_fn, node_index) -- (via M: this function is at the 60-upvalue limit)\n                    if pick then target, inferred, refused = pick, false, nil end\n                end\n                local veto = M._method_veto(target, p.full or p.call.callee, p.file) -- (CART-1491)\n                if veto then target, inferred, refused = nil, nil, veto end"}}},{"bytes":168,"decided_by":"tactic","id":"1791229761.929137-edit","decisions":[],"verb":"edit","invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"file":"lua/cartograph/providers/treesitter.lua","before":"                    local pick = M._lexical_pick(refused.cands, cfile, cfn and node_index[cfn], cget(i, 'at'), parent_fn, node_index) -- (via M: this function is at the 60-upvalue limit)\n                    if pick then target, inferred, refused = pick, false, nil end\n                end","after":"                    local pick = M._lexical_pick(refused.cands, cfile, cfn and node_index[cfn], cget(i, 'at'), parent_fn, node_index) -- (via M: this function is at the 60-upvalue limit)\n                    if pick then target, inferred, refused = pick, false, nil end\n                end\n                local veto = M._method_veto(target, cfull or ccallee, cfile) -- (CART-1491)\n                if veto then target, inferred, refused = nil, nil, veto end"}}},{"bytes":112,"decided_by":"tactic","id":"1791229801.916355-edit","decisions":[],"verb":"edit","invocation":{"touched":["tests/barecall_spec.lua"],"verb":"edit","args":{"file":"tests/barecall_spec.lua","before":"        'function M.make() return 1, 2 end',\n        'return 