xtern) do if not rset[f] then rset[f] = true; roots[#roots + 1] = f end end\n            table.sort(roots)\n            local P = B.probe({ sources = bsrc, roots = roots, gc = gc, heap_types = heap, sizes = B.sizes(bsrc, opts.src, opts.cflags),\n                templates = vim.tbl_extend('force', {}, require('cartograph.cjs').BUILTINS, B.VM_ASM) })\n            local files = {}\n            for _, mod in pairs(static.generated) do files[mod] = opts.pack_dir .. '/$' .. mod .. '.js' end\n            local gen = B.generated(files)\n            -- UBIQUITOUS cores (in most rows' closures: the error and formatting machinery) decide no row's kind\n            local first, count, nrows = {}, {}, 0\n            for _, r in ipairs(rows) do\n                if r.cfn and P.functions[r.cfn] then\n                    nrows = nrows + 1\n                    first[r] = B.classify(P, r.cfn, gen, nil)\n                    for _, c in ipairs(first[r].cores) do count[c] = (count[c] or 0) + 1 end\n                end\n            end\n            local ubiq = {}\n            for c, n in pairs(count) do if n > nrows / 2 then ubiq[c] = true end end\n            for _, r in ipairs(rows) do\n                if first[r] then\n                    r.boundary = B.classify(P, r.cfn, gen, ubiq)\n                    -- the pack-side facts win (a refused stub, a host binding, a plain value); otherwise the C decides\n                    if r.pack_kind ~= 'refused' and r.pack_kind ~= 'host' and r.pack_kind ~= 'value' then r.pack_kind = r.boundary.kind end\n                end\n            end\n            local own = { clean = 0, boundary = 0, gap = 0 }\n            local gapwhy, gcuse = {}, {}\n            for name, f in pairs(P.functions) do\n                own[f.own] = own[f.own] + 1\n                if f.own == 'gap' then for _, w in ipairs(f.why) do gapwhy[w] = gapwhy[w] or {}; gapwhy[w][#gapwhy[w] + 1] = name end end\n                if f.own == 'boundary' then for _, w in ipairs(f.why) do local t = w:match('VM object `([%w_]+)`'); if t then gcuse[t] = (gcuse[t] or 0) + 1 end end end\n            end\n            for _, fs in pairs(gapwhy) do table.sort(fs) end\n            local clean_closure = 0\n            for _, f in pairs(P.functions) do if not f.dirty then clean_closure = clean_closure + 1 end end\n            boundary = { gc_types = sorted(gc), gcheader = hfields, heap_types = sorted(heap), unlaid = unlaid, skipped = bskipped,\n                functions = #P.order, own = own, clean_closure = clean_closure, generated = sorted(gen), ubiquitous = sorted(ubiq),\n                gaps = gapwhy, gc_uses = gcuse, status = P.functions }\n        else\n            boundary = { error = hfields }\n        end\n    end\n    local summary = { lj = 0, oracle = 0, pack = 0, missing = {}, extra = 0, by_kind = {}, lj_kinds = {} }"}},"bytes":2565},{"decided_by":"tactic","decisions":[],"verb":"edit","id":"1790723578.696034-edit","invocation":{"verb":"edit","touched":["lua/cartograph/luajs/packmap.lua"],"args":{"file":"lua/cartograph/luajs/packmap.lua","before":"        not_in_oracle = not_in_oracle, missing_modules = pack.missing_modules, drift = sorted(drift), aligned = aligned, ubiquitous = sorted(ubiquitous),","after":"        not_in_oracle = not_in_oracle, missing_modules = pack.missing_modules, drift = sorted(drift), aligned = aligned, ubiquitous = sorted(ubiquitous), boundary = boundary,"}},"bytes":175},{"decided_by":"tactic","decisions":[],"verb":"edit","id":"1790723616.198172-edit","invocation":{"verb":"edit","touched":["lua/cartograph/luajs/packmap.lua"],"args":{"before":"                    if r.pack_kind ~= 'refused' and r.pack_kind ~= 'host' and r.pack_kind ~= 'value' then r.pack_kind = r.boundary.kind end","file":"lua/cartograph/luajs/packmap.lua","after":"                    if r.pack_kind ~= 'refused' and r.pack_kind ~= 'host' and r.pack_kind ~= 'value' then\n                        r.pack_kind = r.boundary.kind\n                        local mods = {