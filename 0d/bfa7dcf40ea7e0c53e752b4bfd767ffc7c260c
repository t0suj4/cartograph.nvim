\n        end\n    end, 'l')\nend\nfor _, f in ipairs(vim.fn.glob('tests/*_spec.lua', false, true)) do\n    if not only or only[f:match('([^/]+)%.lua$')] then\n        cover_spec = f:match('([^/]+)%.lua$')","file":"tests/run.lua","before":"for _, f in ipairs(vim.fn.glob('tests/*_spec.lua', false, true)) do\n    if not only or only[f:match('([^/]+)%.lua$')] then"},"touched":["tests/run.lua"],"verb":"edit"},"verb":"edit","bytes":1261,"decided_by":"tactic"},{"id":"1791217330.968992-edit","decisions":[],"invocation":{"args":{"after":"for _, t in ipairs(reg) do\n    cover_spec = t.spec\n    local t0 = times and vim.uv.hrtime()","file":"tests/run.lua","before":"for _, t in ipairs(reg) do\n    local t0 = times and vim.uv.hrtime()"},"touched":["tests/run.lua"],"verb":"edit"},"verb":"edit","bytes":24,"decided_by":"tactic"},{"id":"1791217331.029215-edit","decisions":[],"invocation":{"args":{"after":"    for key, lines in pairs(cover) do\n        local spec, src = key:match('^(.-)\\t(.*)$')\n        src = src or key\n        local rel = src:match('lua/cartograph/.*$') or src\n        for line in pairs(lines) do out[#out + 1] = (spec and (spec .. '\\t') or '') .. rel .. ':' .. line end\n    end","file":"tests/run.lua","before":"    for src, lines in pairs(cover) do\n        local rel = src:match('lua/cartograph/.*$') or src\n        for line in pairs(lines) do out[#out + 1] = rel .. ':' .. line end\n    end"},"touched":["tests/run.lua"],"verb":"edit"},"verb":"edit","bytes":225,"decided_by":"tactic"},{"id":"1791217359.180828-edit","decisions":[],"invocation":{"args":{"after":"    b.state, b.times = state, times\n    -- (COVER: each worker its own part — they would overwrite one file — concatenated below)\n    b.cover = (vim.env.COVER and vim.env.COVER ~= '') and (vim.fn.tempname() .. '-cover') or nil\n    b.proc = vim.system({ 'nvim', '--headless', '-u', 'NONE', '--noplugin', '-c', 'set rtp+=' .. cwd, '-c', 'luafile tests/run.lua' },\n        { cwd = cwd, text = true, env = { SP