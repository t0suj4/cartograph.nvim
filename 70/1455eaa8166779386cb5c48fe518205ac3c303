ute paths)' },\n            { name = 'set', type = 'array', items = 'string', desc = '--set k=v overrides' },\n        },\n        run = v_helm_chart,\n    },\n    helm_stages = {\n        summary = 'a plain chart deployed per stage by the repo\\'s own helm command lines: each stage\\'s values chain, must-override placeholders left, no-op overrides, plaintext secret count, and the drift between stages',\n        subject = 'graph',\n        tier_basis = 'observation', absences = { 'absent' },\n        args = {\n            { name = 'release', type = 'string', desc = 'release name for the renders (default: the chart directory name)' },\n        },\n        run = v_helm_stages,\n    },\n    graph_info = {\n"}}},{"bytes":239,"decided_by":"tactic","decisions":[],"verb":"edit","id":"1790896334.329152-edit","invocation":{"touched":["lua/cartograph/agent.lua"],"verb":"edit","args":{"before":"    'ports',\n","after":"    'ports',\n    -- INFRASTRUCTURE (CART-1048, CART-1297): Kubernetes manifests' soft edges, a Helm chart rendered and linted, a plain\n    -- chart's stages — READS (a render goes to a temp directory)\n    'k8s_findings', 'helm_chart', 'helm_stages',\n","file":"lua/cartograph/agent.lua"}}},{"bytes":48,"decided_by":"tactic","decisions":[],"verb":"edit","id":"1790896334.380164-edit","invocation":{"touched":[".claude/skills/cartograph/SKILL.md"],"verb":"edit","args":{"before":"FEDERATE  ports\n","file":".claude/skills/cartograph/SKILL.md","after":"FEDERATE  ports\nINFRA     k8s_findings  helm_chart  helm_stages\n"}}},{"bytes":87,"decided_by":"tactic","decisions":[],"verb":"edit","id":"1790896334.419399-edit","invocation":{"touched":[".claude/skills/cartograph/SKILL.md"],"verb":"edit","args":{"before":"37, in the order they may be trusted in. `graph_info` first — it reports which verbs\n","file":".claude/skills/cartograph/SKILL.md","after":"40, in the order they may be trusted in. `graph_info` first — it reports which verbs\n"}}},{"bytes":676,"decided_by":"tactic"