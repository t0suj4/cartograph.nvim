{"entries":[{"decisions":[],"verb":"edit","invocation":{"args":{"before":"M._pair_value = pair_value","after":"M._pair_value = pair_value\nM._mention_field = mention_field -- (atlas.fields asks the SAME accessor as the use edges' flds, CART-1591)","file":"lua/cartograph/providers/treesitter.lua"},"verb":"edit","touched":["lua/cartograph/providers/treesitter.lua"]},"bytes":108,"decided_by":"tactic","id":"1791498162.783969-edit"},{"decisions":[],"verb":"edit","invocation":{"args":{"before":"-- the immediate field of a base-var occurrence, or nil for a whole-var use\nlocal function field_of(c, src)\n    local p = c:parent()\n    -- @langs-ok php's `$x` wrapper; a no-op peel on every other declared grammar\n    if p and p:type() == 'variable_name' then c = p; p = p:parent() end -- php $x\n    if not p then return nil end\n    local t = p:type()\n    if t == 'dot_index_expression' or t == 'member_access_expression' then\n        if p:named_child(0) ~= c then return nil end\n        local f = p:named_child(1)\n        return f and vim.treesitter.get_node_text(f, src) or '[]'\n    end\n    if t == 'bracket_index_expression' or t == 'subscript_expression' then\n        if p:named_child(0) ~= c then return nil end\n        local k = p:named_child(1)\n        if k and k:type() == 'string' then\n            local inner = k:named_child(0)\n            if inner then return vim.treesitter.get_node_text(inner, src) end\n        end\n        return '[]' -- computed key: one bucket, honestly coarse\n    end\n    return nil\nend","file":"lua/cartograph/atlas.lua","after":"-- the immediate field of a base-var occurrence, or nil for a whole-var use: the SAME accessor the use edges' flds\n-- come from (providers/treesitter.lua mention_field over the spec's member / index positions). atlas kept its own\n-- lua / php list, so a python / js / java / go / rust field write landed in the WHOLE bucket — read as a rebind that\n-- hedges every field claim — while e.flds named the field (CART-1591)\nlocal function field_of(c, n, src, spec)\n    if not n then return nil end\n    return require('cartograph.providers.treesitter')._mention_field(c, n, src, spec.member_positions, spec.index_positions)\nend"},"verb":"edit","touched":["lua/cartograph/atlas.lua"]},"bytes":622,"decided_by":"tactic","id":"1791498175.569876-edit"},{"decisions":[],"verb":"edit","invocation":{"args":{"before":"                        local f = field_of(c, src)\n                        local n = c:parent()","after":"                        local n = c:parent()\n                        local f = field_of(c, n, src, spec)","file":"lua/cartograph/atlas.lua"},"verb":"edit","touched":["lua/cartograph/atlas.lua"]},"bytes":60,"decided_by":"tactic","id":"1791498175.638078-edit"},{"decisions":[],"verb":"edit","invocation":{"args":{"before":"-- @langs lua php javascript python typescript tsx\n-- NOT a lua module despite the neighbours: `field_of` reads php's `variable_name`\n-- wrapper and pairs `dot_index_expression`/`member_access_expression` and\n-- `bracket_index_expression`/`subscript_expression` as or-groups — it was written\n-- polyglot and nothing said so (the spec/javascript.lua precedent, CART-0304).","file":"lua/cartograph/atlas.lua","after":"-- @langs any — `field_of` asks each language's spec (member / index positions), CART-1591"},"verb":"edit","touched":["lua/cartograph/atlas.lua"]},"bytes":93,"decided_by":"tactic","id":"1791498175.698380-edit"},{"decisions":[],"verb":"edit","invocation":{"args":{"before":"    -- (python has no field_of form, so the write lands in the WHOLE bucket where the use edge's flds say `sub` — a\n    -- disagreement this pins only for its read count, CART-1591)\n    local fc = atlas.fields(store, vid)\n    eq({ 1, 1 }, { fc.whole.nw, fc.whole.nr }, 'a memo call on a sub-object: one write, one read')","after":"    -- (the field the use edge's flds name — `sub` —, never the whole bucket: atlas asks the same accessor, CART-1591)\n    local fc = atlas.fields(sto