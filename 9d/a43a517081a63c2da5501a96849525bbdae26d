`text`'s\n    -- rewritten slice starts in the file (the `within` path rewrites a function's slice).\n    local discharged = 0\n    local function mk_admit(rel, text, drow, dcol)\n        if #changing == 0 or opts.changes == 'accept' then return nil end\n        local N = require 'cartograph.narrow'\n        return function (site)\n            if not site.rule.sample or site.rule.sample.verdict ~= 'differs' then return true end\n            local row, col = site.where()\n            local facts\n            if row then\n                if row == 0 then col = col + (dcol or 0) end\n                facts = N.facts_at(store, rel, text, row + (drow or 0), col)\n            end\n            local keep = M.site_keeps(site.rule, site.values, facts)\n            if keep then discharged = discharged + 1 end\n            return keep\n        end\n    end\n    local preserves_why = 'the rewrite applies what ONE example demonstrated; nothing checks that it preserves behaviour'\n","file":"lua/cartograph/byexample.lua"}},"id":"1791843116.454137-edit","decided_by":"tactic","bytes":1173,"decisions":[]},{"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/byexample.lua"],"args":{"before":"        local new, n_sites = M.rewrite(rules, slice, opts.lang)\n        local wrapped = false\n        if not new then\n            new, n_sites = M.rewrite(rules, 'return ' .. slice, opts.lang)\n            if new then new, wrapped = new:gsub('^return ', '', 1), true end\n        end\n","file":"lua/cartograph/byexample.lua","after":"        local new, n_sites, _, und = M.rewrite(rules, slice, opts.lang, mk_admit(n.file, text, sl, sc))\n        local wrapped = false\n        if not new then\n            new, n_sites, _, und = M.rewrite(rules, 'return ' .. slice, opts.lang, mk_admit(n.file, text, sl, sc - #'return '))\n            if new then new, wrapped = new:gsub('^return ', '', 1), true end\n        end\n        und = und or {}\n"}},"id":"1791843116.535787-edit","decided_by":"tactic","bytes":256,"decisions":[]},{"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/byexample.lua"],"args":{"before":"        if n_sites == 0 then\n            return nil, ('the rule %s matches nothing inside %s'):format(table.concat(rule_text, ', '), tostring(n.name)), 'empty'\n        end\n        local stop = changes_stop()\n        if stop then return nil, stop, 'decision' end\n","file":"lua/cartograph/byexample.lua","after":"        if n_sites == 0 and #und > 0 then\n            return nil, ('%s; no site inside %s is shown to avoid it (%d undecided)'):format(changes_stop(), tostring(n.name), #und), 'decision'\n        end\n        if n_sites == 0 then\n            return nil, ('the rule %s matches nothing inside %s'):format(table.concat(rule_text, ', '), tostring(n.name)), 'empty'\n        end\n"}},"id":"1791843116.618990-edit","decided_by":"tactic","bytes":199,"decisions":[]},{"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/byexample.lua"],"args":{"before":"            preserves = 'none', preserves_why = preserves_why, behaviour = behaviour,\n            hazards = {},\n","file":"lua/cartograph/byexample.lua","after":"            preserves = 'none', preserves_why = preserves_why, behaviour = behaviour, discharged = discharged,\n            hazards = #und > 0 and { require('cartograph.hazard').new('sites-undecided', ('%d site(s) left as written: no evidence there rules out the values the rule treats differently — changes = \\'accept\\' rewrites them too'):format(#und),\n                nil, { undecided = und }, 'informational') } or {},\n"}},"id":"1791843116.700978-edit","decided_by":"tactic","bytes":424,"decisions":[]},{"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/byexample.lua"],"args":{"before":"            local new, n, refused = M.rewrite(rules, text, opts.lang)\n            for _, r in ipairs(new and refused or {}) do refusals[#refusals + 1] = ('%s: `%s` — %s'):format(rel, r.text, r.why) end\n            -- a file the lossless reader cannot read was NOT looked at: say so, never count it as \"no match\"\n            if not new then unread[#unread + 1] = rel end\n            if new and n > 0 then\n                edits[rel] = new; touched[#touched + 1] = rel\n                stamps[rel] = txn.disk_stamp(root, rel)\n                per[#per + 1] = ('%s (%d)'):format(rel, n)\n                total = total + n\n            end\n","file":"lua/cartograph/byexample.lua","after":"            local new, n, refused, und = M.rewrite(rules, text, opts.lang, mk_admit(rel, text))\n            for _, r in ipairs(new and refused or {}) do refusals[#refusals + 1] = ('%s: `%s` — %s'):format(rel, r.text, r.why) end\n            for _, u in ipairs(new and und or {}) do undecided[#undecided + 1] = ('%s: `%s`'):format(rel, u.text) end\n            -- a file the lossless reader cannot read was NOT looked at: say so, never count it as \"no match\"\n            if not new then unread[#unread + 1] = rel end\n            local matched = new and n + #(und or {}) or 0\n            if matched > 0 then per[#per + 1] = ('%s (%d)'):format(rel, matched); nfiles = nfiles + 1 end\n            if new and n > 0 then\n                edits[rel] = new; touched[#touched + 1] = rel\n                stamps[rel] = txn.disk_stamp(root, rel)\n                total = total + n\n            end\n"}},"id":"1791843116.783655-edit","decided_by":"tactic","bytes":260,"decisions":[]},{"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/byexample.lua"],"args":{"before":"    local refusals = {} -- (spacing-independent sites matched and refused, by file: a comment beside a deleted token, a\n","after":"    local undecided, nfiles = {}, 0 -- (sites of a behaviour-changing rule nothing showed safe, by file: CART-1668)\n    local refusals = {} -- (spacing-independent sites matched and refused, by file: a comment beside a deleted token, a\n","file":"lua/cartograph/byexample.lua"}},"id":"1791843116