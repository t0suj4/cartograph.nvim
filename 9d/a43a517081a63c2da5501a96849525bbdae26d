{"entries":[{"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/narrow.lua"],"args":{"before":"    L[#L + 1] = 'dispatches to string.m. The candidate count is the devirt gap the VM would close.'\n    return L\nend\n\nreturn M\n","file":"lua/cartograph/narrow.lua","after":"    L[#L + 1] = 'dispatches to string.m. The candidate count is the devirt gap the VM would close.'\n    return L\nend\n\n--- The narrowing facts AT A POSITION of `text` (a file of the graph, read as it is NOW): the dominating guards of the\n--- node there, RAW kinds (truthy is not collapsed to non-nil — `false` is excluded by truthy only). A rewrite asks it\n--- whether a site's operand can take a value its rule treats differently (byexample, CART-1668). The innermost\n--- function holding the position must be a node of the graph: its flow record is what kills a reassigned var's facts,\n--- and without it no fact is sound — nil then, never an empty env read as \"nothing narrowed\".\n--- -> { [path] = kind } | nil, why\nfunction M.facts_at(store, rel, text, row, col)\n    local lang = EXT_LANG[rel:match('%.(%w+)$') or '']\n    if not lang or not (vocab[lang] and VERB_LANG.narrow[lang]) then return nil, 'no narrowing vocabulary for ' .. rel end\n    local ok, parser = pcall(vim.treesitter.get_string_parser, require('cartograph.parseview').view(text, lang), lang)\n    if not ok or not parser then return nil, 'no parser' end\n    local root = parser:parse()[1]:root()\n    local site = root:named_descendant_for_range(row, col, row, col)\n    local fn = site\n    while fn and not FN_TYPES[fn:type()] do fn = fn:parent() end\n    if not fn then return nil, 'the position is at file scope: no function, no guards' end\n    local fsl = fn:start()\n    local node\n    for _, n in ipairs(store.by_file and store.by_file[rel] or {}) do\n        if n.range and at.sl(n.range) == fsl then node = node or n end\n    end\n    if not node then return nil, 'the enclosing function is no node of the graph (its reassignments are unknown)' end\n    local classify = gated_classify(vocab[lang], type_is_shadowed(lang, node))\n    return env_of(site, text, classify, mutated_of(node), field_unstable_of(fn, text))\nend\n\nreturn M\n"}},"id":"1791842978.255901-edit","decided_by":"tactic","bytes":1691,"decisions":[]},{"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/narrow.lua"],"args":{"before":"    local node\n    for _, n in ipairs(store.by_file and store.by_file[rel] or {}) do\n        if n.range and at.sl(n.range) == fsl then node = node or n end\n    end\n    if not node then return nil, 'the enclosing function is no node of the graph (its reassignments are unknown)' end\n","file":"lua/cartograph/narrow.lua","after":"    local node, twice\n    for _, n in ipairs(store.by_file and store.by_file[rel] or {}) do\n        if n.range and at.sl(n.range) == fsl then twice = node ~= nil; node = node or n end\n    end\n    if not node then return nil, 'the enclosing function is no node of the graph (its reassignments are unknown)' end\n    if twice then return nil, 'two definitions start on the enclosing function\\'s line: which one holds the position is not known' end\n"}},"id":"1791842987.778982-edit","decided_by":"tactic","bytes":249,"decisions":[]},{"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/byexample.lua"],"args":{"before":"    local idx, total, raised = {}, 0, 0\n","file":"lua/cartograph/byexample.lua","after":"    local idx, total, raised, first = {}, 0, 0, nil\n    local bad = {} -- (EVERY differing sample: { [hole] = sample index } — a site is cleared only if it avoids them all)\n"}},"id":"1791843041.185817-edit","decided_by":"tactic","bytes":175,"decisions":[]},{"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/byexample.lua"],"args":{"before":"        if not same then\n            local at = {}\n            for i, h in ipairs(hs) do at[names[h] or h] = SAMPLES[idx[i]][1] end\n            local function show(ok_, r) return ok_ and vim.inspect(r) or ('raises: ' .. norm(r)) end\n            return { verdict = 'differs', at = at, left = show(ok1, r1), right = show(ok2, r2), samples = total }\n        end\n","file":"lua/cartograph/byexample.lua","after":"        if not same then\n            local tuple = {}\n            for i, h in ipairs(hs) do tuple[h] = idx[i] end\n            bad[#bad + 1] = tuple\n            if not first then\n                local at = {}\n                for i, h in ipairs(hs) do at[names[h] or h] = SAMPLES[idx[i]][1] end\n                local function show(ok_, r) return ok_ and vim.inspect(r) or ('raises: ' .. norm(r)) end\n                first = { verdict = 'differs', at = at, left = show(ok1, r1), right = show(ok2, r2) }\n            end\n        end\n"}},"id":"1791843041.266408-edit","decided_by":"tactic","bytes":491,"decisions":[]},{"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/byexample.lua"],"args":{"before":"    if raised == total then return { verdict = 'unchecked', why = 'both sides raise on every sample' } end\n    return { verdict = 'equal', samples = total }\nend\n","file":"lua/cartograph/byexample.lua","after":"    if first then first.samples, first.bad = total, bad; return first end\n    if raised == total then return { verdict = 'unchecked', why = 'both sides raise on every sample' } end\n    return { verdict = 'equal', samples = total }\nend\n\n-- ★ PER SITE (CART-1668): a rule that changes behaviour may still keep it at a site whose operand CANNOT take the\n-- values it treats differently — `x == nil -> not x` under `if type(x) == 'table'`. `facts` = the narrowing facts at\n-- the site (narrow.facts_at: dominating guards, raw kinds); a hole bound to a closed constant knows its own type. A\n-- fact rules a sample out by its TYPE or truthiness only — an exact value (`eq:`) rules out only by its type, since\n-- the sample is not the domain (`x > 0 -> x >= 1` differs at 0.7, sampled only at 0.5). Relative to the sample, as\n-- the verdict is. -> true when every differing sample is ruled out by some hole's evidence\nlocal function kind_pred(kind)\n    if kind == 'truthy' then return function (v) return v ~= nil and v ~= false end end\n    if kind == 'non-nil' then return function (v) return v ~= nil end end\n    local ty = kind:match('^type:(.+)$') or (kind:match('^eq:s:') and 'string') or (kind:match('^eq:n:') and 'number')\n    if ty then return function (v) return type(v) == ty end end\nend\nfunction M.site_keeps(rule, values, facts)\n    local s = rule.sample\n    if not s or s.verdict ~= 'differs' then return true end\n    if not s.bad then return false end\n    local a = A()\n    local pred = {}\n    for h, v in pairs(values or {}) do\n        if type(v) == 'table' and v.k then\n            local text = a.cst_print(v)\n            local kind = facts and facts[text]\n            if kind then pred[h] = kind_pred(kind) end\n            if not pred[h] then\n                -- (a closed constant: no name read, no error — its own type is its evidence)\n                local chunk = loadstring('return ' .. text)\n                if chunk then\n                    local read = false\n                    setfenv(chunk, setmetatable({}, { __index = function () read = true end }))\n                    local ok_, c = pcall(chunk)\n                    if ok_ and not read then pred[h] = function (x) return type(x) == type(c) end end\n                end\n            end\n        end\n    end\n    for _, tuple in ipairs(s.bad) do\n        local ruled_out = false\n        for h, i in pairs(tuple) do\n            if pred[h] and not pred[h](SAMPLES[i][2]) then ruled_out = true; break end\n        end\n        if not ruled_out then return false end\n    end\n    return true\nend\n"}},"id":"1791843041.348195-edit","decided_by":"tactic","bytes":2344,"decisions":[]},{"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/byexample.lua"],"args":{"before":"               