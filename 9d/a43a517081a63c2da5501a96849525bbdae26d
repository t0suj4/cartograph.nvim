   if admit(site) then return true end\n        undecided[#undecided + 1] = { text = (a.cst_print(pos.node):match('^[^\\n]*')) }\n        return false\n    end\n    for _, rule in ipairs(rules) do\n"}},"id":"1791843071.317343-edit","decided_by":"tactic","bytes":931,"decisions":[]},{"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/byexample.lua"],"args":{"before":"            local m = a.match(rule.lhs_ws, sn)\n            if not m.ok then return nil end\n            local function reread(text)\n","file":"lua/cartograph/byexample.lua","after":"            local m = a.match(rule.lhs_ws, sn)\n            if not m.ok then return nil end\n            if not exact and not admitted(rule, m.values, pos) then return nil end\n            local function reread(text)\n"}},"id":"1791843071.402174-edit","decided_by":"tactic","bytes":83,"decisions":[]},{"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/byexample.lua"],"args":{"before":"        local function ws_try(pos)\n","after":"        local function ws_try(pos, exact)\n","file":"lua/cartograph/byexample.lua"}},"id":"1791843071.485144-edit","decided_by":"tactic","bytes":42,"decisions":[]},{"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/byexample.lua"],"args":{"before":"                if m.ok then\n                    -- (an EXACT match takes the token script too when it can: instantiating moves a carried body\n                    -- with the indentation and the trailing whitespace of its OLD depth — php's `}` landed indented\n                    -- under the loop it closed. Refused there, the instantiation stands: the example spelled it.)\n                    local stmt = rule.lhs_ws and ws_try(pos)\n                    if stmt then ws_hits[#ws_hits + 1] = { path = pos.path, term = stmt }\n                    else hits[#hits + 1] = { path = pos.path, values = m.values } end\n                    covered[#covered + 1] = pos.path\n                end\n","after":"      