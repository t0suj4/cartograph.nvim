{"entries":[{"bytes":2214,"decided_by":"tactic","invocation":{"verb":"edit","args":{"before":"return {\n    -- INDEX POSITIONS (CART-0533): parent node type -> the child holding the","file":"lua/cartograph/spec/php.lua","after":"-- ── LEXICAL SCOPES (CART-1598, php) ───────────────────────────────────────────────────────────────────────────────\n-- php declared no scope model, so a function's `$token` param or `$config` local joined another file's file-scope\n-- `$token` / `$config` — a GLOBAL, which a php function never sees without `global`. A function / method / closure\n-- binds its params and every variable its body assigns ANYWHERE (function-wide: php has no block scope, and a use\n-- before the assignment is still the local) — `$x = …`, `[$a, $b] = …`, `$x .= …`, foreach / catch / static\n-- variables —, minus its `global` names; a closure also binds its `use (…)` captures; an arrow fn only its params\n-- (it sees the enclosing scope). The binder is the variable's NAME, the mention php's spec declares.\nlocal function php_var(vn, src, out)\n    if vn and vn:type() == 'variable_name' then\n        local nm = vn:named_child(0)\n        if nm then out[node_text(nm, src)] = {} end\n    elseif vn and (vn:type() == 'list_literal' or vn:type() == 'pair' or vn:type() == 'by_ref') then\n        for _, c in tsutil.inext, vn, -1 do if c:named() then php_var(c, src, out) end end\n    end\nend\nlocal function php_params(node, src, out)\n    local ps = node:field('parameters')[1]\n    if ps then\n        for _, p in tsutil.inext, ps, -1 do\n            if p:named() then php_var(p:field('name')[1], src, out) end\n        end\n    end\n    for _, c in tsutil.inext, node, -1 do\n        if c:type() == 'anonymous_function_use_clause' then\n            for _, v in tsutil.inext, c, -1 do php_var(v, src, out) end\n        end\n    end\nend\nlocal PHP_OWN_SCOPE = { function_definition = true, method_declaration = true, anonymous_function = true,\n    arrow_function = true, class_declaration = true }\nlocal function php_fn_scope(node, src, out)\n    php_params(node, src, out)\n    local glob = {}\n    local function walk(n)\n        for _, c in tsutil.inext, n, -1 do\n            local t = c:type()\n            if not PHP_OWN_SCOPE[t] then\n                if t == 'assignment_expression' or t == 'augmented_assignment_expression'\n                    or t == 'reference_assignment_expression' then php_var(c:field('left')[1], src, out)\n                elseif t == 'foreach_statement' then\n                    local first = true\n                    for _, k in tsutil.inext, c, -1 do\n                        if k:named() and k:type() ~= 'compound_statement' then\n                            if not first then php_var(k, src, out) end -- (the first is the ITERATED expression)\n                            first = false\n                        end\n                    end\n                elseif t == 'catch_clause' or t == 'static_variable_declaration' then php_var(c:field('name')[1], src, out)\n                elseif t == 'global_declaration' then\n                    local g = {}\n                    for _, v in tsutil.inext, c, -1 do php_var(v, src, g) end\n                    for nm in pairs(g) do glob[nm] = true end\n                end\n                walk(c)\n            end\n        end\n    end\n    local body = node:field('body')[1]\n    if body then walk(body) end\n    for g in pairs(glob) do out[g] = nil end\nend\nlocal PHP_LEXICAL_SCOPES = {\n    function_definition = { kind = 'param', harvest = php_fn_scope }, method_declaration = { kind = 'param', harvest = php_fn_scope },\n    anonymous_function = { kind = 'param', harvest = php_fn_scope }, arrow_function = { kind = 'param', harvest = php_params },\n}\n\nreturn {\n    lexical_scopes = PHP_LEXICAL_SCOPES, -- CART-1598\n    -- INDEX POSITIONS (CART-0533): parent node type -> the child holding the"},"touched":["lua/cartograph/spec/php.lua"]},"id":"1791527484.292060-edit","decisions":[],"verb":"edit"},{"bytes":2012,"decided_by":"tactic","invocation":{"verb":"edit","args":{"before":"-- ⚠ A BOUND ARGUMENT IS ITS BINDING (CART-1598)","file":"tests/treesitter_spec.lua","after":"-- ⚠ A PHP FUNCTION'S VARIABLES ARE ITS OWN (CART-1598): a param or local joined another file's file-scope var — a\n-- GLOBAL, which a php function sees only through `global`.\ntest('use edges: a php param or local never reads another file\\'s global; a `global` declaration does (CART-1598)', function ()\n    if not has_parser('php') then skip 'no php parser' end\n    local bound = { 'parm', 'dflt', 'varp', 'prom', 'loca', 'lsta', 'lstb', 'augm', 'fek', 'fev', 'errv', 'stav', 'clp',\n        'clu', 'arp' }\n    local free = { 'glob' }\n    local g = { '<?php' }\n    for _, l in ipairs({ bound, free }) do for _, nm in ipairs(l) do g[#g + 1] = '$' .. nm .. ' = 0;' end end\n    local root = mkroot('a.php', table.concat(g, '\\n'))\n    local fd = assert(io.open(root .. '/b.php', 'w'))\n    fd:write(table.concat({\n        '<?php',\n        'function f($parm, int $dflt = 1, ...$varp) {',\n        '  eat($parm, $dflt, $varp, $loca, $lsta, $lstb, $augm, $fek, $fev, $errv, $stav);',\n        '  $loca = 1; [$lsta, $lstb] = g(); $augm .= \"x\";',\n        '  foreach ($xs as $fek => $fev) {}',\n        '  try {} catch (E $errv) {}',\n        '  static $stav = 0;',\n        '  global $glob; eat($glob);',\n        '  $c = function ($clp) use ($clu) { return eat($clp, $clu); };',\n        '  $d = fn($arp) => eat($arp);',\n        '}',\n        'class K { function __construct(private int $prom) { eat($prom); } }',\n    }, '\\n'))\n    fd:close()\n    local data = ts.extract(root)\n    local byid, uses = {}, {}\n    for _, n in ipairs(data.nodes) do byid[n.id] = n end\n    for _, e in ipairs(data.edges) do\n        local f, t = byid[e.from] or { file = e.from }, byid[e.to]\n        if e.kind == 'use' and t and t.file == 'a.php' and f.file == 'b.php' then uses[t.name] = true end\n    end\n    for _, nm in ipairs(bound) do ok(not uses[nm], nm .. ' is the function\\'s own: no read of a.php\\'s global ' .. vim.inspect(uses)) end\n    for _, nm in ipairs(free) do ok(uses[nm], nm .. ' is declared global: it reads a.php\\'s ' .. vim.inspect(uses)) end\n    vim.fn.delete(root, 'rf')\nend)\n\n-- ⚠ A BOUND ARGUMENT IS ITS BINDING (CART-1598)"},"touched":["tests/treesitter_spec.lua"]},"id":"1791527548.790740-edit","decisions":[],"verb":"edit"},{"bytes":267,"decided_by":"tactic","invocation":{"verb":"edit","args":{"before":"local PHP_OWN_SCOPE = { function_definition = true, method_declaration = true, anonymous_function = true,\n    arrow_function = true, class_declaration = true }\nlocal function php_fn_scope(node, src, out)\n    php_params(node, src, out)\n    local glob = {}\n    local function walk(n)\n        for _, c in tsutil.inext, n, -1 do\n            local t = c:type()\n            if not PHP_OWN_SCOPE[t] then\n                if t == 'assignment_expression' or t == 'augmented_assignment_expression'\n                    or t == 'reference_assignment_expression' then php_var(c:field('left')[1], src, out)\n                elseif t == 'foreach_statement' then\n                    local first = true\n                    for _, k in tsutil.inext, c, -1 do\n                        if k:named() and k:type() ~= 'compound_statement' then\n                            if not first then php_var(k, src, out) end -- (the first is the ITERATED expression)\n                            first = false\n                        end\n                    end\n                elseif t == 'catch_clause' or t == 'static_variable_declaration' then php_var(c:field('name')[1], src, out)\n                elseif t == 'global_declaration' then\n                    local g = {}\n                    for _, v in tsutil.inext, c, -1 do php_var(v, src, g) end\n                    for nm in pairs(g) do glob[nm] = true end\n                end\n                walk(c)\n            end\n        end\n    end\n    local body = node:field('body')[1]\n    if body then walk(body) end\n    for g in pairs(glob) do out[g] = nil end\nend","file":"lua/cartograph/spec/php.lua","after":"local PHP_OWN_SCOPE = { function_definition = true, method_declaration = true, anonymous_function = true,\n    arrow_function = true, class_declaration = true }\n-- EVERY variable a function's body names is its own — php has no implicit globals: an unassigned `$config` read in\n-- a function is an undefined LOCAL, never the file-scope `$config` — except its `global` names, `$this` and the\n-- superglobals (`$GLOBALS`, `$_GET` …)\nlocal function php_fn_scope(node, src, out)\n    php_params(node, src, out)\n    local glob = {}\n    local function walk(n)\n        for _, c in tsutil.inext, n, -1 do\n            local t = c:type()\n            if not PHP_OWN_SCOPE[t] then\n                if t == 'variable_name' then\n                    local nm = c:named_child(0)\n                    local s = nm and node_text(nm, src)\n                    if s and s ~= 'this' and s ~= 'GLOBALS' and not s:match('^_%u') then out[s] = {} end\n                elseif t == 'global_declaration' then\n                    local g = {}\n                    for _, v in tsutil.inext, c, -1 do php_var(v, src, g) end\n                    for nm in pairs(g) do glob[nm] = true end\n                end\n                walk(c)\n            end\n        end\n    end\n    local body = node:field('body')[1]\n    if body then walk(body) end\n    for g in pairs(glob) do out[g] = nil end\nend"},"touched":["lua/cartograph/spec/php.lua"]},"id":"1791527884.984471-edit","decisions":[],"verb":"edit"},{"bytes":109,"decided_by":"tactic","invocation":{"verb":"edit","args":{"before":"-- binds its params and every variable its body assigns ANYWHERE (function-wide: php has no block scope, and a use\n-- before the assignment is still the local) — `$x = …`, `[$a, $b] = …`, `$x .= …`, foreach / catch / static\n-- variables —, minus its `g