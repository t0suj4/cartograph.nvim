ebra/core.lua","before":"local function vsym(t)\n    if t.k == 'lit' then return 'lit:' .. tostring(t.v) end\n    if t.k == 'name' then return 'name:' .. t.n end\n    if t.k == 'hole' then return '?' .. t.h end\n    return t.k\nend"}}},{"id":"1791040699.737440-edit","verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/algebra/core.lua"],"args":{"after":"    -- (a PRESENCE MARK is identity on every kind — a keyed set's optional member is not its always-present twin; it was\n    -- ignored on a literal and a name, an early return older than marks on set members: CART-1397)\n    if a.k == 'lit' then return a.v == b.v and (a.opt or false) == (b.opt or false) end\n    if a.k == 'name' then return a.n == b.n and (a.opt or false) == (b.opt or false) end","file":"lua/cartograph/algebra/core.lua","before":"    if a.k == 'lit' then return a.v == b.v end\n    if a.k == 'name' then return a.n == b.n end"}}},{"id":"1791040699.920283-edit","verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/algebra/core.lua"],"args":{"after":"    if (a.opt or false) ~= (b.opt or false) then return false end\n    if a.g ~= b.g then return false end -- (an embed's GRAMMAR: one tree parsed as SQL is not the same tree parsed as Lua)\n    local ka, kb = a.kids or {}, b.kids or {}","file":"lua/cartograph/algebra/core.lua","before":"    if (a.opt or false) ~= (b.opt or false) then return false end\n    local ka, kb = a.kids or {}, b.kids or {}"}}},{"id":"1791040699.987156-edit","verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/algebra/termgraph.lua"],"args":{"after":"-- ⚠ NOT tg_of_term's show()-keyed sharing (quadratic). The label is core's M.node_label — ONE label for content ids,\n-- the wire's records, term graphs and the edit-distance match (CART-1396); numbers in M.content_num's canonical text.\nlocal num, label = M.content_num, M.node_label","file":"lua/cartograph/algebra/termgraph.lua","before":"-- ⚠ NOT tg_of_term: its sharing keys on show() p