for a person (term graphs' tg_show, edit\n--- distance's alignments, vertical's skeletons): a plain node is its kind (`f`), a literal typed (`lit:\"1\"` is a string,\n--- `lit:1` a number in canonical text), a name `name:x`, a hole `?h` (`...` hedge, `()` context); alignment, merge key,\n--- presence mark and grammar ride only when present. Two nodes have one symbol iff they have one label.\nfunction M.node_sym(t)\n    local s\n    if t.k == 'lit' then\n        local v = t.v\n        s = 'lit:' .. (type(v) == 'string' and ('%q'):format(v) or type(v) == 'number' and content_num(v) or tostring(v))\n    elseif t.k == 'name' then s = 'name:' .. t.n\n    elseif t.k == 'hole' then s = '?' .. t.h .. (t.rep and '...' or '') .. (t.ctx and '()' or '')\n    else s = t.k end\n    if t.k ~= 'lit' and t.k ~= 'name' then\n        if t.align then s = s .. '[' .. t.align .. (t.key and (' key=' .. M.key_spec(t)) or '') .. ']' end\n        if t.g then s = s .. '@' .. t.g end\n    end\n    if t.opt then s = s .. '?' .. t.opt end\n    return s\nend\nlocal function vsym(t) return M.node_sym(t) end","file":"lua/cartograph/algebra/core.lua","before":"local function vsym(t) return M.node_label(t) end"}}},{"id":"1791040796.319179-edit","verb":"edit","invocation":{"verb":"edit","touched":["tests/termwire_spec.lua"],"args":{"after":"    -- two literals with different marks are two NODES since a mark is identity on every kind (CART-1397: it was ignored\n    -- on a literal, and they shared one record with the mark per occurrence)\n    local t = A.node('f', { k = 'lit', v = 'b', opt = 'h1' }, { k = 'lit', v = 'b', opt = 'h2' })\n    local back, w = rt(t)\n    eq(t, back)\n    ok(w.nodes[w.root].kids[1] ~= w.nodes[w.root].kids[2], 'two marks, two records')\n    ok(not A.eq(t.kids[1], t.kids[2]), 'and eq tells them apart')","file":"tests/termwire_spec.lua","before":"    -- two occurrences of ONE literal with different marks: one record, each keeps its own\n    local t = A.node('f', { k = 'lit', v 