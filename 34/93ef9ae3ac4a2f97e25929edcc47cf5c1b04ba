91582092.923612-edit","invocation":{"touched":["lua/cartograph/spec/lua.lua"],"args":{"file":"lua/cartograph/spec/lua.lua","after":"-- ★ A PARAMETER IS WHAT EVERY CALLER PASSES (CART-1620) — when the caller set is CLOSED: a `local function f` /\n-- `local f = function` whose every mention in its scope is a direct call `f(…)` (never a value handed on), at least\n-- one. Then param i satisfies `pred` when every call's argument i does (a missing argument is nil: no). The scope is\n-- the declaring block, read whole: a shadowing `f` there only adds conditions. -> true | false\nlocal function param_from_callers(fn, i, src, depth, seen, pred, tag)\n    local name, decl\n    if fn:type() == 'function_declaration' then\n        if not node_text(fn, src):match('^local%s') then return false end\n        local nm = fn:field('name')[1]\n        name, decl = nm and nm:type() == 'identifier' and node_text(nm, src), fn\n    else -- `local f = function (…)`: function_definition <- expression_list <- assignment_statement <- variable_declaration\n        local el = fn:parent()\n        local as = el and el:type() == 'expression_list' and el:parent()\n        local vd = as and as:type() == 'assignment_statement' and as:parent()\n        if not (vd and vd:type() == 'variable_declaration' and el:named_child_count() == 1) then return false end\n        local vl = as:named_child(0)\n        local v = vl and vl:named_child_count() == 1 and vl:named_child(0)\n        name, decl = v and v:type() == 'identifier' and node_text(v, src), vd\n    end\n    local scope = name and decl:parent()\n    if not scope then return false end\n    local key = tag .. ':cs:' .. fn:id() .. ':' .. i\n    if seen[key] ~= nil then return seen[key] end\n    seen[key] = false -- (a recursive call decides nothing: the other callers do)\n    local calls, ok = 0, true\n    local function scan(x)\n        if not ok then return end\n        if x:type() == 'identifier' and node_text(x, src) == name then\n            local par = x:parent()\n            if par and par:type() == 'function_call' and par:field('name')[1] and par:field('name')[1]:id() == x:id() then\n                calls = calls + 1\n                local args = par:field('arguments')[1]\n                local a, k = nil, 0\n                for _, y in tsutil.inext, args or x, -1 do\n                    if args and y:named() then k = k + 1; if k == i then a = y end end\n                end\n                if not (a and pred(a, src, depth + 1, seen)) then ok = false end\n            elseif not (decl:type() == 'function_declaration' and par and par:id() == decl:id())\n                and not (par and par:type() == 'variable_list') then\n                ok = false -- (handed on as a value, or anything else: the caller set is open)\n            end\n            return\n        end\n        for _, y in tsutil.inext, x, -1 do scan(y) end\n    end\n    scan(scope)\n    seen[key] = ok and calls > 0\n    return seen[key]\nend\nlocal function local_all(id, src, depth, seen, pred, tag)","before":"local function local_all(id, src, depth, seen, pred, tag)"},"verb":"edit"},"verb":"edit","bytes":48},{"decided_by":"tactic","decisions":[],"id":"1791586738.612353-edit","invocation":{"touched":["lua/cartograph/effects.lua"],"args":{"after":"                        local bname = declname or callrec.full(c) or callrec.callee(c)\n                        -- (a receiver the resolver TYPED — by member evidence or by its one definition's declared\n                        -- return, CART-1570 / CART-1621 — is its type's: `fd:close()` on a file is file.close)\n                        local cext = c.ext\n                        if not declname and type(cext) == 'table' and cext.type\n                            and (cext.why == 'typed-receiver' or cext.why == 'typed-binding') and callrec.callee(c) then\n                            bname = cext.type .. '.' .. callrec.callee(c)\n                        end\n                        local sig, grade","