aph/tactics/refresh-parity.lua"]},"id":"1791179990.692822-edit"},{"verb":"edit","invocation":{"verb":"edit","args":{"before":"test('treesitter: a lua `local` module var is never the cross-file target of a free name in another file (CART-1473)', function ()","file":"tests/treesitter_spec.lua","after":"test('treesitter: dedupe_reg REPORTS the file of every copy it drops — the cache save rewrites only reported files (CART-1439)', function ()\n    local at = function (l) return { start = { line = l, char = 0 }, ['end'] = { line = l, char = 1 } } end\n    local edges = {\n        { kind = 'reg', from = 'a.py', to = 'u.py::f@5', at = { at(3) } },\n        { kind = 'reg', from = 'a.py', to = 'u.py::f@5', at = { at(3) } },\n        { kind = 'reg', from = 'b.py::g@1', to = 'u.py::f@5', at = { at(9) } },\n        { kind = 'ref', from = 'c.py::h@2', to = 'u.py::f@5', at = { at(4) } },\n    }\n    local touched = {}\n    eq(1, ts.dedupe_reg(edges, touched))\n    eq(3, #edges)\n    eq(true, touched['a.py'], 'the file whose copy was dropped is reported')\n    eq(nil, touched['b.py'], 'a file with nothing dropped is not')\nend)\n\ntest('treesitter: a lua `local` module var is never the cross-file target of a free name in another file (CART-1473)', function ()"},"touched":["tests/treesitter_spec.lua"]},"id":"1791180047.756307-edit"},{"verb":"edit","invocation":{"verb":"edit","args":{"before":"-- graph equals the full refresh's after every step; the 88 cutoff saves 1.28 -> 0.99 s. Default off until the oracle\n-- has run on other languages' histories (a population-dependent pass is the risk: `self` was one). setup{\n-- incremental_refresh = true } or env CARTOGRAPH_INCREMENTAL=1.\nM.incremental_refresh = vim.env.CARTOGRAPH_INCREMENTAL == '1'","after":"-- graph equals the full refresh's after every step; the 88 cutoff saves 1.28 -> 0.99 s. ON BY DEFAULT since the oracle\n-- ran on four more languages' histories (2026-10-05): java spring-petclinic 144 edits, go hugo 34, python django-oscar\n-- 64, typescript typescript-language-server 124 — equal at every step, every changed file reported dirty. Off:\n-- setup{ incremental_refresh = false } or env CARTOGRAPH_INCREMENTAL=0.\nM.incremental_refresh = vim.env.CARTOGRAPH_INCREMENTAL ~= '0'","file":"lua/cartograph/config.lua"},"touched":["lua/cartograph/config.lua"]},"id":"1791180112.260660-edit"},{"verb":"edit","invocation":{"verb":"edit","args":{"before":"| Is an INCREMENTAL refresh the same graph as the full one — over REAL edits? (the oracle for any early cutoff) | `toolbelt.lua run refresh-parity - world=<scratch clone> [sub=lua] [history=N] [steps=k] [dump=<dir>]` — the world's last N commits under `sub`, each changed Lua file set to its content at that commit (oldest first), replayed on the world (a clean git checkout: written and restored) and refreshed FULL and INCREMENTAL in two processes; after every step a digest (nodes + cbarg, edges, call resolutions incl. refusals) compared, each edit's INTERFACE class (unchanged / added / removed / both) and both paths' seconds; `dump` keeps every step's digest lines to diff. THE CUTOFF IT ACCEPTS (`refresh.files(rels, { incremental = true })`, setup{ incremental_refresh = true } or CARTOGRAPH_INCREMENTAL=1 for saves): when every refreshed file keeps its interface, relink re-resolves only the touched files' calls + every unresolved call elsewhere whose name a refreshed file defines (a refusal lists ids, ids carry lines); the cbarg pre-scan, module ownership and population-reading passes (`self`) stay whole-graph. MEASURED on our tree, 20 commits = 122 edits (94 interface-unchanged): equal at every step; the 88 cutoff saves 1.28 -> 0.99 s. It found three differences on the way (module ownership lagging the id pass — CART-1474; refusal ids; the self-type map's population). CART-1439 |","file":".claude/skills/cartograph/references/questions.md","after":"| Is an INCREMENTAL refresh the same graph as the full one — over REAL edits? (the oracle for any early cutoff) | `toolbelt.lua run refresh-parity - world=<scratch clone> [sub=lua] [history=N] [steps=k] [dump=<dir>]` — the world's last N commits under `sub`, each changed Lua file set to its content at that commit (oldest first), replayed on the world (a clean git checkout: written and restored) and refreshed FULL and INCREMENTAL in two processes; after every step a digest (nodes + cbarg, edges, call resolutions incl. refusals) compared, each edit's INTERFACE class (unchanged / added / removed / both) and both paths' seconds; `dump` keeps every step's digest lines to diff. THE CUTOFF IT ACCEPTS (`refresh.files(rels, { incremental = true })`; saves use it BY DEFAULT — off: setup{ incremental_refresh = false } or CARTOGRAPH_INCREMENTAL=0): when every refreshed file keeps its interface, relink re-resolves only the touched files' calls + every unresolved call elsewhere whose name a refreshed file defines (a refusal lists ids, ids carry lines); the cbarg pre-scan, module ownership and population-reading passes (`self`) stay whole-graph. MEASURED on our tree, 20 commits = 122 edits (94 interface-unchanged): equal at every step; the 88 cutoff saves 1.28 -> 0.99 s. Then on four more languages, each a scratch clone's history (`sub=.` = the repo itself; any file the extractor reads): java spring-petclinic 144 edits, go hugo 34 (40.7 -> 28.5 s), python django-oscar 64, typescript typescript-language-server 124 — all equal, nothing undirty (a dropped reg-edge copy was the last unreported change: dedupe_reg now reports its file; only files WITH a shard are checked, minted externals ride the manifest). It found three differences on the way (module ownership lagging the id pass — CART-1474; refusal ids; the self-type map's population). CART-1439 |"},"touched":[".claude/skills/cartograph/references/questions.md"]},"id":"1791180148.325598-edit"}],"commit":"cec248d76f3687a3b9760500b732f589c740ed91","entries":[{"verb":"edit","invocation":{"verb":"edit","args":{"before":"        for _, p