\n    eq({ id('out:\\n  return -1;') }, to(id('goto out;')))\n    eq({ 'exit' }, to(id('return a;')))\n    eq({ id('i < a') }, to(id('i < a'), 'T') == nil and {} or { g.nodes[to(id('i < a'), 'T')[1]] and id('i < a') })\n    ok(g.rpo[g.entry] == 1 and g.rpo[id('i < a')] < g.rpo[id('i == 2')], 'reverse postorder: a condition before its body')\nend)\n"}},"decisions":[],"verb":"edit","id":"1790786730.919494-edit"},{"bytes":28,"decided_by":"tactic","invocation":{"touched":["tests/cfg_spec.lua"],"verb":"edit","args":{"file":"tests/cfg_spec.lua","before":"        '  while (a) a--;',\n","after":"        '  while (i) i--;',\n"}},"decisions":[],"verb":"edit","id":"1790786745.504085-edit"},{"bytes":88,"decided_by":"tactic","invocation":{"touched":["tests/cfg_spec.lua"],"verb":"edit","args":{"file":"tests/cfg_spec.lua","before":"    eq({ 'a', 'i < a' }, heads, 'the targets of back edges: the two loop conditions')\n","after":"    eq({ '(i)', 'i < a' }, heads, 'the targets of back edges: the two loop conditions')\n"}},"decisions":[],"verb":"edit","id":"1790786745.554019-edit"},{"bytes":125,"decided_by":"tactic","invocation":{"touched":["tests/cfg_spec.lua"],"verb":"edit","args":{"file":"tests/cfg_spec.lua","before":"    eq({ id('i < a') }, to(id('i < a'), 'T') == nil and {} or { g.nodes[to(id('i < a'), 'T')[1]] and id('i < a') })\n    ok(g.rpo[g.entry] == 1 and g.rpo[id('i < a')] < g.rpo[id('i == 2')], 'reverse postorder: a condition before its body')\n","after":"    eq({ { id('(i == 2)') }, { 'exit' } }, { to(id('i < a'), 'T'), to(id('(i)'), 'F') == nil and {} or { to(id('(i)'), 'F')[1] == id('return a;') and 'exit' } })\n    ok(g.rpo[g.entry] == 1 and g.rpo[id('i < a')] < g.rpo[id('(i == 2)')], 'reverse postorder: a condition before its body')\n"}},"decisions":[],"verb":"edit","id":"1790786745.603485-edit"},{"bytes":97,"decided_by":"tactic","invocation":{"touched":["tests/cfg_spec.lua"],"verb":"edit","args":{"file":"tests/cfg_spec.lua","before":"    eq({ { id('(i == 2)') }, { '