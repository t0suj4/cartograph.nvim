{"open_intents":[],"commit":"93e20367012e71af9b4c301a819cbc9a5fa7fe9e","explained":6668,"version":1,"entries":[{"id":"1791989568.874172-edit","bytes":1691,"decided_by":"tactic","verb":"edit","decisions":[],"invocation":{"verb":"edit","args":{"before":"-- ═══ FLOWPATH INTERIM RULE (CART-1684 step 0, research copy — NOT the shipped narrow) ═══════════════════════════════\n-- NI_MODE=I turns it on; NI_UB=1 adds the USE bound (an entry entirely after the use point, outside every loop around\n-- it, cannot run between guard and use); NI_META=1 counts every index expression off the guarded chain as a call\n-- (__index / __newindex); NI_ARR=1 lets table.insert / table.remove / a comparator-less table.sort through (they write\n-- integer slots with raw sets in 5.1 / LuaJIT, and a fact's path is a chain of NAMES).\nlocal NI = { on = os.getenv('NI_MODE') == 'I', ub = os.getenv('NI_UB') == '1', meta = os.getenv('NI_META') == '1',\n    arr = os.getenv('NI_ARR') == '1', numkey = os.getenv('NI_NUMKEY') == '1', fmod = os.getenv('NI_FMOD') == '1',\n    fresh = os.getenv('NI_FRESH') == '1' }\n","after":"-- ★★ THE INTERIM STALING RULE (CART-1684; designed and costed by the flowpath research, ~/work/flowpath\n-- RESEARCH.md §0 / §15.4, as its variant I4). Staling by NAME — a write naming a prefix of A.x, a call RECEIVING A —\n-- kept false facts whenever a write reached the guarded table through another name: a zero-argument mutator of an\n-- upvalue, a param alias, another argument's field (its metamorphic harness, execution as the oracle: 57 violations in\n-- 87 cases). Under this rule EVERY call is a suspect unless provably harmless (a plain-`pure` summary that reaches no\n-- write through a name that is neither its param nor a fresh local, or a builtin whose contract writes, calls and does\n-- nothing), every field write stales the facts naming that field, and a depth-0 fact on a name the function does not\n-- bind is exposed like a field path. Refinements, each sound: the USE bound (an entry entirely after the use point,\n-- outside every loop around it, cannot run between guard and use), array-only builtins (table.insert / remove / a\n-- comparator-less sort write integer slots), provably NUMERIC keys, and writes into a table built fresh after the guard.\n-- Harness: 57 -> 8 violations, all __index / __newindex (counting every off-chain index as a call — `meta`, I4M — closes\n-- them at a cost the research left as a decision). The sound end state is R4 (MOD on the points-to graph).\n-- CARTOGRAPH_NARROW_INTERIM=0 restores name-based staling (an A/B switch only).\nlocal NI_ON = os.getenv('CARTOGRAPH_NARROW_INTERIM') ~= '0'\nlocal NI = { on = NI_ON, ub = NI_ON, meta = os.getenv('CARTOGRAPH_NARROW_META') == '1', arr = NI_ON, numkey = NI_ON,\n    fresh = NI_ON }\n","file":"lua/cartograph/narrow.lua"},"touched":["lua/cartograph/narrow.lua"]}},{"id":"1791989585.517822-edit","bytes":119,"decided_by":"tactic","verb":"edit","decisions":[],"invocation":{"verb":"edit","args":{"before":"                local ok, cat, fields = iharm(n)\n                if not ok and fields then imark({ ifields = fields, cat = cat .. '/fmod', call = n }, n)\n                elseif not ok then imark({ iall = true, cat = cat, call = n }, n)\n","after":"                local ok, cat = iharm(n)\n                if not ok then imark({ iall = true, cat = cat, call = n }, n)\n","file":"lua/cartograph/narrow.lua"},"touched":["lua/cartograph/narrow.lua"]}},{"id":"1791989585.637409-edit","bytes":61,"decided_by":"tactic","verb":"edit","decisions":[],"invocation":{"verb":"edit","args":{"before":"        if memo[id] then return memo[id][1], memo[id][2], memo[id][3] end\n","after":"        if memo[id] then return memo[id][1], memo[id][2] end\n","file":"lua/cartograph/narrow.lua"},"touched":["lua/cartograph/narrow.lua"]}},{"id":"1791990487.447191-edit","bytes":2507,"decided_by":"tactic","verb":"edit","decisions":[],"invocation":{"verb":"edit","args":{"before":"| Does a CALL invalidate