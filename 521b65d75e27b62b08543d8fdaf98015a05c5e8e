nd\n        local c, vals = Rules.match(p)\n        if not c then return nil end\n        local order = {}\n        for h, v in pairs(vals) do\n            local node = pnode[v]\n            if not node then error(('luajs rule `%s`: hole %s bound a term with no node'):format(c.lua, h), 0) end\n            order[#order + 1] = { h = h, node = node, at = select(3, node:start()) }\n        end\n        table.sort(order, function (x, y) return x.at < y.at end)\n        local js = {}\n        for _, o in ipairs(order) do\n            local mode = c.as[o.h] or 'expr'\n            if mode == 'name' then js[o.h] = js_str(text(o.node))\n            elseif mode == 'block' then js[o.h] = block(o.node, scope(sc), ctx)\n            else js[o.h] = expr(o.node, sc, mode == 'raw') end\n        end\n        return Rules.render(c, js)\n    end\n","file":"lua/cartograph/luajs.lua"},"verb":"edit","touched":["lua/cartograph/luajs.lua"]},"decided_by":"tactic","bytes":1118},{"id":"1790694955.015932-edit","verb":"edit","decisions":[],"invocation":{"args":{"before":"        stats.nodes = stats.nodes + 1\n        local t = n:type()\n        if t == 'identifier' then","after":"        stats.nodes = stats.nodes + 1\n        local r = by_rule(n, sc)\n        if r then return r end\n        local t = n:type()\n        if t == 'identifier' then","file":"lua/cartograph/luajs.lua"},"verb":"edit","touched":["lua/cartograph/luajs.lua"]},"decided_by":"tactic","bytes":64},{"id":"1790694955.083398-edit","verb":"edit","decisions":[],"invocation":{"args":{"file":"lua/cartograph/luajs.lua","after":"        elseif t == 'function_definition' then return fn_js(n, sc, nil)\n        elseif t == 'function_call' then return call_js(n, sc, raw)\n        elseif t == 'table_constructor' then return table_js(n, sc)\n        -- an operator no declared rule covers (5.3's `//`, `&`, …)\n        elseif t == 'binary_expression' then\n            return refuse(n, 'operator', 'no template for the binary operator ' .. text(field_of(n, 'operator')))\n        elseif t == 'unary_expression' then\n            return refuse(n, 'operator', 'no template for the unary operator ' .. text(field_of(n, 'operator')))\n        end","before":"        elseif t == 'nil' then return 'undefined'\n        elseif t == 'true' then return 'true'\n        elseif t == 'false' then return 'false'\n        elseif t == 'vararg_expression' then return '$va[0]'\n        elseif t == 'function_definition' then return fn_js(n, sc, nil)\n        elseif t == 'parenthesized_expression' then\n            local inner = named_kids(n)[1]\n            return '(' .. expr(inner, sc) .. ')'\n        elseif t == 'dot_index_expression' then\n            return ('$idx(%s, %s)'):format(expr(field_of(n, 'table'), sc), js_str(text(field_of(n, 'field'))))\n        elseif t == 'bracket_index_expression' then\n            return ('$idx(%s, %s)'):format(expr(field_of(n, 'table'), sc), expr(field_of(n, 'field'), sc))\n        elseif t == 'function_call' then return call_js(n, sc, raw)\n        elseif t == 'table_constructor' then return table_js(n, sc)\n        elseif t == 'binary_expression' then\n            local op = text(field_of(n, 'operator'))\n            local l, r = field_of(n, 'left'), field_of(n, 'right')\n            if op == 'and' then return ('$and(%s, () => %s)'):format(expr(l, sc), expr(r, sc)) end\n            if op == 'or' then return ('$or(%s, () => %s)'):format(expr(l, sc), expr(r, sc)) end\n            -- equality honours __eq (5.1: both operands tables sharing one __eq); $eq's first test is ===\n            if op == '==' then return ('$eq(%s, %s)'):format(expr(l, sc), expr(r, sc)) end\n            if op == '~=' then return ('!$eq(%s, %s)'):format(expr(l, sc), expr(r, sc)) end\n            local f = BIN[op]\n            if not f then return refuse(n, 'operator', 'no template for the binary operator ' .. op) end\n            return ('%s(%s, %s)'):format(f, expr(l, sc), expr(r, sc))\n        elseif t == 'unary_expression' then\n            local op = text(field_of(n, 'operator'))\n            local e = field_of(n, 'operand')\n            if op == 'not' then return ('!$t(%s)'):format(expr(e, sc)) end\n            if op == '-' then return ('$neg(%s)'):format(expr(e, sc)) end\n            if op == '#' then return ('$len(%s)'):format(expr(e, sc)) end\n            return refuse(n, 'operator', 'no template for the unary operator ' .. op)\n        end"},"verb":"edit","touched":["lua/cartograph/luajs.lua"]},"decided_by":"tactic","bytes":297},{"id":"1790694955.148633-edit","verb":"edit","decisions":[],"invocation":{"args":{"file":"lua/cartograph/luajs.lua","after":"        if t == 'comment' or t == 'empty_statement' then return '' end\n        local r = by_rule(n, sc, ctx)\n        if r then return r end\n        if t == 'variable_declaration' then","before":"        if t == 'comment' or t == 'empty_statement' then return '' end\n        if t == 'variable_declaration' then"},"verb":"edit","touched":["lua/cartograph/luajs.lua"]},"decided_by":"tactic","bytes":69},{"id":"1790694955.212839-edit","verb":"edit","decisions":[],"invocation":{"args":{"before":"        elseif t == 'return_statement' then\n            local el = named_kids(n)[1]\n            local vals = el and named_kids(el) or {}\n            if #vals == 0 then return 'return;' end\n            if #vals == 1 then return ('return %s;'):format(expr(vals[1], sc, true)) end\n            return ('return $mv(%s);'):format(explist_js(vals, sc))","after":"        elseif t == 'return_statement' then\n            -- no value and one value are declared rules; a LIST is a value-position case\n            local el = named_kids(n)[1]\n            return ('return $mv(%s);'):format(explist_js(el and named_kids(el) or {}, sc))","file":"lua/cartograph/luajs.lua"},"verb":"edit","touched":["lua/cartograph/luajs.lua"]},"decided_by":"tactic","bytes":181},{"id":"1790694955.360673-edit","verb":"edit","decisions":[],"invocation":{"args":{"file":"lua/cartograph/luajs.lua","after":"    -- a source the lossless reader refuses (an error or MISSING node) has no terms to match: the chunk refuses by name\n    local body = unread and (refuse(root, 'read', tostring(unread)) .. ';\\n') or block(root, top, nil)","before":"    local body = block(root, top, nil)"},"verb":"edit","touched":["lua/cartograph/luajs.lua"]},"decided_by":"tactic","bytes":223},{"id":"1790695200.688366-edit","verb":"edit","decisions":[],"invocation":{"args":{"before":"    -- the left side: ONE expression (read as `return <lua>`), else a one-statement chunk. The expression reading goes\n    -- first: `#a` read as a chunk is a shebang line, not a length\n    local lhs\n    local ret = R.read('return ' .. rule.lua, 'lua')\n    local rs = ret and project(ret).kids[1]\n    local el = rs and rs.kids and rs.kids[2]\n    if el and el.k == 'expression_list' and #el.kids == 1 and #rs.kids == 2 then lhs = el.kids[1] end\n    if not lhs then\n        local chunk = R.read(rule.lua, 'lua')\n        local stmts = chunk and project(chunk).kids or {}\n        if #stmts ~= 1 then bad('the Lua side reads neither as ONE expression nor as ONE statement') end\n        lhs = stmts[1]\n    end","after":"    -- the left side: ONE statement (read INSIDE `do … end`), else ONE expression (read as `return <lua>`). Both\n    -- wrappers are measured choices: at a chunk's start `#a` reads as a shebang line, and tree-sitter-lua reads\n    -- `return return` CLEANLY, the second `return` an identifier — so the expression reading cannot go first\n    local lhs\n    local chunk = R.read('do ' .. rule.lua .. ' end', 'lua')\n    local ds = chunk and project(chunk).kids[1]\n    local body = ds and ds.k == 'do_statement' and ds.kids[2]\n    if body and body.k == 'block' and #body.kids == 1 and #ds.kids == 3 then lhs = body.kids[1] end\n    if not lhs then\n        local ret = R.read('return ' .. rule.lua, 'lua')\n        local rs = ret and project(ret).kids[1]\n        local el = rs and rs.kids a