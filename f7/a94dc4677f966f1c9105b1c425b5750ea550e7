{"entries":[{"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"touched":["lua/cartograph/provenance.lua"],"args":{"before":"--- read the ledger note of `sha` -> row | nil (no note)\nfunction M.read_note(repo, sha)\n    local txt = git(repo, { 'notes', '--ref', M.NOTES_REF, 'show', sha })","file":"lua/cartograph/provenance.lua","after":"--- read the ledger note of `sha` -> row | nil (no note). `ref` = another notes ref (a teammate's, fetched into\n--- cartograph.replay's mirror); default this repo's own\nfunction M.read_note(repo, sha, ref)\n    local txt = git(repo, { 'notes', '--ref', ref or M.NOTES_REF, 'show', sha })"},"verb":"edit"},"id":"1790633954.971403-edit","bytes":287},{"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"touched":["lua/cartograph/replay.lua"],"args":{"before":"--- the invocations the ledger notes of `range` (in `repo`) carry, in replay order -> { { commit, id, invocation } }\nfunction M.from_notes(repo, range)","file":"lua/cartograph/replay.lua","after":"-- ── TRANSPORT (CART-1191 leaf 4): a GIT store ─────────────────────────────────────────────────────────────────────\n-- A teammate's work travels as their branch AND their ledger notes, both pushed to a shared remote. `fetch` brings both\n-- here: the branches as usual (refs/remotes/<remote>/…), the notes into a MIRROR ref of their own —\n-- refs/notes/cartograph-remotes/<remote> — force-updated to theirs and NEVER merged into this repo's notes (this repo's\n-- ledger records what happened HERE; theirs is evidence of what they asked, read only to replay it).\n-- The store's capabilities, as CART-1183 derives them for a git remote: read by key (a note per commit), conditional\n-- write (a push is refused when the remote moved — the CAS), and no change feed (fetch is a POLL).\nM.MIRROR = 'refs/notes/cartograph-remotes/'\n\n--- fetch `remote`'s branches and its ledger notes into the mirror -> the mirror ref | nil, why\nfunction M.fetch(repo, remote)\n    if type(remote) ~= 'string' or not remote:match('^[%w._-]+$') then return nil, 'a remote NAME (as `git remote` lists it)' end\n    local ref = M.MIRROR .. remote\n    local ok = git(repo, { 'fetch', '-q', remote })\n    if not ok then return nil, ('git fetch %s failed'):format(remote) end\n    -- a remote with no notes yet is not an error: nothing to replay from it\n    git(repo, { 'fetch', '-q', remote, '+' .. require('cartograph.provenance').NOTES_REF .. ':' .. ref })\n    return ref\nend\n\n--- the invocations the ledger notes of `range` (in `repo`; `ref` = a notes ref, default this repo's) carry, in replay\n--- order -> { { commit, id, invocation } }\nfunction M.from_notes(repo, range, ref)"},"verb":"edit"},"id":"1790633970.773056-edit","bytes":1800},{"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"touched":["lua/cartograph/replay.lua"],"args":{"before":"        local row = P.read_note(repo, sha)","file":"lua/cartograph/replay.lua","after":"        local row = P.read_note(repo, sha, ref)"},"verb":"edit"},"id":"1790633970.821751-edit","bytes":48},{"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"touched":["tools/replay.lua"],"args":{"before":"--   nvim --headless -u NONE -l tools/replay.lua <into dir> <from repo> <range> [apply=1] [approvals=<dir>]\n--   e.g. tools/replay.lua . ../their-checkout main..their-branch            preview, step by step\n","after":"--   nvim --headless -u NONE -l tools/replay.lua <into dir> <from repo> <range> [apply=1] [approvals=<dir>]\n--   nvim --headless -u NONE -l tools/replay.lua <into dir> --remote <name> <range> [apply=1] [approvals=<dir>]\n--   e.g. tools/replay.lua . ../their-checkout main..their-branch            preview, step by step\n--        tools/replay.lua . --remote origin HEAD..origin/their-branch    fetch their branch + notes, then replay\n-- `--remote`: a teammate PUSHED their branch and their ledger notes (refs/notes/cartograph) to a shared remote; the\n-- notes are fetched into a mirror (refs/notes/cartograph-remotes/<name>), never merged into this repo's own.\n","file":"tools/replay.lua"},"verb":"edit"},"id":"1790633989.799028-edit","bytes":453},{"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"touched":["tools/replay.lua"],"args":{"before":"local items = R.from_notes(vim.fn.fnamemodify(from, ':p'), range)","after":"local items\nif from == '--remote' then\n    -- the range follows the remote's name: <into> --remote <name> <range>\n    local remote\n    remote, range = arg[3], arg[4]\n    if not (remote and range) then io.stderr:write('usage: replay.lua <into dir> --remote <name> <range>\\n'); os.exit(2) end\n    local ref, why = R.fetch(into, remote)\n    if not ref then io.write('refused: ', tostring(why), '\\n'); os.exit(1) end\n    items = R.from_notes(into, range, ref)\nelse\n    items = R.from_notes(vim.fn.fnamemodify(from, ':p'), range)\nend","file":"tools/replay.lua"},"verb":"edit"},"id":"1790633989.841309-edit","bytes":529},{"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"touched":["tools/replay.lua"],"args":{"before":"for i = 4, #arg do","file":"tools/replay.lua","after":"-- the options follow the range: arg 4 on, or arg 5 on in the `--remote <name> <range>` form\nfor i = from == '--remote' and 5 or 4, #arg do"},"verb":"edit"},"id":"1790633999.146765-edit","bytes":140},{"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"touched":["tests/replay_spec.lua"],"args":{"before":"test('replay: a step whose files are UNKNOWN never runs past a stop","after":"test('replay over a SHARED REMOTE: A pushes its branch and notes; B fetches them into a MIRROR and replays — B\\'s own notes untouched, no git merge', function ()\n    if not ready() then skip 'no lua parser / git' end\n    local hub = vim.fn.tempname()\n    vim.system({ 'git', 'init', '-q', '--bare', hub }):wait()\n    local a = vim.fn.tempname()\n    vim.fn.mkdir(a, 'p')\n    local fd = assert(io.open(a .. '/m.lua', 'w')); fd:write('local M = {}\\nreturn M\\n'); fd:close()\n    sh(a, 'init', '-q'); ident(a); sh(a, 'add', '.'); sh(a, 'commit', '-qm', 'base')\n    sh(a, 'remote', 'add', 'origin', hub)\n    local branch = vim.trim(sh(a, 'rev-parse', '--abbrev-ref', 'HEAD').stdout)\n    sh(a, 'push', '-q', 'origin', branch)\n    local b = vim.fn.tempname()\n    vim.system({ 'git', 'clone', '-q', hub, b }):wait(); ident(b)\n    local b_head = vim.trim(sh(b, 'rev-parse', 'HEAD').stdout)\n    work(a, { { file = 'm.lua', before = 'return M\\n', after = 'M.shared = 1\\nreturn M\\n' } })\n    sh(a, 'push', '-q', 'origin', branch, 'refs/notes/cartograph')\n    local r = vim.system({ 'nvim', '--headless', '-u', 'NONE', '-l', vim.fn.getcwd() .. '/tools/replay.lua', b, '--remote', 'origin',\n        'HEAD..origin/' .. branch, 'apply=1' }, { text = true }):wait(120000)\n    local text = (r.stdout or '') .. (r.stderr or '')\n    eq(0, r.code, text); ok(text:find('1 applied', 1, true), text)\n    eq('local M = {}\\nM.shared = 1\\nreturn M\\n', read(b, 'm.lua'), 'A\\'s intent, replayed in B\\'s working tree')\n    eq(b_head, vim.trim(sh(b, 'rev-parse', 'HEAD').stdout), 'no merge: B\\'s history did not move')\n    ok(sh(b, 'rev-parse', '-q', '--verify', 'refs/notes/cartograph-remotes/origin').code == 0, 'the mirror holds A\\'s notes')\n    ok(sh(b, 'rev-parse', '-q', '--verify', 'refs/notes/cartograph').code ~= 0, 'B\\'s OWN notes were never written by the fetch')\nend)\n\ntest('replay: a step whose files are UNKNOWN never runs past a stop","file":"tests/replay_spec.lua"},"verb":"edit"},"id":"1790634019.769808-edit","bytes":1851},{"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"touched":[".claude/skills/cartograph/references/questions.md"],"args":{"before":"`nvim --headless -u NONE -l tools/replay.lua <into dir> <from repo> <range> [apply=1] [approvals=<dir>]` —","file":".claude/skills/cartograph/references/questions.md","after":"`nvim --headless -u NONE -l tools/replay.lua <into dir> <from repo> <rang