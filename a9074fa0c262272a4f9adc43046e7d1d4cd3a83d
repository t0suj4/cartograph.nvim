2680-edit","decisions":[],"verb":"edit"},{"invocation":{"args":{"before":"else\n    -- libmpow: the pow() LuaJIT calls","after":"elseif recipe == 'strscan' then\n    -- strscan: LuaJIT's string -> number scanner (lj_strscan.c), under tonumber(s) and every string->number arithmetic\n    -- coercion. <src> is a BUILT LuaJIT src dir at the ORACLE's revision (tools/packmap.lua leaves one under\n    -- ~/.cache/nvim/cartograph/packmap/<rev>/src: git archive + LuaJIT's make for its generated headers).\n    -- The compile flags are the BUILD's own (its make, asked for one object's command line).\n    local cflags = {}\n    for line in (vim.system({ 'make', '-n', 'lj_err.o' }, { cwd = src, text = true }):wait().stdout or ''):gmatch('[^\\n]+') do\n        if line:match('%-c %-o lj_err%.o lj_err%.c') then\n            for flag in line:gmatch('%S+') do if flag:match('^%-[DU]') then cflags[#cflags + 1] = flag end end\n        end\n    end\n    local tmp = vim.fn.tempname()\n    vim.fn.mkdir(tmp, 'p')\n    -- THE ROOT: lj_strscan_num's own body (lj_strscan.c) with its GCstr accessor (strdata(str), str->len) replaced by\n    -- (p, len) — the one hand-written line; the preprocessor resolves STRSCAN_OPT_TONUM / STRSCAN_ERROR as LuaJIT's\n    local adapter = tmp .. '/cjs_strscan.c'\n    local fd = assert(io.open(adapter, 'w'))\n    fd:write('#include \"lj_strscan.h\"\\n',\n        'int cjs_tonum(const uint8_t *p, MSize len, TValue *o)\\n{\\n',\n        '  return lj_strscan_scan(p, len, o, STRSCAN_OPT_TONUM) != STRSCAN_ERROR;\\n}\\n')\n    fd:close()\n    local function pp(path)\n        local cmd = { 'gcc', '-E', '-P', '-D__attribute__(x)=' }\n        vim.list_extend(cmd, cflags)\n        vim.list_extend(cmd, { '-I' .. src, path })\n        local r = vim.system(cmd, { text = true }):wait()\n        if r.code ~= 0 then io.stderr:write('gcc -E ', path, ': ', r.stderr or '', '\\n'); os.exit(1) end\n        return r.stdout\n    end\n    -- THE LAYOUT of TValue, from the COMPILER: its f