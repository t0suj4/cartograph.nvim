thing. Kept as the record of the\n-- pre-swap measurement; the acceptance test was a ROW join against the walker.\n--"}},"decisions":[]},{"bytes":512,"decided_by":"tactic","id":"1791049611.983973-edit","verb":"edit","invocation":{"touched":["tests/algebra_spec.lua"],"verb":"edit","args":{"before":"    eq(2, S.note.distinct_depths, 'the string parses into the body (depth 1), the node does not (0)')\nend)","file":"tests/algebra_spec.lua","after":"    eq(2, S.note.distinct_depths, 'the string parses into the body (depth 1), the node does not (0)')\nend)\n\n-- ⚠ AN ENVIRONMENT FAULT IS NOT AN ANSWER: a refusal from `anti_unify` would reach\n-- `element_template` as `alignable = false`, the same verdict ~70% of real\n-- containers earn honestly — so a missing algebra RAISES (CART-0939).\ntest('algebra seam: anti_unify RAISES when the algebra is unavailable', function ()\n    need()\n    local load = alg.load\n    alg.load = function () return nil end\n    local ok, err = pcall(alg.anti_unify, { k = 'lit', v = 1, ty = 'num' }, { k = 'lit', v = 2, ty = 'num' })\n    alg.load = load\n    eq(false, ok, 'it raises')\n    ok(tostring(err):find('not available', 1, true), 'and says why: ' .. tostring(err))\nend)"}},"decisions":[]},{"bytes":145,"decided_by":"tactic","id":"1791049627.794760-edit","verb":"edit","invocation":{"touched":["tests/algebra_spec.lua"],"verb":"edit","args":{"before":"    local ok, err = pcall(alg.anti_unify, { k = 'lit', v = 1, ty = 'num' }, { k = 'lit', v = 2, ty = 'num' })\n    alg.load = load\n    eq(false, ok, 'it raises')","file":"tests/algebra_spec.lua","after":"    local fine, err = pcall(alg.anti_unify, { k = 'lit', v = 1, ty = 'num' }, { k = 'lit', v = 2, ty = 'num' })\n    alg.load = load\n    eq(false, fine, 'it raises')"}},"decisions":[]}],"commit":"6774614fe39aa28de9f8645a9ef4f2be2b16c811","open_intents":[],"version":1,"hand":0,"replay":[{"id":"1791049599.865766-edit","verb":"edit","invocation":{"touched":["lua/cartograph/algebra.lua"],"verb":