annot render at all — and what is the chart's control flow as hole domains? | `local P = require 'cartograph.helmprov'; local p = P.render(<chart>, { branches = true })` — a SECOND render through the same instrumented executor runs every arm the values skipped (an `if`/`with` then- or else-arm, a `range` body over an empty collection — its variables bound to no value — or its else after iterations) into its own buffer with the variables restored; `files` / spans stay the FIRST, unexplored render's (an untaken arm may call a mutating sprig function). `p.reads` gains the skipped arms' reads, `untaken = true` with the `guard` that skipped them (`<loc> if .Values.x (then)`); `P.uses` keeps a site taken when any execution took it; `:CartographHelmUses` and `P.use_items` explore by default and mark untaken sites. `P.domains(p)` = the control nodes as the algebra's hole domains — `if` without else PRESENCE, `if`/`else` ALT, `range` REP, `with` SCOPE — with the arms taken (execution counts) and each skipped arm's rendered text; `P.holes(p)` = skipped arms that FAIL under these values (`{{ if .Values.a }}{{ .Values.a.b }}` with no a: the error, the node, the text up to it) — not errors. Go's zero for a field of NO value means a range body over nothing renders empty rather than failing. Bounded: nested exploration 16 deep, a guard already being explored (recursive template) not re-entered; values are concrete, not symbolic (the proxy version is still open on CART-0871). Measured: microservices-demo — 14/14 files identical with and without exploration, 260 untaken reads, 192 control-node executions, 0 holes, and the reads now cover all 587 static reads of helmlint's tree-sitter reader (327 without); helm's 60 renderable testcharts — 60/60 identical, 169/169 static reads covered (112 without), 0 holes. CART-0871 |\n","file":".claude/skills/cartograph/references/questions.md"},"touched":[".claude/skills/cartograph/references/questions.md"]}}],"commit":"0fde0b9487f33254e7fa09ba570e96b546cbed52","explained":17608,"entries":[{"verb":"edit","id":"1790898470.409539-edit","bytes":2639,"decided_by":"tactic","invocation":{"verb":"edit","args":{"before":"// PROVENANCE (cartograph CART-0870): Go's text/template already knows, at every step, which parse node it is executing\n// (state.at, for its error messages) and where that node sits in its template (Tree.ErrorContext). This copy keeps that\n// attribution instead of throwing it away: every output byte range a top-level execution writes, to the action or\n// text node that wrote it, and every `.Values` chain evaluated, to the node that evaluated it (inside `include`d helpers\n// too). Recording is OFF unless Rec is set: with Rec nil the executor is the standard library's.\npackage template\n\nimport (\n\t\"io\"\n\t\"strings\"\n\n\t\"cartograph/helmprov/tpl/parse\"\n)\n\n// Span is one node's output: [Start, End) bytes of its file's rendered text.\ntype Span struct {\n\tStart  int      `json:\"start\"`\n\tEnd    int      `json:\"end\"`\n\tLoc    string   `json:\"loc\"`\n\tKind   string   `json:\"kind\"`\n\tValues []string `json:\"values,omitempty\"`\n}\n\n// Read is one `.Values` chain evaluated at a node.\ntype Read struct {\n\tPath string `json:\"path\"`\n\tLoc  string `json:\"loc\"`\n}\n\n// File is one rendered template's provenance.\ntype File struct {\n\tSpans []*Span `json:\"spans\"`\n}\n\n// Recorder collects provenance across one render.\ntype Recorder struct {\n\tFiles map[string]*File `json:\"files\"`\n\tReads []Read           `json:\"reads\"`\n\tdepth int\n}\n\n// Rec is the active recorder (nil: no recording).\nvar Rec *Recorder\n\n// NewRecorder starts recording.\nfunc NewRecorder() *Recorder { return &Recorder{Files: map[string]*File{}} }\n\ntype countWriter struct {\n\tw io.Writer\n\tn int\n}\n\nfunc (c *countWriter) Write(p []byte) (int, error) {\n\tn, err := c.w.Write(p)\n\tc.n += n\n\treturn n, err\n}\n\nfunc loc(n parse.Node, t *Template) string {\n\tif n == nil || t == nil || t.Tree == nil {\n\t\treturn \"\"\n\t}\n\tl, _ := t.ErrorContext(n)\n\treturn l\n}\n\nfunc (s *state) recordRead(n parse.Node, path []string) {\n\tif Rec == nil || len(path) == 0 {\n\t\treturn\n\t}\n\tp := strings.Join(path, \".\")\n\tRec.Reads = append(Rec.Reads, Read{Path: p, Loc: loc(n, s.tmpl)})\n\tif s.cur != nil {\n\t\ts.cur.Values = append(s.cur.Values, p)\n\t}\n}\n\n// Finish maps a file's spans through the engine's removal of \"<no value>\" (each occurrence deletes its bytes from the\n// output after execution) and returns the text as the engine emits it.\nfunc (r *Recorder) Finish(name, raw string) string {\n\tconst nv = \"<no value>\"\n\tf := r.Files[name]\n\tif f == nil || !strings.Contains(raw, nv) {\n\t\treturn strings.ReplaceAll(raw, nv, \"\")\n\t}\n\tvar cuts []int\n\tfor i := 0; ; {\n\t\tj := strings.Index(raw[i:], nv)\n\t\tif j < 0 {\n\t\t\tbreak\n\t\t}\n\t\tcuts = append(cuts, i+j)\n\t\ti += j + len(nv)\n\t}\n\tshift := func(x int) int {\n\t\td := 0\n\t\tfor _, c := range cuts {\n\t\t\tif c+len(nv) <= x {\n\t\t\t\td += len(nv)\n\t\t\t} else if c < x {\n\t\t\t\td += x - c\n\t\t\t}\n\t\t}\n\t\treturn x - d\n\t}\n\tfor _, sp := range f.Spans {\n\t\tsp.Start, sp.End = shift(sp.Start), shift(sp.End)\n\t}\n\treturn strings.ReplaceAll(raw, nv, \"\")\n}\n","after":"// PROVENANCE (cartograph CART-0870): Go's text/template already knows, at every step, which parse node it is executing\n// (state.at, for its error messages) and where that node sits in its template (Tree.ErrorContext). This copy keeps that\n// attribution instead of throwing it away: every output byte range a top-level execution writes, to the action or\n// text node that wrote it, and every `.Values` chain evaluated, to the node that evaluated it (inside `include`d helpers\n// too). Recording is OFF unless Rec is set: with Rec nil the executor is the standard library's.\n//\n// ALL BRANCHES (CART-0871): with Rec.Branches set, every arm the values did NOT take is executed too — into io.Discard,\n// with the variables restored after — so its `.Values` reads are recorded, tagged untaken with the GUARD that skipped\n// them; an untaken arm that fails (`{{ if .Values.a }}{{ .Values.a.b }}` with no a) is a HOLE, not an error. Run it as\n// a SEPARATE render: an untaken arm may call a mutating function (sprig's set / merge), so the authoritative render is\n// the one without exploration.\npackage template\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"reflect\"\n\t\"strings\"\n\n\t\"cartograph/helmprov/tpl/parse\"\n)\n\n// Span is one node's output: [Start, End) bytes of its file's rendered text.\ntype Span struct {\n\tStart  int      `json:\"start\"`\n\tEnd    int      `json:\"end\"`\n\tLoc    string   `json:\"loc\"`\n\tKind   string   `json:\"kind\"`\n\tValues []string `json:\"values,omitempty\"`\n}\n\n// Read is one `.Values` chain evaluated at a node; Untaken when it sits in an arm the values skipped (Guard names the\n// innermost such arm: `<loc> <if|with|range> <pipeline> (<then|else|body>)`).\ntype Read struct {\n\tPath    string `json:\"path\"`\n\tLoc     string `json:\"loc\"`\n\tUntaken bool   `json:\"untaken,omitempty\"`\n\tGuard   string `json:\"guard,omitempty\"`\n}\n\n// Arm is one execution of a control node: which arm the values took.\ntype Arm struct {\n\tLoc     string `json:\"loc\"`\n\tKind    string `json:\"kind\"`\n\tPipe    string `json:\"pipe\"`\n\tTaken   string `json:\"taken\"` // then | else | none (an if/with with no else, false) | body | empty\n\tUntaken bool   `json:\"untaken,omitempty\"`\n}\n\n// Hole is an untaken arm that could not execute: the node it failed at and why.\ntype Hole struct {\n\tLoc   string `json:\"loc\"`\n\tGuard string `json:\"guard\"`\n\tErr   string `json:\"err\"`\n}\n\n// File is one rendered template's provenance.\ntype File struct {\n\tSpans []*Span `json:\"spans\"`\n}\n\n// Recorder collects provenance across one render.\ntype Recorder struct {\n\tFiles    map[string]*File `json:\"files\"`\n\tReads    []Read        