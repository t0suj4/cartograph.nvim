ytes":668},{"decided_by":"tactic","decisions":[],"id":"1790633517.342779-edit","invocation":{"touched":["tests/prun.lua"],"args":{"after":"    -- a worker's own summary line is NOT re-emitted: the run has one summary, the combined one (a reader taking the\n    -- first match would read a share as the whole)\n    out((text:gsub('\\n%d+ passed, %d+ failed, %d+ skipped[^\\n]*\\n', '\\n')))","file":"tests/prun.lua","before":"    out(text)"},"verb":"edit"},"verb":"edit","bytes":245},{"decided_by":"tactic","decisions":[],"id":"1790633517.403233-edit","invocation":{"touched":["tests/run.sh"],"args":{"file":"tests/run.sh","after":"# The DEFAULT is parallel (JOBS unset = derived: min(cores, total / slowest spec)); JOBS=1 is the serial runner, and so\n# is a SPEC= run that names no JOBS (one or two specs gain nothing from workers)\nif [ \"${JOBS:-}\" != 1 ] && { [ -z \"${SPEC:-}\" ] || [ -n \"${JOBS:-}\" ]; }; then\n","before":"if [ \"${JOBS:-1}\" -gt 1 ]; then\n"},"verb":"edit"},"verb":"edit","bytes":280},{"decided_by":"tactic","decisions":[],"id":"1790633540.707826-edit","invocation":{"touched":["tests/prun.lua"],"args":{"file":"tests/prun.lua","after":"Run by tests/run.sh BY DEFAULT:\n--\n--   bash tests/run.sh                 workers derived: min(cores, total / slowest spec)\n--   JOBS=8 bash tests/run.sh          exactly 8 (SPEC=a_spec,b_spec narrows as always; JOBS=1 = the serial runner)","before":"Run by tests/run.sh when JOBS > 1:\n--\n--   JOBS=8 bash tests/run.sh          (SPEC=a_spec,b_spec narrows as always)"},"verb":"edit"},"verb":"edit","bytes":279},{"decided_by":"tactic","decisions":[],"id":"1790633540.750769-edit","invocation":{"touched":["tests/prun_spec.lua"],"args":{"after":"-- THE PARALLEL RUNNER (tests/prun.lua) over a FIXTURE suite: its own tests/run.lua (the real one, copied) and specs\n-- written here. The oracle is the serial runner's contract: one summary line, the sums of the workers' counts; a\n-- worker that prints no summary (a load error) FAILS the run by name, never reads as a pass.\nlocal REPO = vim.fn.fnamemodify(debug.getinfo(1, 'S').source:sub(2), ':p:h:h')\n\nlocal function fixture(specs)\n    local root = vim.fn.tempname()\n    vim.fn.mkdir(root .. '/tests', 'p')\n    vim.fn.writefile(vim.fn.readfile(REPO .. '/tests/run.lua'), root .. '/tests/run.lua')\n    for name, body in pairs(specs) do\n        local fd = assert(io.open(root .. '/tests/' .. name .. '.lua', 'w')); fd:write(body); fd:close()\n    end\n    return root\nend\nlocal function prun(root, jobs)\n    local r = vim.system({ 'nvim', '--headless', '-u', 'NONE', '--noplugin', '-l', REPO .. '/tests/prun.lua' },\n        { cwd = root, text = true, env = { JOBS = tostring(jobs), SPEC = '', TEST_TIMES_CACHE = root .. '/times-cache.tsv' } }):wait(120000)\n    return r.code, (r.stdout or ''), (r.stderr or '')\nend\n\ntest('prun: the workers\\' counts SUM into ONE summary line, on stderr like the serial runner, and the next run is balanced by measured time', function ()\n    local root = fixture {\n        a_spec = \"test('a1', function () end)\\ntest('a2', function () end)\\n\",\n        b_spec = \"test('b1', function () end)\\ntest('b2', function () skip 'not here' end)\\n\",\n        c_spec = \"test('c1', function () end)\\n\",\n    }\n    local code, out, err = prun(root, 2)\n    eq(0, code, err)\n    eq('', out, 'nothing on stdout: the serial runner writes to stderr, and so does this')\n    local sums = {}\n    for line in err:gmatch('[^\\n]+') do if line:match('^%d+ passed, %d+ failed, %d+ skipped') then sums[#sums + 1] = line end end\n    eq({ '4 passed, 0 failed, 1 skipped' }, sums, 'one summary line — the workers\\' own are not re-emitted')\n    ok(err:find('parallel: 2 worker(s)', 1, true), err)\n    local cache = table.concat(vim.fn.readfile(root .. '/times-cache.tsv'), '\\n')\n    ok(cache:find('a_spec\\t', 1, true) and cache:find('c_spec\\t', 1, true), 'the measured cost is kept for the next balance: ' .. cache)\nend)\n\ntest('prun: a worker that prints NO summary (a load error) fails the run BY NAME — and a failing test fails it too', function ()\n    local root = fixture {\n        a_spec = \"test('a1', function () end)\\n\",\n        b_spec = \"error('boom at load')\\n\",\n    }\n    local code, _, err = prun(root, 2)\n    eq(1, code, err)\n    ok(err:find('LOAD ERROR', 1, true) and err:find('BROKEN WORKER', 1, true) and err:find('b_spec', 1, true), err)\n    local root2 = fixture { a_spec = \"test('a1', function () end)\\n\", b_spec = \"test('b1', function () error('no') end)\\n\" }\n    local code2, _, err2 = prun(root2, 2)\n    eq(1, code2); ok(err2:find('1 passed, 1 failed, 0 skipped', 1, true), err2)\nend)\n","file":"tests/prun_spec.lua","before":""},"verb":"edit"},"verb":"edit","bytes":2907},{"decided_by":"tactic","decisions":[],"id":"1790633600.110533-edit","invocation":{"touched":[".claude/skills/cartograph/references/questions.md"],"args":{"file":".claude/skills/cartograph/references/questions.md","after":"MEASURED 2026-09-29: 79 s wall, 77 s in tests; 74% of tests < 10 ms; the top 20 tests = 44%, top 100 = 64%; load time negligible. ★ THE SUITE RUNS IN PARALLEL BY DEFAULT (`tests/prun.lua`): spec files across worker processes, each its own state home, balanced by the last run's measured per-spec time (cache `stdpath(cache)/cartograph/test-times.tsv`); workers derived = min(cores, total / slowest spec); `JOBS=N` exact, `JOBS=1` (or a `SPEC=` run without JOBS) the serial runner. One summary line on stderr, like the serial one; a worker with no summary FAILS the run by name. 77.6 s serial → 12.1 s, per-test rows identical; the floor is the slowest spec (treesitter_spec ~12 s). |","before":"MEASURED 2026-09-29: 79 s wall, 77 s in tests; 74% of tests < 10 ms; the top 20 tests = 44%, top 100 = 64%; load time negligible. |"},"verb":"edit"},"verb":"edit","bytes":1020}]}
