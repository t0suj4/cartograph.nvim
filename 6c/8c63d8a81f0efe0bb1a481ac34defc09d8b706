er.fields or {}) do\n        if f.type.name == 'GRPCAction' then handler.grpc = f.json elseif f.type.name == 'HTTPGetAction' then handler.http = f.json end\n    end\n    return { pod = pod, refs = refs, probes = probes, probe_handler = handler }\nend\n","before":"    for _, l in pairs(pod) do table.sort(l) end\n    table.sort(refs, function (a, b) return a.kind .. a.path < b.kind .. b.path end)\n    return { pod = pod, refs = refs }\nend\n"}},"decisions":[]},{"bytes":240,"decided_by":"tactic","id":"1790896907.201859-edit","verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/k8sapi.lua"],"args":{"before":"    local t = { stamp = stamp, pod = {}, refs = {}, cluster = {}, group = {} }\n    for k, paths in pairs(D.pod) do t.pod[k] = paths[1] end\n","after":"    local t = { stamp = stamp, pod = {}, refs = {}, cluster = {}, group = {}, probes = D.probes or {},\n        probe_grpc = D.probe_handler and D.probe_handler.grpc or false, probe_http = D.probe_handler and D.probe_handler.http or false }\n    for k, paths in pairs(D.pod) do t.pod[k] = paths[1] end\n","file":"lua/cartograph/k8sapi.lua"}},"decisions":[]},{"bytes":406,"decided_by":"tactic","id":"1790896907.254254-edit","verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/k8sapi.lua"],"args":{"before":"    map('group', t.group, function (v) return ('%q'):format(v) end)\n","after":"    map('group', t.group, function (v) return ('%q'):format(v) end)\n    map('probes', t.probes or {}, function (v)\n        local q = {}\n        for _, p in ipairs(v) do q[#q + 1] = ('%q'):format(p) end\n        return '{ ' .. table.concat(q, ', ') .. ' }'\n    end)\n    o[#o + 1] = ('    probe_grpc = %s,'):format(t.probe_grpc and ('%q'):format(t.probe_grpc) or 'false')\n    o[#o + 1] = ('    probe_http = %s,'):format(t.probe_http and ('%q'):format(t.probe_http) or 'false')\n","file":"lua/cartograph/k8sapi.lua"}},"decisions":[]},{"bytes":872,"decided_by":"tactic","id":"1790896931.214639-edit","verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/k8s.lua"],"args":{"before":"    d.refs = refs_of(v, d.kind)\n","after":"    d.refs = refs_of(v, d.kind)\n    -- (the PROBES: a call the kubelet makes into the container, at the paths and handler fields the API types give —\n    -- CART-0834. A gRPC probe calls the Health contract; an httpGet probe is a different boundary, recorded apart)\n    d.probes = {}\n    for _, path in ipairs(API and API.probes and API.probes[d.kind or ''] or {}) do\n        for _, pr in ipairs(at_path(v, path)) do\n            local g = API.probe_grpc and get(pr, API.probe_grpc)\n            local h = API.probe_http and get(pr, API.probe_http)\n            if type(g) == 'table' and g.o then d.probes[#d.probes + 1] = { kind = 'grpc', path = path, port = str(get(g, 'port')), service = str(get(g, 'service')) }\n            elseif type(h) == 'table' and h.o then d.probes[#d.probes + 1] = { kind = 'http', path = path, port = str(get(h, 'port')), route = str(get(h, 'path')) } end\n        end\n    end\n","file":"lua/cartograph/k8s.lua"}},"decisions":[]},{"bytes":335,"decided_by":"tactic","id":"1790896931.275402-edit","verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/k8s.lua"],"args":{"file":"lua/cartograph/k8s.lua","after":"                    for _, pr in ipairs(d.probes or {}) do\n                        stats.probes = stats.probes or {}\n                        stats.probes[#stats.probes + 1] = { rel = rel, variant = variant, name = d.name, kind = pr.kind, port = pr.port, service = pr.service, route = pr.route, path = pr.path }\n                    end\n                    if (d.refs and #d.refs > 0) or d.podlabels then\n","before":"                    if (d.refs and #d.refs > 0) or d.podlabels then\n"}},"decisions":[]},{"bytes":1746,"decided_by":"tactic","id":"1790896931.336584-edit","verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/k8s.lua"],"args":{"file":"lua/cartograph/k8s.lua","after":"--- ★ THE PROBE IS A CALL SITE (CART-0834): the kubelet calls a gRPC probe's container on the gRPC HEALTH contract —\n--- `/grpc.health.v1.Health/Check` — every few seconds, so the manifest DECLARES a caller the source never contains (on\n--- microservices-demo, the most-called rpc of the running system). Runs AFTER the proto pass has minted the rpc nodes\n--- (the post-pass calls it from the proto step: k8s runs before proto so `deploys` exists while contracts bind): a\n--- `use` edge, k8 = 'probes', from the manifest to every rpc node whose WIRE path is the Health check (vendored copies\n--- of health.proto are one contract, joined by wire). No such node: the probe is counted as a frontier (the contract\n--- is not in this graph). An httpGet probe is a different boundary and is never minted as a gRPC call.\nM.HEALTH_WIRE = '/grpc.health.v1.Health/Check'\nfunction M.link_probes(data)\n    local s = data and data.k8s\n    if not s or not s.probes then return nil end\n    local targets = {}\n    for _, n in ipairs(data.nodes or {}) do if n.pb == 'rpc' and n.wire == M.HEALTH_WIRE then targets[#targets + 1] = n.id end end\n    local p = { grpc = 0, linked = 0, unlinked = 0, http = 0, edges = 0 }\n    for _, pr in ipairs(s.probes) do\n        if pr.kind == 'http' then p.http = p.http + 1\n        else\n            p.grpc = p.grpc + 1\n            if #targets > 0 then\n                p.linked = p.linked + 1\n                for _, t in ipairs(targets) do\n                    data.edges[#data.edges + 1] = { from = pr.rel, to = t, kind = 'use', k8 = 'probes', at = {} }\n                    p.edges = p.edges + 1\n                end\n            else p.unlinked = p.unlinked + 1 end\n        end\n    end\n    s.probe_links = p\n    return p\nend\n\n--- service name -> source directory, the join a runtime observation needs.\n","before":"--- service name -> source directory, the join a runtime observation needs.\n"}},"decisions":[]},{"bytes":316,"decided_by":"tactic","id":"1790896931.406974-edit","verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/k8s.lua"],"args":{"before":"    local o = s.orphans\n","after":"    local pl = s.probe_links\n    if pl and (pl.grpc + pl.http) > 0 then\n        l[#l + 1] = ('probes: %d gRPC (%d linked to the Health contract, %d with no Health rpc in this graph — a frontier), %d httpGet (a different boundary, not linked)')\n            :format(pl.grpc, pl.linked, pl.unlinked, pl.http)\n    end\n    local o = s.orphans\n","file":"lua/cartograph/k8s.lua"}},"decisions":[]},{"bytes":308,"decided_by":"tactic","id":"1790896931.454506-edit","verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/postpass.lua"],"args":{"before":"        run = function (data) return require('cartograph.proto').attach(data) end,\n","after":"        run = function (data)\n            local s = require('cartograph.proto').attach(data)\n            -- (the deployment -> contract edge: a gRPC probe calls the Health rpc the proto pass just minted — CART-0834)\n            require('cartograph.k8s').link_probes(data)\n            return s\n        end,\n","file":"lua/cartograph/postpass.lua"}},"decisions":[]},{"bytes":352,"decided_by":"tactic","id":"1790896959.982390-edit","verb":"edit","invocation":{"verb":"edit","touched":["tests/k8sapi_spec.lua"],"args":{"before":"type Container struct {\n\tEnv []EnvVar `json:\"env,omitempty\"`\n","after":"type GRPCAction struct {\n\tPort int32 `json:\"port\"`\n}\ntype HTTPGetAction struct {\n\tPath string `json:\"path,omitempty\"`\n}\ntype ProbeHandler struct {\n\tHTTPGet *HTTPGetAction `json:\"httpGet,omitempty\"`\n\tGRPC *GRPCAction `json:\"grpc,omitempty\"`\n}\ntype Probe struct {\n\tProbeHandler `json:\",inline\"`\n}\ntype Container struct {\n\tReadinessProbe *Probe `json:\"readinessProbe,omitempty\"`\n\tEnv []EnvVar `json:\"env,omitempty\"`\n","file":"tests/k8sapi_spec.lua"}},"decisions":[]},{"bytes":354,"decided_by":"tactic","id":"1790896960.022686-edit","verb":"edit","invocation":{"verb":"edit","touched":["tests/k8sapi_spec.lua"],"args":{"file":"tests/k8sapi_spec.lua","after":"test('k8sapi: PROBES — every field typed Probe — and the handler\\'s gRPC / HTTP fields by their TYPE (CART-0834)', function ()\n    if not ready() then skip 'no go parser' end\n    local _, D = derive()\n    eq({ 'spec.template.spec.containers[].readinessProbe' }, D.probes.Deployment)\n    eq({ grpc = 'grpc', http = 'httpGet' }, D.probe_handler)\nend)\n\ntest('k8sapi: the table serializes DETERMINISTICALLY and round-trips', function ()\n","before":"test('k8sapi: the table serializes DETERMINISTICALLY and round-trips', function ()\n"}},"decisions":[]},{"bytes":1416,"decided_by":"tactic","id":"1790896960.071307-edit","verb":"edit","invocation":{"verb":"edit","touched":["tests/k8s_spec.lua"],"args":{"file":"tests/k8s_spec.lua","after":"test('k8s: a gRPC PROBE is a call into the Health contract — linked when the rpc is in the graph, a frontier when not; httpGet is not a gRPC call — CART-0834', function ()\n    if not ready() then skip 'no yaml parser' end\n    local root = tmproot({ ['k/d.yaml'] = table.concat({\n        'apiVersion: apps/v1', 'kind: Deployment', 'metadata:', '  name: catalog', 'spec:', '  template:', '    spec:', '      containers:',\n        '      - name: c', '        image: catalog', '        readinessProbe:', '          grpc:', '            port: 3550',\n        '        livenessProbe:', '          httpGet:', '            path: /healthz', '            port: 8080' }, '\\n') .. '\\n' })\n    local health = { id = 'protos/health.proto::Health::Check@41', name = 'Health::Check', kind = 'method', pb = 'rpc', wire = K.HEALTH_WIRE }\n    local data = { root = root, nodes = { health }, edges = {} }\n    K.attach(data)\n    local p = K.link_probes(data)\n    eq({ grpc = 1, linked = 1, unlinked = 0, http = 1, edges = 1 }, p)\n    local e\n    for _, x in ipairs(data.edges) do if x.k8 == 'probes' then e = x end end\n    eq('protos/health.proto::Health::Check@41', e and e.to, 'manifest -> the Health rpc')\n    local data2 = { root = root, nodes = {}, edges = {} }\n    K.attach(data2)\n    eq({ grpc = 1, linked = 0, unlinked = 1, http = 1, edges = 0 }, K.link_probes(data2), 'no Health rpc in the graph: a frontier, no edge')\nend)\n\ntest('k8s: the POD TEMPLATE is where the API types put it — CronJob spec.jobTemplate.spec.template.spec — CART-1267', function ()\n","before":"test('k8s: the POD TEMPLATE is where the API types put it — CronJob spec.jobTemplate.spec.template.spec — CART-1267', function ()\n"}},"decisions":[]},{"bytes":3015,"decided_by":"tactic","id":"1790896980.304637-edit","verb":"edit","invocation":{"verb":"edit","touched":[".claude/skills/cartograph/references/questions.md"],"args":{"file":".claude/skills/cartograph/references/questions.md","after":"| What does a Kubernetes object REFERENCE without owning it (the soft edges the garbage collector never walks: ConfigMaps / Secrets by env, envFrom and volumes, imagePullSecrets, the ServiceAccount, a PVC's claim, an Ingress backend's Service, a selector's pods) — which resolve in the release, which the cluster provides, which DANGLE, and which Service selects no pod? Where does each kind keep its pod template? | `K.attach(...)` as above, then `s.soft` = { resolved, selects, cluster, optional, implicit, dangling = { \"Deployment/web <path> names Secret/x, absent from <release>\" }, empty = { \"Service/api spec.selector{} selects no pod in <release>\" } }; resolved references are `references` edges, selector matches `selects` edges (a workload's own selector makes none); `K.summary` prints both findings. NOTHING IS LISTED: `require('cartograph.k8sapi')` READS Kubernetes' own Go API types (kinds from register.go, groups from GroupName, fields from json tags, embedding, imports resolved per package, cluster scope from `+genclient:nonNamespaced`) and DERIVES the pod-template paths (`CronJob spec.jobTemplate.spec.template.spec`) and every reference with its target kind from the source's own words (the json stem, a reference's own `kind` field first, a selector's doc comment, a suffix-only match only where the doc names the kind in full); `tools/k8sapi.lua <kubernetes checkout>` writes the shipped `lua/cartograph/k8sapi_table.lua` (84 kinds, 38 cluster-scoped, 9 pod-template kinds, 608 references at kubernetes 9f929771aca0) and `--check` exits 1 on drift. Absent = cluster-provided when the target kind is cluster-scoped (StorageClass, Node: a frontier), optional when the reference says so, implicit for the `default` ServiceAccount, else dangling. DELETION FRONTIER (CART-0139): `s.orphans` = { live = n, candidates = { \"<Kind>/<name> in <release> — no static reference …\" }, dark = { … the release ships <custom kinds> … } } over DATA kinds derived from the table (reference targets minus workloads, routers and cluster-scoped kinds): LIVE when a reference resolves, `~` CANDIDATE when none does (never auto-delete: an operator may read it by name), DARK when the release ships a kind the API table does not know (a custom resource may reference it); a kustomize `kind: Component` directory is composed with a base — its unresolved selectors / references are counted `composed`, not findings. PROBES (CART-0834): every field typed Probe (readiness / liveness / startup, on containers, init and ephemeral containers) is read at the derived paths; a gRPC probe is a CALL the kubelet makes on the Health contract — `K.link_probes(data)` (the post-pass runs it after proto mints the rpc nodes) draws `use` edges k8 = \"probes\" from the manifest to every rpc node whose wire is `/grpc.health.v1.Health/Check` (microservices-demo: 54 probes, 162 edges to 3 vendored copies); no Health rpc in the graph = a frontier; httpGet probes are counted, never minted as gRPC. CART-1267, CART-1296 |\n","before":"| What does a Kubernetes object REFERENCE without owning it (the soft edges the garbage collector never walks: ConfigMaps / Secrets by env, envFrom and volumes, imagePullSecrets, the ServiceAccount, a PVC's claim, an Ingress backend's Service, a selector's pods) — which resolve in the release, which the cluster provides, which DANGLE, and which Service selects no pod? Where does each kind keep its pod template? | `K.attach(...)` as above, then `s.soft` = { resolved, selects, cluster, optional, implicit, dangling = { \"Deployment/web <path> names Secret/x, absent from <release>\" }, empty = { \"Service/api spec.selector{} selects no pod in <release>\" } }; resolved references are `references` edges, selector matches `selects` edges (a workload's own selector makes none); `K.summary` prints both findings. NOTHING IS LISTED: `require('cartograph.k8sapi')` READS Kubernetes' own Go API types (kinds from register.go, groups from GroupName, fields from json tags, embedding, imports resolved per package, cluster scope from `+genclient:nonNamespaced`) and DERIVES the pod-template paths (`CronJob spec.jobTemplate.spec.template.spec`) and every reference with its target kind from the source's own words (the json stem, a reference's own `kind` field first, a selector's doc comment, a suffix-only match only where the doc names the kind in full); `tools/k8sapi.lua <kubernetes checkout>` writes the shipped `lua/cartograph/k8sapi_table.lua` (84 kinds, 38 cluster-scoped, 9 pod-template kinds, 608 references at kubernetes 9f929771aca0) and `--check` exits 1 on drift. Absent = cluster-provided when the target kind is cluster-scoped (StorageClass, Node: a frontier), optional when the reference says so, implicit for the `default` ServiceAccount, else dangling. DELETION FRONTIER (CART-0139): `s.orphans` = { live = n, candidates = { \"<Kind>/<name> in <release> — no static reference …\" }, dark = { … the release ships <custom kinds> … } } over DATA kinds derived from the table (reference targets minus workloads, routers and cluster-scoped kinds): LIVE when a reference resolves, `~` CANDIDATE when none does (never auto-delete: an operator may read it by name), DARK when the release ships a kind the API table does not know (a custom resource may reference it); a kustomize `kind: Component` directory is composed with a base — its unresolved selectors / references are counted `composed`, not findings. CART-1267, CART-1296 |\n"}},"decisions":[]}],"hand":4597,"replay":[{"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/k8sapi.lua"],"args":{"file":"lua/cartograph/k8sapi.lua","after":"                if f.type.name == 'PodSpec' and f.shape == 'one' and f.type.pkg == 'k8s.io/api/core/v1' then\n                    pod[K] = pod[K] or {}; table.insert(pod[K], p)\n                end\n                -- (a PROBE — readiness / liveness / startup — is a CALL the kubelet makes into the container: every\n                -- field typed core Probe, CART-0834)\n                if f.type.name == 'Probe' and f.type.pkg == 'k8s.io/api/core/v1' then\n                    probes[K] = probes[K] or {}; table.insert(probes[K], p)\n                end\n","before":"                if f.type.name == 'PodSpec' and f.shape == 'one' and f.type.pkg == 'k8s.io/api/core/v1' then\n                    pod[K] = pod[K] or {}; table.insert(pod[K], p)\n                end\n"}},"id":"1790896907.049848-edit"},{"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/k8sapi.lua"],"args":{"before":"    local pod, refs, seen = {}, {}, {}\n","after":"    local pod, refs, seen, probes = {}, {}, {}, {}\n","file":"lua/cartograph/k8sapi.lua"}},"id":"1790896907.100948-edit"},{"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/k8sapi.lua"],"args":{"file":"lua/cartograph/k8sapi.lua","after":"    for _, l in pairs(pod) do table.sort(l) end\n    for _, l in pairs(probes) do table.sort(l) end\n    table.sort(refs, function (a, b) return a.kind .. a.path < b.kind .. b.path end)\n    -- (the probe HANDLER's fields by their TYPE: which json name holds a gRPC action, which an HTTP GET)\n    local handler = {}\n    local