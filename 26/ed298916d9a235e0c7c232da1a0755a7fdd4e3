{"version":1,"open_intents":[],"explained":9513,"entries":[{"bytes":1125,"decided_by":"tactic","id":"1791530655.654901-edit","verb":"edit","invocation":{"touched":["lua/cartograph/spec/go.lua"],"verb":"edit","args":{"before":"local function go_params(node, src, out)\n    for _, f in ipairs({ 'receiver', 'parameters', 'result' }) do\n        local pl = node:field(f)[1]\n        if pl and pl:type() == 'parameter_list' then\n            for _, d in tsutil.inext, pl, -1 do\n                for _, nm in ipairs(d:field('name')) do out[node_text(nm, src)] = {} end\n            end\n        end\n    end\nend","after":"-- a binder's TYPE NAME (CART-1599): `T`, `*T`, `pkg.T`, `T[X]` -> \"T\" — go's methods are minted `T.m`, so a\n-- typed receiver `s *scriptGroup` lets `s.key()` qualify to scriptGroup.key (go_qualify_call below)\nlocal function go_type_name(t, src)\n    while t do\n        local k = t:type()\n        if k == 'type_identifier' then return node_text(t, src) end\n        if k == 'pointer_type' or k == 'parenthesized_type' then t = t:named_child(0)\n        elseif k == 'qualified_type' then t = t:field('name')[1]\n        elseif k == 'generic_type' then t = t:field('type')[1]\n        else return nil end\n    end\nend\n-- the type a short-var VALUE names right there: `T{…}`, `&T{…}` (anything else — a call — is unknown here)\nlocal function go_value_type(v, src)\n    if v and v:type() == 'unary_expression' then v = v:field('operand')[1] end\n    if v and v:type() == 'composite_literal' then return go_type_name(v:field('type')[1], src) end\n    return nil\nend\nlocal function go_params(node, src, out)\n    for _, f in ipairs({ 'receiver', 'parameters', 'result' }) do\n        local pl = node:field(f)[1]\n        if pl and pl:type() == 'parameter_list' then\n            for _, d in tsutil.inext, pl, -1 do\n                local ty = go_type_name(d:field('type')[1], src)\n                for _, nm in ipairs(d:field('name')) do out[node_text(nm, src)] = { ty = ty } end\n            end\n        end\n    end\nend","file":"lua/cartograph/spec/go.lua"}},"decisions":[]},{"bytes":478,"decided_by":"tactic","id":"1791530655.716369-edit","verb":"edit","invocation":{"touched":["lua/cartograph/spec/go.lua"],"verb":"edit","args":{"before":"    if t == 'short_var_declaration' then\n        local l = st:field('left')[1]\n        if l then go_idents(l, src, out, row, st) end","after":"    if t == 'short_var_declaration' then\n        local l = st:field('left')[1]\n        if l then\n            go_idents(l, src, out, row, st)\n            local r, i = st:field('right')[1], 0 -- (pair each name with its value: `a, b := T{}, &U{}`)\n            for _, c in tsutil.inext, l, -1 do\n                if c:type() == 'identifier' then\n                    local b = out[node_text(c, src)]\n                    if b then b.ty = go_value_type(r and r:named_child(i), src) end\n                    i = i + 1\n                end\n            end\n        end","file":"lua/cartograph/spec/go.lua"}},"decisions":[]},{"bytes":279,"decided_by":"tactic","id":"1791530655.779402-edit","verb":"edit","invocation":{"touched":["lua/cartograph/spec/go.lua"],"verb":"edit","args":{"file":"lua/cartograph/spec/go.lua","after":"                    local ty = go_type_name(s:field('type')[1], src) -- (`var x T`)\n                    for _, nm in ipairs(s:field('name')) do\n                        out[node_text(nm, src)] = { row = row, at = sr, ate = er, ab = sb, abe = eb, ty = ty }\n                    end","before":"                    for _, nm in ipairs(s:field('name')) do out[node_text(nm, src)] = { row = row, at = sr, ate = er, ab = sb, abe = eb } end"}},"decisions":[]},{"bytes":775,"decided_by":"tactic","id":"1791530655.842165-edit","verb":"edit","invocation":{"touched":["lua/cartograph/spec/go.lua"],"verb":"edit","args":{"file":"lua/cartograph/spec/go.lua","after":"-- RECEIVER TYPING (CART-1599): `x.m(…)` with x bound to a binder of a known type keys `T.m` — the name go's method\n-- defs carry —; a receiver of unknown type keeps its spelling (and the name join's tails)\nlocal function go_qualify_call(calln, name, src, model)\n    if not model or calln:type() ~= 'call_expression' then return nil end\n    local f = calln:field('function')[1]\n    if not (f and f:type() == 'selector_expression') then return nil end\n    local op, fld = f:field('operand')[1], f:field('field')[1]\n    if not (op and fld and op:type() == 'identifier') then return nil end\n    local chain, k = model.resolve(node_text(op, src), calln)\n    local ty = k > 0 and chain[1].ty\n    if not ty then return nil end\n    return ty .. '.' .. node_text(fld, src)\nend\nlocal GO_LEXICAL_SCOPES = {","before":"local GO_LEXICAL_SCOPES = {"}},"decisions":[]},{"bytes":51,"decided_by":"tactic","id":"1791530655.906098-edit","verb":"edit","invocation":{"touched":["lua/cartograph/spec/go.lua"],"verb":"edit","args":{"file":"lua/cartograph/spec/go.lua","after":"    lexical_scopes = GO_LEXICAL_SCOPES, -- CART-1598\n    fn_locals = go_fn_locals,\n    qualify_call = go_qualify_call, -- (CART-1599)","before":"    lexical_scopes = GO_LEXICAL_SCOPES, -- CART-1598\n    fn_locals = go_fn_locals,"}},"decisions":[]},{"bytes":373,"decided_by":"tactic","id":"1791530779.154037-edit","verb":"edit","invocation":{"touched":["lua/cartograph/spec/go.lua"],"verb":"edit","args":{"before":"            local recv = defn:field('receiver')[1]\n            if recv then\n                local t = node_text(recv, src)\n                    :match('%*?([%w_]+)%s*%)')\n                    or node_text(recv, src)\n                        :match('%*?([%w_]+)')\n                if t then return t .. '.' .. name end\n            end\n            return name","after":"            local recv = defn:field('receiver')[1]\n            -- (the receiver's TYPE from the tree: a text pattern read `(r *NodeShiftTree[T])` as `r` — every\n            -- method of a generic type was minted under its receiver VARIABLE, CART-159