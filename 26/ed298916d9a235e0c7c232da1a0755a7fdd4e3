['A.self>A.key'], 'the receiver a *A: a.key() is A.key')\n    ok(refs['viaParam>B.key'], 'a typed param b B: B.key')\n    ok(refs['viaVar>A.key'], '`var v A`: A.key')\n    ok(refs['viaLit>A.key'] and refs['viaLit>B.key'], '`l := &A{}` / `m := B{}`: their literal types')\n    ok(not refs['viaUnknown>A.key'] and not refs['viaUnknown>B.key'], 'an interface-typed param names no struct: ' .. vim.inspect(refs))\nend)\n\n-- ⚠ A BOUND ARGUMENT IS ITS BINDING (CART-1598)","before":"-- ⚠ A BOUND ARGUMENT IS ITS BINDING (CART-1598)"}},"decisions":[]},{"bytes":4500,"decided_by":"tactic","id":"1791531182.206997-edit","verb":"edit","invocation":{"touched":["lua/cartograph/cache.lua"],"verb":"edit","args":{"before":"M.VERSION = 253 -- v253:","after":"M.VERSION = 254 -- v254: GO receiver typing — a call on a typed receiver / param / var / literal-bound local keys Type.method; generic methods are minted Type.method, not under the receiver variable (CART-1599, go). v253:","file":"lua/cartograph/cache.lua"}},"decisions":[]}],"hand":0,"replay":[{"id":"1791530655.654901-edit","verb":"edit","invocation":{"touched":["lua/cartograph/spec/go.lua"],"verb":"edit","args":{"before":"local function go_params(node, src, out)\n    for _, f in ipairs({ 'receiver', 'parameters', 'result' }) do\n        local pl = node:field(f)[1]\n        if pl and pl:type() == 'parameter_list' then\n            for _, d in tsutil.inext, pl, -1 do\n                for _, nm in ipairs(d:field('name')) do out[node_text(nm, src)] = {} end\n            end\n        end\n    end\nend","after":"-- a binder's TYPE NAME (CART-1599): `T`, `*T`, `pkg.T`, `T[X]` -> \"T\" — go's methods are minted `T.m`, so a\n-- typed receiver `s *scriptGroup` lets `s.key()` qualify to scriptGroup.key (go_qualify_call below)\nlocal function go_type_name(t, src)\n    while t do\n        local k = t:type()\n        if k == 'type_identifier' then return node_text(t, src) end\n        if k == 'pointer_type' or k == 'parenthesized_type' then t = t: