,"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit"},"id":"1791226428.449567-edit","bytes":187,"decided_by":"tactic"},{"decisions":[],"verb":"edit","invocation":{"args":{"file":"tests/lexicalscope_spec.lua","before":"local function calls_of(data, callee)\n    local out = {}\n    for _, c in ipairs(data.calls) do\n        if c.callee == callee then out[#out + 1] = { line = c.line or (require('cartograph.at').sl(c.at) + 1), to = c.to, refused = c.refused and c.refused.rule } end\n    end","after":"local function calls_of(data, callee)\n    local out = {}\n    local cv = require('cartograph.callview').of(data) -- (calls are columnar: read through the view)\n    for i = 1, cv.n do\n        if cv.get(i, 'callee') == callee then\n            local r = cv.get(i, 'refused')\n            out[#out + 1] = { line = require('cartograph.at').sl(cv.get(i, 'at')) + 1, to = cv.get(i, 'to'), refused = type(r) == 'table' and r.rule or r }\n        end\n    end"},"touched":["tests/lexicalscope_spec.lua"],"verb":"edit"},"id":"1791226441.014430-edit","bytes":382,"decided_by":"tactic"},{"decisions":[],"verb":"edit","invocation":{"args":{"file":"tests/lexicalscope_spec.lua","before":"    local tw = calls_of(data, 'twice')[1]\n    eq(nil, tw.to); eq('samefile', tw.refused, 'two file-level definitions before the call: the later shadows — but both are file level, and')\nend)","after":"    eq(19, line_of(data, calls_of(data, 'twice')[1].to), 'two FILE-LEVEL local functions: the later shadows')\nend)"},"touched":["tests/lexicalscope_spec.lua"],"verb":"edit"},"id":"1791226441.082166-edit","bytes":110,"decided_by":"tactic"},{"decisions":[],"verb":"edit","invocation":{"args":{"file":"tests/lexicalscope_spec.lua","before":"    eq(19, line_of(data, calls_of(data, 'twice')[1].to), 'two FILE-LEVEL local functions: the later shadows')\nend)","after":"    eq(19, line_of(data, calls_of(data, 'twice')[1].to), 'two FILE-LEVEL local functions: the later shadows')\nend)\n\ntest('lexical scope: an INCREMENTAL refresh re-resolves the same way — the relink path has its own copy of the resolver (CART-1485)', function ()\n    if not parser_available('lua') then skip 'no lua parser' end\n    local store = require 'cartograph.store'\n    local root = vim.fn.tempname(); vim.fn.mkdir(root, 'p')\n    local fd = assert(io.open(root .. '/m.lua', 'w')); fd:write(SRC); fd:close()\n    store.ingest(ts.extract(root))\n    fd = assert(io.open(root .. '/m.lua', 'w')); fd:write(SRC:gsub('return 2 end', 'return 3 end')); fd:close()\n    local stats = assert(require('cartograph.refresh').files({ 'm.lua' }, { incremental = true }))\n    local data = store.data\n    local walks = calls_of(data, 'walk')\n    vim.fn.delete(root, 'rf')\n    eq(3, #walks)\n    eq({ 3, 3, 7 }, { line_of(data, walks[1].to), line_of(data, walks[2].to), line_of(data, walks[3].to) }, vim.inspect(stats))\n    eq(12, line_of(data, calls_of(data, 'pick')[1].to))\nend)"},"touched":["tests/lexicalscope_spec.lua"],"verb":"edit"},"id":"1791226487.523007-edit","bytes":806,"decided_by":"tactic"},{"decisions":[],"verb":"edit","invocation":{"args":{"file":"tests/lexicalscope_spec.lua","before":"    'local function h() return twice() end',\n    'return M', '' }, '\\n')","after":"    'local function h() return twice() end',\n    'local function walk(x) return -1 end',\n    'function M.d(t) local function walk(x) return 9 end return walk(t) end',\n    'return M', '' }, '\\n')"},"touched":["tests/lexicalscope_spec.lua"],"verb":"edit"},"id":"1791226516.856309-edit","bytes":122,"decided_by":"tactic"},{"decisions":[],"verb":"edit","invocation":{"args":{"file":"tests/lexicalscope_spec.lua","before":"    eq(3, #walks)\n    eq(3, line_of(data, walks[1].to), 'a\\'s walk calling itself')","after":"    eq(4, #walks)\n    eq(22, line_of(data, walks[4].to), 'the INNERMOST: M.d\\'s own walk, not the file-level one')\n    eq(3, line_of(data, walks[1].to), 'a\\'s walk calling itself')"},"touched":["tests/lexicalscope_spec.lua"],"verb":"edit"},"id":"1791226516.920478-edit","bytes":115,"decided_by":"tactic"},{"decisions":[],"verb":"edit","invocation":{"args":{"file":"tests/lexicalscope_spec.lua","before":"    eq(3, #walks)\n    eq({ 3, 3, 7 }, { line_of(data, walks[1].to), line_of(data, walks[2].to), line_of(data, walks[3].to) }, vim.inspect(stats))","after":"    eq(4, #walks)\n    eq({ 3, 3, 7, 22 }, { line_of(data, walks[1].to), line_of(data, walks[2].to), line_of(data, walks[3].to), line_of(data, walks[4].to) }, vim.inspect(stats))"},"touched":["tests/lexicalscope_spec.lua"],"verb":"edit"},"id":"1791226516.983349-edit","bytes":178,"decided_by":"tactic"},{"decisions":[],"verb":"edit","invocation":{"args":{"file":"lua/cartograph/loopcost.lua","before":"-- ── CALLEES: THE CALL GRAPH, THEN LEXICAL SCOPE ─────────────────────────────────────\n-- A call the resolver linked (`c.to`) is followed. A BARE call it refused is resolved here by\n-- LEXICAL SCOPE when exactly one same-named function is visible from the call: defined in the\n-- same file, inside a function (or the file) that encloses the call. That is how the fixture is\n-- reached at all: treesitter.lua holds TWO local `fn_at`s in two enclosing functions, so name\n-- matching refuses all 8 calls, and each is decided by which function it sits in. Such an edge\n-- is `lexical` on the finding (name-matched, scoped), never a claim the call graph made. The rule\n-- belongs in the resolver (CART-1059); it lives here until it moves.","after":"-- ── CALLEES: THE CALL GRAPH, THEN LEXICAL SCOPE FOR A FUNCTION PASSED BY NAME ───────\n-- A call the resolver linked (`c.to`) is followed — including a call of a same-named local function,\n-- which the resolver now decides by LEXICAL SCOPE (CART-1059: treesitter.lua's two local `fn_at`s,\n-- once refused at all 8 calls, are linked there). What stays here is a function passed BY NAME\n-- (`pcall(heavy, t)`): an argument, not a call, so the resolver links nothing — it is resolved by\n-- the same scope ru