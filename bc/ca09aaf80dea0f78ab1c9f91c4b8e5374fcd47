.\n-- `fn` is the call's callee chain `X.setdefault`, X the receiver.\nlocal PY_MEMO = { setdefault = true }\nlocal function py_memo_call(p, fn, src)\n    if not (src and p and p:type() == 'call' and fn:type() == 'attribute' and p:field('function')[1] == fn) then return false end\n    local nm = fn:field('attribute')[1]\n    return nm ~= nil and PY_MEMO[node_text(nm, src)] == true\nend\nlocal function python_is_write(c, n, src)"},"verb":"edit","touched":["lua/cartograph/spec/python.lua"]}},{"bytes":116,"decided_by":"tactic","id":"1791491719.679012-edit","decisions":[],"verb":"edit","invocation":{"args":{"before":"    if not p then return false end\n    local pt = p:type()\n    if pt == 'assignment' or pt == 'augmented_assignment' then","after":"    if not p then return false end\n    local pt = p:type()\n    -- (the receiver IS the mention: a dynamic key of it, `'[]'` — the capture would name `setdefault` the field)\n    if py_memo_call(p, cur, src) then return true, cur:field('object')[1] == c and '[]' or nil end\n    if pt == 'assignment' or pt == 'augmented_assignment' then","file":"lua/cartograph/spec/python.lua"},"verb":"edit","touched":["lua/cartograph/spec/python.lua"]}},{"bytes":130,"decided_by":"tactic","id":"1791491719.744189-edit","decisions":[],"verb":"edit","invocation":{"args":{"before":"    -- `x = x or v`\n    rhs_setonce = function (top, src, chain)\n        local p = top:parent()","after":"    -- `x = x or v`, and the memo call `d.setdefault(k, v)` (CART-1585)\n    rhs_setonce = function (top, src, chain)\n        local p = top:parent()\n        if py_memo_call(p, top, src) then return true end","file":"lua/cartograph/spec/python.lua"},"verb":"edit","touched":["lua/cartograph/spec/python.lua"]}},{"bytes":1336,"decided_by":"tactic","id":"1791491744.410406-edit","decisions":[],"verb":"edit","invocation":{"args":{"before":"    eq(nil, gw_of(data, 'M::reader', 'rd'), 'get is a read: no gw')\nend)","after":"    eq(nil, gw_of(data, 'M::reader', 'rd'), 'g