#!/usr/bin/env bash
# cartograph pre-commit fence ([[cartograph-shipping-checklist]] / bench:
# "the seam fence only fences if it runs"). Five gates, CHEAPEST FIRST so a
# failure costs 70ms rather than 22s (~23s total when all five pass):
#
#   1. docaudit — the DOC FENCE: a :Cartograph name our own docs still claim
#      but nothing registers, a language count that contradicts the spec
#      roster, or a GROWING helpdoc coverage gap (the ratchet) fails the commit.
#   2. navaudit — the NAV FENCE: a SURFACE that reads whole-graph facts but
#      cannot say they are ABSENT (i.e. would render a fabricated "none" on a
#      thin index), an altitude with no concern disposition, a concern with an
#      untyped empty, or an altitude nobody decided about for hover. The unit is
#      the surface, not the verb — that distinction is why this exists.
#   3. langaudit — the LANGUAGE FENCE: a module that declares `@langs` and then
#      compares a node type ONE of those grammars does not have. Four such
#      assumptions shipped in a single arc, one of them silently unsound, and
#      none was caught by a test — the suite is lua-only, so a ruby-shaped hole
#      leaves it green. 1.4s.
#   4. dogfood — the BAND SEAM-GUARD (a raw wide-index read outside band.lua/
#      store.lua fails the commit) + the self-serving / lint dashboard.
#   5. the full spec suite (tests/run.sh).
#
# Gate 0 runs before all five and needs no nvim: the index must BE the tree they test (see below). The
# message is fenced separately by commit-msg (tools/refcheck.py), and an agent's --no-verify by the
# Claude Code guard tools/claude-guard.py.
#
# Checked in under .githooks/ and activated per-clone with
#   git config core.hooksPath .githooks
# (tools/install-hooks.sh does this). Bypass a single commit with
#   git commit --no-verify
# for a WIP checkpoint — the same gates guard the eventual push.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
NVIM="${NVIM:-nvim}"

# 0. THE TESTED TREE IS THE COMMITTED TREE. Gates 1-5 read the WORKING TREE, so a tracked file with unstaged
#    changes, or a new file never added, passes them and is then committed without (harness #44/#57: an amend
#    committed a stale index the gates had never seen). Refused here, before anything slow. To commit part of
#    a change, commit it from a worktree checked out at HEAD.
unstaged="$(git diff --name-only)"
untracked="$(git ls-files --others --exclude-standard -- lua plugin tests tools doc examples .claude .githooks)"
if [ -n "$unstaged$untracked" ]; then
    echo "[pre-commit] blocked — the gates would test a tree this commit does not contain:"
    if [ -n "$unstaged" ]; then printf '  unstaged:  %s\n' $unstaged; fi
    if [ -n "$untracked" ]; then printf '  untracked: %s\n' $untracked; fi
    echo "[pre-commit] git add them (or drop them), or commit the part from a worktree at HEAD"
    exit 1
fi

if ! command -v "$NVIM" >/dev/null 2>&1; then
    echo "[pre-commit] $NVIM not found — skipping (set NVIM= or --no-verify)"; exit 0
fi

fail=0
step () { # label, cmd...
    local label="$1"; shift
    printf '[pre-commit] %-28s ' "$label …"
    local out
    if out="$("$@" 2>&1)"; then
        echo ok
    else
        echo FAIL
        # the FAILING TESTS first: a tail alone ends in the passing tests of the last spec, and an intermittent
        # failure's name was lost three times that way (CART-1293); the whole output is kept beside the hook
        printf '%s\n' "$out" | grep -A4 '^  FAIL' || true
        printf '%s\n' "$out" | tail -30
        printf '%s\n' "$out" > "$(git rev-parse --git-dir)/pre-commit-last.log"
        echo "[pre-commit] full output: $(git rev-parse --git-dir)/pre-commit-last.log"
        fail=1
    fi
}

step "doc audit" "$NVIM" --headless -u NONE -l tools/docaudit.lua
step "nav audit" "$NVIM" --headless -u NONE -l tools/navaudit.lua
step "language fence" "$NVIM" --headless -u NONE -l tools/langaudit.lua
step "dogfood seam fence" "$NVIM" --headless -u NONE -l tools/dogfood.lua
step "spec suite" bash tests/run.sh

if [ "$fail" -ne 0 ]; then
    echo "[pre-commit] blocked — fix the above, or 'git commit --no-verify' to bypass"
    exit 1
fi
echo "[pre-commit] clean"
