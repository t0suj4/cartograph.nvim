#!/usr/bin/env bash
# cartograph pre-commit fence ([[cartograph-shipping-checklist]] / bench:
# "the seam fence only fences if it runs"). Four gates, CHEAPEST FIRST so a
# failure costs 70ms rather than 22s (~22s total when all four pass):
#
#   1. docaudit — the DOC FENCE: a :Cartograph name our own docs still claim
#      but nothing registers, a language count that contradicts the spec
#      roster, or a GROWING helpdoc coverage gap (the ratchet) fails the commit.
#   2. navaudit — the NAV FENCE: a SURFACE that reads whole-graph facts but
#      cannot say they are ABSENT (i.e. would render a fabricated "none" on a
#      thin index), an altitude with no concern disposition, a concern with an
#      untyped empty, or an altitude nobody decided about for hover. The unit is
#      the surface, not the verb — that distinction is why this exists.
#   3. dogfood — the BAND SEAM-GUARD (a raw wide-index read outside band.lua/
#      store.lua fails the commit) + the self-serving / lint dashboard.
#   4. the full spec suite (tests/run.sh).
#
# Checked in under .githooks/ and activated per-clone with
#   git config core.hooksPath .githooks
# (tools/install-hooks.sh does this). Bypass a single commit with
#   git commit --no-verify
# for a WIP checkpoint — the same gates guard the eventual push.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
NVIM="${NVIM:-nvim}"

if ! command -v "$NVIM" >/dev/null 2>&1; then
    echo "[pre-commit] $NVIM not found — skipping (set NVIM= or --no-verify)"; exit 0
fi

fail=0
step () { # label, cmd...
    local label="$1"; shift
    printf '[pre-commit] %-28s ' "$label …"
    local out
    if out="$("$@" 2>&1)"; then
        echo ok
    else
        echo FAIL
        printf '%s\n' "$out" | tail -30
        fail=1
    fi
}

step "doc audit" "$NVIM" --headless -u NONE -l tools/docaudit.lua
step "nav audit" "$NVIM" --headless -u NONE -l tools/navaudit.lua
step "dogfood seam fence" "$NVIM" --headless -u NONE -l tools/dogfood.lua
step "spec suite" bash tests/run.sh

if [ "$fail" -ne 0 ]; then
    echo "[pre-commit] blocked — fix the above, or 'git commit --no-verify' to bypass"
    exit 1
fi
echo "[pre-commit] clean"
