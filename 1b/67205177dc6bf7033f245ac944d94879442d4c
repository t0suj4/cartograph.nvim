 = text }), nodes = {}, edges = {} }\n    local s = K.attach(data)\n    eq({\n        { 'debug-listener', 16, 'Deployment/cdc init container seed starts a JDWP debugger listening on all interfaces (0.0.0.0:8000): remote code execution for anything that reaches the pod' },\n        { 'debug-listener', 21, 'Deployment/cdc container app starts a JDWP debugger listening on all interfaces (*:7897): remote code execution for anything that reaches the pod' },\n        { 'jmx-unauthenticated', 23, 'Deployment/cdc container app opens remote JMX on port 9010 with authentication off and SSL off: anything that reaches the pod can invoke MBeans' },\n    }, vim.tbl_map(function (x) return { x.finding, x.line, x.message } end, s.exposed))\n    -- and the agent verb serves them as findings, at their file and line\n    local d = require('cartograph.agent').answer({ data = data }, 'k8s_findings', {})\n    local got = {}\n    for _, r in ipairs(d.result) do if r.finding == 'debug-listener' or r.finding == 'jmx-unauthenticated' then got[#got + 1] = r.file .. ':' .. r.line end end\n    eq({ 'all.yaml:16', 'all.yaml:21', 'all.yaml:23' }, got)\nend)","before":"    local r2 = agent.answer(store, 'k8s_traces', {})\n    eq('no-address', r2.refusal.rule)\nend)","file":"tests/k8s_spec.lua"},"verb":"edit","touched":["tests/k8s_spec.lua"]},"id":"1791031182.942057-edit","bytes":3812,"decided_by":"tactic"},{"decisions":[],"verb":"edit","invocation":{"args":{"file":"lua/cartograph/k8s.lua","before":"file = e.rel, line = line_of('jdwp'),","after":"file = e.rel, line = line_of(x.jdwp),"},"verb":"edit","touched":["lua/cartograph/k8s.lua"]},"id":"1791031208.312877-edit","bytes":124,"decided_by":"tactic"},{"decisions":[],"verb":"edit","invocation":{"args":{"after":"file = e.rel, line = line_of('jmxremote.port=' .. x.jmx),","before":"file = e.rel, line = line_of('jmxremote.authenticate=false'),","file":"lua/cartograph/k8s.lua"},"verb":"edit","touched":["lua/cartograph/k8s.lua"]},"id":"1791031208.383788-e