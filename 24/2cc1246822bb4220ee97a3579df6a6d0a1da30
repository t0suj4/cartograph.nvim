":{"before":"    macro_text = 'SCOPE&KEY',","after":"    macro_text = 'SCOPE&KEY',\n    -- declaration(def, src) -> bool: the def only DECLARES a function implemented elsewhere (a LuaLS `---@meta` stub,\n    -- CART-1615) — its body is not the callee's effects\n    declaration = 'SCOPE&KEY',","file":"lua/cartograph/spec/contract.lua"}},"verb":"edit","id":"1791571564.216860-edit"},{"invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"before":"                    derived = not aname and M._derived_of(defn, src, spec.guards) or nil,","after":"                    derived = not aname and M._derived_of(defn, src, spec.guards) or nil,\n                    -- a DECLARATION only (CART-1615): a call to it links (goto-declaration), but its empty body is not\n                    -- the callee's effects\n                    decl = spec.declaration and spec.declaration(defn, src) or nil,","file":"lua/cartograph/providers/treesitter.lua"}},"verb":"edit","id":"1791571564.586402-edit"},{"invocation":{"touched":["lua/cartograph/effects.lua"],"verb":"edit","args":{"before":"                for _, c in ipairs(store.topo():sites(fid)) do\n                    local to = callrec.to(c)\n                    if to and con.comp[to] == ci then","after":"                for _, c in ipairs(store.topo():sites(fid)) do\n                    local to = callrec.to(c)\n                    -- (a call to a DECLARATION — a `---@meta` stub — is a call to what it declares: its empty body is\n                    -- not that function's effects, so the signature registry or the unresolved hedge answers, CART-1615)\n                    if to then local tn = store.node(to); if tn and tn.decl then to = nil end end\n                    if to and con.comp[to] == ci then","file":"lua/cartograph/effects.lua"}},"verb":"edit","id":"1791571573.308770-edit"},{"invocation":{"touched":["lua/cartograph/effects.lua"],"verb":"edit","args":{"before":"            for _, fid in ipairs(members) do\n                local fnode = store.node(fid)\n                for _, u in ipairs(store.topo():var_uses_detail(fid)) do","after":"            for _, fid in ipairs(members) do\n                local fnode = store.node(fid)\n                -- (a DECLARATION's own effects are its implementation's, which the tree does not hold, CART-1615)\n                if fnode and fnode.decl then s_hedge(sum, ('declaration only: %s'):format(fnode.name or fid)) end\n                for _, u in ipairs(store.topo():var_uses_detail(fid)) do","file":"lua/cartograph/effects.lua"}},"verb":"edit","id":"1791571581.055343-edit"},{"invocation":{"touched":["lua/cartograph/cache.lua"],"verb":"edit","args":{"before":"M.VERSION = 262 -- v262:","after":"M.VERSION = 263 -- v263: a lua function with an EMPTY body in a ---@meta file is a DECLARATION (node field decl): effects never read its body as the callee's (CART-1615). v262:","file":"lua/cartograph/cache.lua"}},"verb":"edit","id":"1791571586.086322-edit"},{"invocation":{"touched":["lua/cartograph/effects.lua"],"verb":"edit","args":{"before":"                    -- not that function's effects, so the signature registry or the unresolved hedge answers, CART-1615)\n                    if to then local tn = store.node(to); if tn and tn.decl then to = nil end end","after":"                    -- not that function's effects, so the signature registry or the unresolved hedge answers — under\n                    -- the DECLARED name, which resolution already canonicalized (`api.x` -> `vim.api.x`), CART-1615)\n                    local declname\n                    if to then local tn = store.node(to); if tn and tn.decl then declname, to = tn.name, nil end end","file":"lua/cartograph/effects.lua"}},"verb":"edit","id":"1791571668.298802-edit"},{"invocation":{"touched":["lua/cartograph/effects.lua"],"verb":"edit","args":{"before":"                        local bname = callrec.full(c) or callrec.callee(c)\n                        local sig, grade","after":"                        local bname = declname or callrec.full(c) or callrec.callee(c)\n                        local sig, grade","file":"lua/cartograph/effects.lua"}},"verb":"edit","id":"1791571668.388972-edit"},{"invocation":{"touched":["tests/fixpoint_spec.lua"],"verb":"edit","args":{"before":"    eq('pure', effects.purity(store, by.lit.id), 'a literal at the param: no call happens, no hedge')\nend)","after":"    eq('pure', effects.purity(store, by.lit.id), 'a literal at the param: no call happens, no hedge')\nend)\n\n-- ⚠ A ---@meta STUB IS A DECLARATION, NOT THE CALLEE'S BODY (CART-1615): 832 runtime call edges land on\n-- vim/_meta/api.gen.lua's `function vim.api.x(a, b) end`, and the empty body read every caller pure. The tag alone is\n-- not the class — nvim-treesitter's vendored async.lua is real code under `---@meta …` — so only an EMPTY body declares\ntest('effects: a call bound to a ---@meta stub is a call to what it declares — the declared name answers, never the empty body', function ()\n    if not ready() then skip 'no lua parser' end\n    local root = vim.fn.tempname()\n    vim.fn.mkdir(root .. '/vim/_meta', 'p')\n    local function put(f, t) local fd = assert(io.open(root .. '/' .. f, 'w')); fd:write(t); fd:close() end\n    put('vim/_meta/api.lua', table.concat({\n        '--- @meta _',\n        'function vim.api.nvim_buf_set_lines(buffer, start) end',\n        'function vim.api.nvim_tagged_real(tbl) tbl.hit = true end',\n    }, '\\n'))\n    put('paint.lua', table.concat({\n        'local api = vim.api',\n        'local function paint(buffer) api.nvim_buf_set_lines(buffer, 0) end',\n        'local function noop_stub(x) end',\n        'return { paint, noop_stub }',\n    }, '\\n'))\n    store.ingest(ts.extract(root))\n    local by = {}\n    for _, n in ipairs(store.data.nodes) do by[n.name] = n end\n    ok(by['vim.api.nvim_buf_set_lines'].decl, 'an empty body in a ---@meta file declares')\n    ok(not by['vim.api.nvim_tagged_real'].decl, 'a body under the tag is code')\n    ok(not by.noop_stub.decl, 'an empty body outside a ---@meta file is a no-op, not a declaration')\n    local lk = store.topo():sites(by.paint.id)\n    eq(by['vim.api.nvim_buf_set_lines'].id, lk[1] and callrec.to(lk[1]), 'the call links to the declaration')\n    eq('io', effects.purity(store, by.paint.id), 'the declared name vim.api.* is IO — not the empty body pure')\n    eq('pure~', effects.purity(store, by['vim.api.nvim_buf_set_lines'].id), 'a declaration hedges its own effects')\n    eq('pure', effects.purity(store, by.noop_stub.id))\nend)","file":"tests/fixpoint_spec.lua"}},"verb":"edit","id":"1791571696.503341-edit"},{"invocation":{"touched":["tests/fixpoint_spec.lua"],"verb":"edit","args":{"before":"    local lk = store.topo():sites(by.paint.id)","after":"    local callrec = require 'cartograph.callrec'\n    local lk = store.topo():sites(by.paint.id)","file":"tests/fixpoint_spec.lua"}},"verb":"edit","id":"1791571702.008896-edit"},{"invocation":{"touched":["tests/fixpoint_spec.lua"],"verb":"edit","args":{"before":"        '--- @meta _',\n        'function vim.api.nvim_buf_set_lines(buffer, start) end',","after":"        '-- (a header comment may precede the tag)',\n        '--- @meta _',\n        'function vim.api.nvim_buf_set_lines(buffer, start) end',","file":"tests/fixpoint_spec.lua"}},"verb":"edit","id":"1791571735.339423-edit"},{"invocation":{"touched":[".claude/skills/cartograph/references/questions.md"],"verb":"edit","args":{"before":"| Is this function PURE — does calling it write module state, the world (io), or the tables it was handed? And if not, WHY not? | `require('cartograph.effects').purity(store, fn_id)` → `pure` / `io` / `writes`, with `~` when hedged; `effects.summaries(store)[fn_id]` holds the reasons: `w` (module keys written), `pwx` (its own params mutated), `h` (the HEDGES, capped at 4 — removing one can surface another), `mh` (a method matched to a builtin by name); `effects.purity_census(store)` counts the 