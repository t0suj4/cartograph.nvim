{"open_intents":[],"entries":[{"bytes":3174,"decided_by":"tactic","invocation":{"touched":["lua/cartograph/spec/rust.lua"],"verb":"edit","args":{"before":"return {\n    guards = RUST_GUARDS,","file":"lua/cartograph/spec/rust.lua","after":"-- ── LEXICAL SCOPES (CART-1598, rust) ──────────────────────────────────────────────────────────────────────────────\n-- rust declared no scope model, so the cross-file unique join claimed every param and local. A pattern binds its\n-- identifier leaves — never a tuple-struct / struct pattern's TYPE (`Some` in `Some(x)`), a scoped path or a field\n-- NAME (`P { r: rr }` binds rr; the shorthand `P { q }` binds q). A function / closure binds its params, a block its\n-- `let`s from the declaring row, and `for` / `if let` / `while let` / a match arm their patterns.\nlocal function rs_pattern_names(p, src, out, row)\n    if not p then return end\n    local t = p:type()\n    if t == 'identifier' or t == 'shorthand_field_identifier' then out[node_text(p, src)] = { row = row }\n    elseif t == 'field_pattern' then\n        local sub = p:field('pattern')[1]\n        if sub then rs_pattern_names(sub, src, out, row) else rs_pattern_names(p:field('name')[1], src, out, row) end\n    elseif t == 'tuple_pattern' or t == 'tuple_struct_pattern' or t == 'struct_pattern' or t == 'slice_pattern'\n        or t == 'ref_pattern' or t == 'mut_pattern' or t == 'or_pattern' or t == 'captured_pattern'\n        or t == 'match_pattern' or t == 'reference_pattern' then\n        local ty = p:field('type')[1]\n        for _, c in inext, p, -1 do\n            if c:named() and c ~= ty then rs_pattern_names(c, src, out, row) end\n        end\n    end\nend\nlocal function rs_params(node, src, out)\n    local ps = node:field('parameters')[1]\n    if not ps then return end\n    for _, c in inext, ps, -1 do\n        if c:type() == 'parameter' then rs_pattern_names(c:field('pattern')[1], src, out)\n        elseif c:named() and c:type() ~= 'self_parameter' then rs_pattern_names(c, src, out) end -- (a closure's bare `mut cq`)\n    end\nend\nlocal function rs_block(node, src, out)\n    for _, st in inext, node, -1 do\n        if st:type() == 'let_declaration' then rs_pattern_names(st:field('pattern')[1], src, out, (select(1, st:range()))) end\n    end\nend\nlocal function rs_lets(node, src, out) -- a `for` pattern, an `if let` / `while let` condition (let chains too), a match arm\n    if node:type() == 'match_arm' or node:type() == 'for_expression' then rs_pattern_names(node:field('pattern')[1], src, out) return end\n    local function conds(c)\n        if not c then return end\n        if c:type() == 'let_condition' then rs_pattern_names(c:field('pattern')[1], src, out)\n        elseif c:type() == 'let_chain' then for _, k in inext, c, -1 do conds(k) end end\n    end\n    conds(node:field('condition')[1])\nend\nlocal RUST_LEXICAL_SCOPES = {\n    function_item = { kind = 'param', harvest = rs_params }, closure_expression = { kind = 'param', harvest = rs_params },\n    block = { kind = 'local', harvest = rs_block },\n    for_expression = { kind = 'local', harvest = rs_lets }, if_expression = { kind = 'local', harvest = rs_lets },\n    while_expression = { kind = 'local', harvest = rs_lets }, match_arm = { kind = 'local', harvest = rs_lets },\n}\n-- the call-argument gate's binders (fn.locals): every binder of the body, closures INCLUDED (an over-wide set only\n-- refuses a by-name link — and a closure assigned to a `let` mints no node: its calls are the enclosing fn's)\nlocal function rs_fn_locals(def, src, out)\n    local function walk(n)\n        for _, c in inext, n, -1 do\n            local e = RUST_LEXICAL_SCOPES[c:type()]\n            if e then e.harvest(c, src, out) end\n            walk(c)\n        end\n    end\n    local body = def:field('body')[1]\n    if body then rs_block(body, src, out); walk(body) end\nend\n\nreturn {\n    lexical_scopes = RUST_LEXICAL_SCOPES, -- CART-1598\n    fn_locals = rs_fn_locals,\n    guards = RUST_GUARDS,"}},"decisions":[],"verb":"edit","id":"1791501807.058512-edit"},{"bytes":293,"decided_by":"tactic","invocation":{"touched":["lua/cartograph/spec/rust.lua"],"verb":"edit","args":{"before":"    if t == 'identifier' or t == 'shorthand_field_identifier' then out[node_text(p, src)] = { row = row }","after":"    if t == 'identifier' or t == 'shorthand_field_identifier' then\n        -- (a CAPITALISED identifier in a pattern is a variant / const being MATCHED — `None`, `MAX` —, never a binding)\n        local nm = node_text(p, src)\n        if not nm:match('^%u') then out[nm] = { row = row } end","file":"lua/cartograph/spec/rust.lua"}},"decisions":[],"verb":"edit","id":"1791501821.453427-edit"},{"bytes":581,"decided_by":"tactic","invocation":{"touched":["lua/cartograph/spec/tsutil.lua"],"verb":"edit","args":{"before":"--- is_write's READS answer for an update_expression `u` (the third value, see spec/contract.lua)","after":"--- the names of `set` that a subtree mentions as a bare `identifier` -> { name = true } | nil (a binding's SELF-INIT:\n--- rust's `let x = x()`, go's `x := x()` call the OUTER x — the binding starts after its initializer, CART-1598)\nfunction M.mentions_of(node, src, set)\n    local hit\n    local function walk(n)\n        if n:type() == 'identifier' then\n            local t = M.node_text(n, src)\n            if set[t] then hit = hit or {}; hit[t] = true end\n        end\n        for _, c in M.inext, n, -1 do walk(c) end\n    end\n    if node then walk(node) end\n    return hit\nend\n--- is_write's READS answer for an update_expression `u` (the third value, see spec/contract.lua)","file":"lua/cartograph/spec/tsutil.lua"}},"decisions":[],"verb":"edit","id":"1791501928.606213-edit"},{"bytes":736,"decided_by":"tactic","invocation":{"touched":["lua/cartograph/spec/rust.lua"],"verb":"edit","args":{"before":"-- the call-argument gate's binders (fn.locals): every binder of the body, closures INCLUDED (an over-wide set only\n-- refuses a by-name link — and a closure assigned to a `let` mints no node: its calls are the enclosing fn's)\nlocal function rs_fn_locals(def, src, out)\n    local function walk(n)\n        for _, c in inext, n, -1 do\n            local e = RUST_LEXICAL_SCOPES[c:type()]\n            if e then e.harvest(c, src, out) end\n            walk(c)\n        end\n    end\n    local body = def:field('body')[1]\n    if body then rs_block(body, src, out); walk(body) end\nend","after":"-- the call-argument / callee gate's binders (fn.locals). That gate is POSITION-BLIND — a name in fn.locals shadows\n-- every call of it anywhere in the function — so it gets only the binders visible across the body: the params, the\n-- TOP block's `let`s (not one whose initializer names itself: `let x = x()` calls the outer x) and a closure's\n-- params (a closure assigned to a `let` mints no node, its calls are the enclosing fn's). A nested block's, a match\n-- arm's, an `if let`'s binding stays out: cargo's `match registry(…) { Ok((registry, _)) => … }` had refused\n-- the call by the ARM's name.\nlocal function rs_fn_locals(def, src, out)\n    rs_params(def, src, out)\n    local body = def:field('body')[1]\n    if not body then return end\n    for _, st in inext, body, -1 do\n        if st:type() == 'let_declaration' then\n            local names = {}\n            rs_pattern_names(st:field('pattern')[1], src, names)\n            local self = tsutil.mentions_of(st:field('value')[1], src, names) or {}\n            for nm in pairs(names) do if not self[nm] then out[nm] = {} end end\n        end\n    end\n    local function closures(n)\n        for _, c in inext, n, -1 do\n            if c:type() == 'closure_expression' then rs_params(c, src, out) end\n            closures(c)\n        end\n    end\n    closures(body)\nend","file":"lua/cartograph/spec/rust.lua"}},"decisions":[],"verb":"edit","id":"1791501928.671739-edit"},{"bytes":1221,"decided_by":"tactic","invocation":{"touched":["lua/cartograph/spec/go.lua"],"verb":"edit","args":{"before":"-- the call-argument gate's local binders (fn.locals, CART-1597's hook): every binder of the body, a func_literal's\n-- INCLUDED — `f := func(p int) { use(p) }` mints no node of its own, so its calls are the enclosing function's (an\n-- over-wide set only REFUSES a by-name link: the safe direction)\nlocal function go_fn_locals(def, src, out)\n    local function walk(n)\n        for _, c in tsutil.inext, n, -1 do\n            local e = GO_LEXICAL_SCOPES[c:type()]\n            if e then e.harvest(c, src, out) end\n            walk(c)\n        end\n    end\n    go_params(def, src, out) -- (the receiver and named results: fn.params holds only the parameter list)\n    local body = def:field('body')[1]\n    if body then walk(body); go_block(body, src, out) end\nend","file":"lua/cartograph/spec/go.lua","after":"-- the call-argument / callee gate's binders (fn.locals, CART-1597's hook). That gate is POSITION-BLIND — a name in\n-- fn.locals shadows every call of it in the function — so it gets only the binders visible across the body: the\n-- receiver, params and named results (fn.params holds only the parameter list), the TOP block's `:=` / `var` /\n-- `const` (not one whose initializer names itself: `x := x()` calls the outer x) and a func_literal's params\n-- (`f := func(p int) { use(p) }` mints no node: its calls are the enclosing fn's). A nested block's or a control\n-- statement's binder stays out (cargo's match-arm case, CART-1598 rust).\nlocal function go_fn_locals(def, src, out)\n    go_params(def, src, out)\n    local body = def:field('body')[1]\n    if not body then return end\n    local function top(st)\n        local names = {}\n        go_decl(st, src, names)\n        local val = st:field('right')[1] or st\n        if st:type() ~= 'short_var_declaration' then val = st end\n        local self = tsutil.mentions_of(st:type() == 'short_var_declaration' and st:field('right')[1] or nil, src, names) or {}\n        for nm in pairs(names) do if not self[nm] then out[nm] = {} end end\n    end\n    for _, c in tsutil.inext, body, -1 do\n        if c:type() == 'statement_list' then for _, s in tsutil.inext, c, -1 do top(s) end else top(c) end\n    end\n    local function lits(n)\n        for _, c in tsutil.inext, n, -1 do\n            if c:type() == 'func_literal' then go_params(c, src, out) end\n            lits(c)\n        end\n    end\n    lits(body)\nend"}},"decisions":[],"verb":"edit","id":"1791501940.574572-edit"},{"bytes":116,"decided_by":"tactic","invocation":{"touched":["lua/cartograph/argv.lua"],"verb":"edit","args":{"before":"local FOLDABLE = { k = true, name = true, v = true, prefix = true,\n    kw = true, to = true, l = true, up = true } -- up is read pre-fold, ignored","after":"local FOLDABLE = { k = true, name = true, v = true, prefix = true,\n    kw = true, to = true, l = true, up = true, bound = true } -- up / bound are read pre-fold (resolution), ignored","file":"lua/cartograph/argv.lua"}},"decisions":[],"verb":"edit","id":"1791502022.496341-edit"},{"bytes":290,"decided_by":"tactic","invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"before":"                            elseif ak == 'local' then\n                                args[#args + 1] = ''\n                                argv[#argv + 1] = { k = 'local', name = node_text(a, src),\n                                    l = select(1, a:range()) }","after":"                            elseif ak == 'local' then\n                                args[#args + 1] = ''\n                                local an = node_text(a, src)\n                                -- (BOUND at its own site — a param / local the scope model sees there: the callback upgrade\n                                -- never joins it to ANOTHER file's function, the mention rule's veto — CART-1598)\n                                argv[#argv + 1] = { k = 'local', name = an, l = select(1, a:range()),\n                                    bound = jvt_sm and select(2, jvt_sm.resolve(an, a)) > 0 or nil }","file":"lua/cartograph/providers/treesitter.lua"}},"decisions":[],"verb":"edit","id":"1791502053.243044-edit"},{"bytes":224,"decided_by":"tactic","invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"before":"M._mention_field = mention_field","after":"M._mention_field = mention_field\n--- is identifier `a` (named `an`) bound at its own site to a VALUE — the nearest binder the scope model sees there,\n--- not one that IS a function definition (lua's `local function f`)? -> true | nil. An argument bound so is that\n--- binding: the callback upgrade never joins it to a function by name, same file or not (CART-1598)\nfunction M._bound_value(an, a)\n    if not jvt_sm then return nil end\n    local chain, k = jvt_sm.resolve(an, a)\n    if k == 0 or chain[1].fn then return nil end\n    return true\nend","file":"lua/cartograph/providers/treesitter.lua"}},"decisions":[],"verb":"edit","id":"1791502342.613453-edit"},{"bytes":763,"decided_by":"tactic","invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"before":"--- is identifier `a` (named `an`) bound at its own site to a VALUE — the nearest binder the scope model sees there,\n--- not one that IS a function definition (lua's `local function f`)? -> true | nil. An argument bound so is that\n--- binding: the callback upgrade never joins it to a function by name, same file or not (CART-1598)\nfunction M._bound_value(an, a)\n    if not jvt_sm then return nil end\n    local chain, k = jvt_sm.resolve(an, a)\n    if k == 0 or chain[1].fn then return nil end\n    return true\nend","file":"lua/cartograph/providers/treesitter.lua","after":"--- is identifier `a` (named `an`) BOUND at its own site — the nearest binder the scope model sees there? -> that\n--- binder's DECLARATION ROW (-1 for a param: scope-wide), or nil when free. An argument bound so is that binding: the\n--- callback upgrade joins it to no function by name — except the same-file def that starts ON that row, which the\n--- binder IS (`local function f`, `local f = function`, java's `Function<A, B> KEY = v -> …`) (CART-1598)\nfunction M._bound_value(an, a)\n    if not jvt_sm then return nil end\n    local chain, k = jvt_sm.resolve(an, a)\n    if k == 0 then return nil end\n    return chain[1].at or chain[1].row or -1\nend\n--- the callback upgrade's veto for a bound argument (above): every target but the def its binder declares\nfunction M._bound_veto(bound, t2, file)\n    return bound ~= nil and not (t2.file == file and t2.order == bound)\nend"}},"decisions":[],"verb":"edit","id":"1791502658.509632-edit"},{"bytes":123,"decided_by":"tactic","invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"before":"                    and not a.bound -- (bound at its site to a value: never a function by name, CART-1598)","file":"lua/cartograph/providers/treesitter.lua","after":"                    and not M._bound_veto(a.bound, t2, p.file) -- (bound at its site: never a function by name, CART-1598)"}},"decisions":[],"verb":"edit","id":"1791502658.866016-edit"},{"bytes":111,"decided_by":"tactic","invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"before":"                    and not cv.aget(i, j, 'bound') -- (bound at its site to a value, CART-1598)","after":"                    and not M._bound_veto(cv.aget(i, j, 'bound'), t2, cfile) -- (bound at its site, CART-1598)","file":"lua/cartograph/providers/treesitter.lua"}},"decisions":[],"verb":"edit","id":"1791502659.250844-edit"},{"bytes":130,"decided_by":"tactic","invocation":{"touched":["lua/cartograph/providers/treesitter.lua"],"verb":"edit","args":{"before":"                                -- (BOUND at its own site to a VALUE — a param / local the scope model sees there, not a binder\n                                -- that IS a def: the callback upgrade never joins it to a function by name — CART-1598)","file":"lua/cartograph/providers/treesitter.lua","after":"                                -- (BOUND at its own site — a param / local the scope model sees there: the callback upgrade\n                                -- joins it to no function by name but the def its binder declares, M._bound_value — CART-1598)"}},"decisions":[],"verb":"edit","id":"1791502659.730669-edit"},{"bytes":322,"decided_by":"tactic","invocation":{"touched":["lua/cartograph/spec/java.lua"],"verb":"edit","args":{"before":"                    if nm then out[node_text(nm, src)] = { ty = ty } end\n                end\n            end\n        end\n    end\nend","after":"                    -- (`at`: the DECLARATION row — not `row`, a field is visible above it — so a lambda-valued field\n                    -- `Function<A, B> KEY = v -> …` is the def an argument KEY names, CART-1598)\n                    if nm then out[node_text(nm, src)] = { ty = ty, at = select(1, c:range()) } end\n                end\n            end\n        end\n    end\nend","file":"lua/cartograph/spec/java.lua"}},"decisions":[],"verb":"edit","id":"1791502667.722102-edit"},{"bytes":2062,"decided_by":"tactic","invocation":{"touched":["tests/treesitter_spec.lua"],"verb":"edit","args":{"before":"test('defs: a lua table-FIELD function is cbarg; a local function is not (the field_fn_cbarg set, CART-1592)', function ()","file":"tests/treesitter_spec.lua","after":"-- ⚠ A BOUND ARGUMENT IS ITS BINDING (CART-1598): the callback upgrade joins it to no function by name — same file\n-- included (hugo's `for key, v := range …` passed `key` and reached the method TemplateStore.key) — but the def its\n-- binder DECLARES, which starts on the binder's own row: java's `Function<A, B> KEY = v -> …`, lua's local function.\ntest('refs: a bound argument names only the def its binder declares (java lambda field, lua local function; go range var) (CART-1598)', function ()\n    local function refs_of(data, file)\n        local byid, out = {}, {}\n        for _, n in ipairs(data.nodes) do byid[n.id] = n end\n        for _, e in ipairs(data.edges) do\n            if e.kind == 'ref' and byid[e.to] and (byid[e.from] or { file = e.from }).file == file then out[byid[e.to].name] = true end\n        end\n        return out\n    end\n    if has_parser('java') then\n        local r = refs_of(ts.extract(mkroot('P.java', table.concat({\n            'import java.util.function.Function;',\n            'class P {',\n            '    private static final Function<String, Integer> KEYF = v -> v.length();',\n            '    int run(java.util.List<String> xs) { InvocationHandler hnd = (p, m, a) -> null; use(hnd); return xs.stream().map(KEYF).count(); }',\n            '}',\n        }, '\\n'))), 'P.java')\n        ok(r['P::KEYF'], 'a lambda-valued FIELD passed as an argument is that def: ' .. vim.inspect(r))\n    end\n    local lr = refs_of(ts.extract(mkroot('l.lua', table.concat({\n        'local function cmpf(a, b) return a < b end',\n        'local sortf = function (t) table.sort(t, cmpf) end',\n        'local function g(t) return pcall(sortf, t) end',\n        'return g',\n    }, '\\n'))), 'l.lua')\n    ok(lr.cmpf and lr.sortf, 'lua: a local function / a local bound to a function is that def: ' .. vim.inspect(lr))\n    if has_parser('go') then\n        local gr = refs_of(ts.extract(mkroot('k.go', table.concat({\n            'package m', 'type S struct{}', 'func (s *S) key(d string) string { return d }',\n            'func (s *S) all(xs map[string]int) { for key, v := range xs { use(key, v) } }',\n        }, '\\n'))), 'k.go')\n        ok(not gr['S.key'], 'go: a range var passed as an argument is not the method of its name: ' .. vim.inspect(gr))\n    end\nend)\n\ntest('defs: a lua table-FIELD function is cbarg; a local function is not (the field_fn_cbarg set, CART-1592)', function ()"}},"decisions":[],"verb":"edit","id":"1791502916.908992-edit"},{"bytes":115,"decided_by":"tactic","invocation":{"touched":["lua