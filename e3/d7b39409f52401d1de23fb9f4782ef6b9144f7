 then","file":"tools/clones.lua"}},"decided_by":"tactic"},{"bytes":722,"id":"1791106867.865592-edit","decisions":[],"verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/commands/clones.lua"],"args":{"before":"    -- ── clone findings as in-buffer signs (the interactive surface) ──","file":"lua/cartograph/commands/clones.lua","after":"    -- ── subterm clones: variants below the statement row (CART-1426) ──\n    cmd('CartographSubtermClones', function (o)\n        local store = live() if not store then return end\n        vim.notify('cartograph: scanning for subterm clones (hashing modulo alpha)…', vim.log.levels.INFO)\n        local cl = require 'cartograph.clones'\n        scratch(cl.subterms_report(cl.subterms(store, { min_nodes = o.count ~= -1 and o.count or 12 })))\n    end, { count = -1, desc = 'cartograph: subterm clone groups — an expression, condition or constructor below the statement row that is a variant (locals renamed) of one in another function; maximal classes only, ranked by spread. [count] = min nodes (default 12)' })\n\n    -- ── clone findings as in-buffer signs (the interactive surface) ──"}},"decided_by":"tactic"},{"bytes":352,"id":"1791106889.696667-edit","decisions":[],"verb":"edit","invocation":{"verb":"edit","touched":[".claude/skills/cartograph/references/commands.md"],"args":{"before":"| `:CartographNearClones [count]` |","file":".claude/skills/cartograph/references/commands.md","after":"| `:CartographSubtermClones [count]` | an expression, condition or constructor BELOW the statement row that is a variant (locals renamed) of one in another function — the algebra's per-subterm ids (hashing modulo alpha-equivalence); maximal classes only, ranked by spread. `[count]` = min nodes, default 12. Headless: `tools/clones.lua --subterms` |\n| `:CartographNearClones [count]` |"}},"decided_by":"tactic"},{"bytes":611,"id":"1791106889.744835-edit","decisions":[],"verb":"edit","invocation":{"verb":"edit","touched":["README.md"],"args":{"