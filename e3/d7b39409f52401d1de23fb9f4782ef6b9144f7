es = 0\n                for _ in pairs(files) do nfiles = nfiles + 1 end\n                out[#out + 1] = { size = c.size, nfns = n, nfiles = nfiles, show = A.show(c.sample), members = members }\n            end\n        end\n    end\n    table.sort(out, function (a, b)\n        if a.nfiles ~= b.nfiles then return a.nfiles > b.nfiles end\n        if a.nfns ~= b.nfns then return a.nfns > b.nfns end\n        if a.size ~= b.size then return a.size > b.size end\n        return a.show < b.show\n    end)\n    return out\nend\n\nfunction M.subterms_report(groups)\n    if #groups == 0 then return { 'subterm clones: none' } end\n    local lines = { ('subterm clones: %d groups (variants below statement level, in 2+ functions)'):format(#groups) }\n    for k, g in ipairs(groups) do\n        lines[#lines + 1] = ('[%d] %d functions / %d files, %d nodes: %s'):format(k, g.nfns, g.nfiles, g.size,\n            (g.show:gsub('%s+', ' ')):sub(1, 160))\n        for _, m in ipairs(g.members) do\n            lines[#lines + 1] = ('    %s:%s  %s'):format(m.file, m.line and tostring(m.line + 1) or '?', m.name)\n        end\n    end\n    return lines\nend\n\n--- Block/window clones: contiguous statement runs (≥ opts.min_len, default 4)","file":"lua/cartograph/clones.lua"}}},{"verb":"edit","id":"1791106780.408442-edit","invocation":{"verb":"edit","touched":["lua/cartograph/clones.lua"],"args":{"before":"m.line and tostring(m.line + 1) or '?'","file":"lua/cartograph/clones.lua","after":"m.line and tostring(m.line) or '?'"}}},{"verb":"edit","id":"1791106819.291755-edit","invocation":{"verb":"edit","touched":["tests/clones_spec.lua"],"args":{"before":"-- ★ THE SAME SPELLING IS NOT THE SAME BINDING (CART-1424).","file":"tests/clones_spec.lua","after":"-- ── the SUBTERM tier (CART-1426): variants below the statement row, from the algebra's per-subterm ids ──\ntest('clones: a SUBTERM shared by two functions under renamed locals is one group — only the maximal one, and a near miss is not in it', function ()\n    if not ready() then skip 'no lua parser' end\n    local function body(v, field)\n        return ('  local total = 0\\n  if %s.items[%s.key] and %s.items[%s.%s].count > 10 then total = 1 end\\n  return total'):format(v, v, v, v, field)\n    end\n    local root = proj {\n        ['st1.lua'] = fn('first_of', 'cfg', body('cfg', 'key')),\n        ['st2.lua'] = fn('second_of', 'opts', body('opts', 'key')),\n        ['st3.lua'] = fn('third_of', 'cfg', body('cfg', 'other')),\n    }\n    local groups = clones.subterms(store, { min_nodes = 12 })\n    local hit\n    for _, g in ipairs(groups) do\n        for _, m in ipairs(g.members) do if m.name == 'first_of' then hit = g end end\n    end\n    ok(hit, 'the shared condition is found: ' .. #groups .. ' groups')\n    local names = {}\n    for _, m in ipairs(hit and hit.members or {}) do names[#names + 1] = m.name end\n    table.sort(names)\n    eq({ 'first_of', 'second_of' }, names, 'cfg / opts renamed is one subterm; `.other` for `.key` is not a renaming')\n    -- maximal: the condition's `... .count > 10` half is as widespread as the condition itself, so it is its part\n    for _, g in ipairs(groups) do\n        ok(not (g.show:find('^%(bin >') and g.nfns == 2), 'the dominated inner subterm is not reported: ' .. g.show)\n    end\n    eq('subterm clones: none', clones.subterms_report({})[1])\n    vim.fn.delete(root, 'rf')\nend)\n\n-- ★ THE SAME SPELLING IS NOT THE SAME BINDING (CART-1424)."}}},{"verb":"edit","id":"1791106857.204293-edit","invocation":{"verb":"edit","touched":["tools/clones.lua"],"args":{"before":"--                                               [--rowdrift]","file":"tools/clones.lua","after":"--                                               [--rowdrift]\n--                                               [--subterms [--min-nodes N]]"}}},{"verb":"edit","id":"1791106857.247380-edit","invocation":{"verb":"edit","touched":["tools/clones.lua"],"args":{"before":"--   --fold     NOT a tier either","after":"--