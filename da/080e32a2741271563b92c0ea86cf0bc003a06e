hen return nil end\n    local E = require 'cartograph.effects'\n    local callrec = require 'cartograph.callrec'\n    local atr = require 'cartograph.at'\n    local sums = E.summaries(store)\n    local sites = store.topo():sites(node.id)\n    local memo = {}\n    return function (cn, argi)\n        local r, c0 = cn:start()\n        local key = r .. ':' .. c0 .. ':' .. argi\n        if memo[key] ~= nil then return memo[key] end\n        local c, bd\n        for _, x in ipairs(sites) do\n            if callrec.line(x) == r then -- (0-based, as the node's row)\n                local d = math.abs((x.at and atr.sc(x.at) or 0) - c0)\n                if not bd or d < bd then c, bd = x, d end\n            end\n        end\n        local ok = false\n        if c then\n            local pos = argi == 0 and 1 or (argi + (callrec.method(c) and 1 or 0))\n            local to = callrec.to(c)\n            local s = to and sums[to]\n            if s then\n                ok = not s.h and not (s.pwx and s.pwx[pos]) and next(s.w or {}) == nil\n            elseif not to then\n                local sig = E.sig_of('lua', callrec.full(c) or callrec.callee(c), callrec.method(c))\n                if sig then\n                    ok = true\n                    for _, wi in ipairs(sig.w or {}) do if wi == pos then ok = false end end\n                end\n            end\n        end\n        memo[key] = ok\n        return ok\n    end\nend\n\nlocal function field_unstable_of(fn, src, harmless)"}},"decisions":[],"verb":"edit","id":"1791916093.091014-edit"},{"bytes":123,"decided_by":"tactic","invocation":{"touched":["lua/cartograph/narrow.lua"],"verb":"edit","args":{"file":"lua/cartograph/narrow.lua","before":"                local p = path_of(a, src); if p then mark(p.path, false, n, ai) end","after":"                local p = path_of(a, src); if p and not (harmless and harmless(n, ai)) then mark(p.path, false, n, ai) end"}},"decisions":[],"verb":"edit","id":"1791916093.167093-edit"},{"bytes":