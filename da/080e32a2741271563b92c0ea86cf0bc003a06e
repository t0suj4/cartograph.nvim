(x.at) or 0) - c0)\n                if not bd or d < bd then c, bd = x, d end\n            end\n        end\n        local ok = false\n        if c then\n            local pos = argi == 0 and 1 or (argi + (callrec.method(c) and 1 or 0))\n            local to = callrec.to(c)\n            local s = to and sums[to]\n            if s then\n                ok = not s.h and not (s.pwx and s.pwx[pos]) and next(s.w or {}) == nil\n            elseif not to then\n                local sig = E.sig_of('lua', callrec.full(c) or callrec.callee(c), callrec.method(c))\n                if sig then\n                    ok = true\n                    for _, wi in ipairs(sig.w or {}) do if wi == pos then ok = false end end\n                end\n            end\n        end\n        memo[key] = ok\n        return ok\n    end\nend\n\nlocal function field_unstable_of(fn, src, harmless)"}},"id":"1791916093.091014-edit","verb":"edit"},{"invocation":{"touched":["lua/cartograph/narrow.lua"],"verb":"edit","args":{"file":"lua/cartograph/narrow.lua","before":"                local p = path_of(a, src); if p then mark(p.path, false, n, ai) end","after":"                local p = path_of(a, src); if p and not (harmless and harmless(n, ai)) then mark(p.path, false, n, ai) end"}},"id":"1791916093.167093-edit","verb":"edit"},{"invocation":{"touched":["lua/cartograph/narrow.lua"],"verb":"edit","args":{"file":"lua/cartograph/narrow.lua","before":"                local p = path_of(callee:named_child(0), src); if p then mark(p.path, false, n, 0) end","after":"                local p = path_of(callee:named_child(0), src); if p and not (harmless and harmless(n, 0)) then mark(p.path, false, n, 0) end"}},"id":"1791916093.220574-edit","verb":"edit"},{"invocation":{"touched":["lua/cartograph/narrow.lua"],"verb":"edit","args":{"file":"lua/cartograph/narrow.lua","before":"    if not fn then return { lang = lang, points = {} } end\n    local classify = gated_classify(vocab[lang], type_is_shadowed(lang, node))\n   