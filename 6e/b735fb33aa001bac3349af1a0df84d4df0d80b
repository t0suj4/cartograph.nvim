s + 1\n            seen[op] = true\n            local s = MT.SCHEMA[op]\n            if not s then stray[#stray + 1] = op .. ' (no schema)'\n            else\n                local names = {}\n                for _, e in ipairs(s) do names[e[1]] = true end\n                for _, k in ipairs(fields) do if k ~= 'op' and not names[k] then stray[#stray + 1] = op .. '.' .. k end end\n            end\n        end\n    end\n    eq({}, stray, 'constructor fields outside the schema')\n    local unused = {}\n    for k in pairs(MT.SCHEMA) do if not seen[k] then unused[#unused + 1] = k end end\n    eq({}, unused, 'schema kinds no constructor makes')\n    ok(sites >= 80, sites .. ' constructor sites')\nend)\n\ntest('mixterm: what the lens does not know is REFUSED by name — an unknown kind, a field outside the schema', function ()\n    local okk, e1 = pcall(MT.to_term, { op = 'goto', label = 'x' })\n    ok(not okk and e1.refusal:find('no schema for the IR kind goto', 1, true), vim.inspect(e1))\n    local okf, e2 = pcall(MT.to_term, { op = 'num', v = 1, extra = true })\n    ok(not okf and e2.refusal:find('`extra`', 1, true), vim.inspect(e2))\nend)\n","file":"tests/mixterm_spec.lua","before":""}},"verb":"edit"},{"id":"1791009926.618203-edit","invocation":{"verb":"edit","touched":[".claude/skills/cartograph/references/questions.md"],"args":{"file":".claude/skills/cartograph/references/questions.md","after":"| COMPILE an algebra template into a plain Lua function — match specialized to the template (the first Futamura projection on the algebra) — and is it the same matcher? | `local MA = require 'cartograph.mixalg'; local m = MA.compile_match(T)` → `m(I)` returns what `A.match(T, I)` returns, with no template walking (also the residual text and stats). `MA.program(root)` — an algebra operation's CALL CLOSURE (default `M.match`) assembled from the algebra's part files into one mix program, derived from the code (calls and references-as-values followed; `M.x` → `M_x`, file locals → `<