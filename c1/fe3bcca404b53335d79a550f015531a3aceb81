- ../config/kc.yaml\\n',\n        ['config/kc.yaml'] = 'db:\\n  name: \\'{{ include \"keycloak.fullname\" . }}-db\\'\\n',\n    })\n    local r = assert(H.read(root, 'clusters/c.yaml')).releases[1]\n    eq('read', r.layers[1].state)\n    eq(false, r.lower_bound)\n    eq('{{ include \"keycloak.fullname\" . }}-db', r.effective.o.db.o.name, 'kept literally, as helmfile hands it to the chart')\nend)\n","file":"tests/helmfile_spec.lua"}}},{"id":"1790900003.276492-edit","verb":"edit","invocation":{"touched":[".claude/skills/cartograph/references/questions.md"],"verb":"edit","args":{"before":"4 helmfiles, 55 releases, 65 layers (6 templated), 24 secrets refs,","file":".claude/skills/cartograph/references/questions.md","after":"4 helmfiles, 55 releases, 65 layers (5 templated: only a `.gotmpl` layer is one — a `{{` in a plain layer is a string for the chart's own `tpl`; a sixth was miscounted until that rule), 24 secrets refs,"}}}],"explained":2652}
