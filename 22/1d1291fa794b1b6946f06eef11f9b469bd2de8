_by":"tactic","invocation":{"verb":"edit","args":{"before":"    -- (a continuation that grows by a closure per call: the join's hole falls on a closure argument — no generalization)\n    ok(refusal('local function g(x, k)\\n    if x > 0 then return g(x - 1, function (y) return k(y) + 1 end) end\\n    return k(x)\\nend\\nlocal function f(x)\\n    return g(x, function (y) return y end)\\nend\\n', 'f', { 'D' }, {}):find('specialization depth', 1, true))\nend)","after":"    -- (a continuation that grows by a closure per call USED to refuse here — the join's hole falls on a closure. Since\n    -- CART-1500 the depth refusal retries with the closure DYNAMIC, as a key that cannot be formed always did: it\n    -- specializes, and equals the original)\n    local gsrc = 'local function g(x, k)\\n    if x > 0 then return g(x - 1, function (y) return k(y) + 1 end) end\\n    return k(x)\\nend\\nlocal function f(x)\\n    return g(x, function (y) return y end)\\nend\\n'\n    local gres = residual(gsrc, 'f', { 'D' }, {})\n    for _, x in ipairs({ 0, 1, 5, 30 }) do eq(original(gsrc, 'f')(x), gres(x)) end\nend)","file":"tests/mix_spec.lua"},"touched":["tests/mix_spec.lua"]},"decisions":[]},{"verb":"edit","id":"1791244020.744912-edit","bytes":92,"decided_by":"tactic","invocation":{"verb":"edit","args":{"before":"    ok(MX.describe(e2):find('at line 2, in g', 1, true), MX.describe(e2))","after":"    ok(MX.describe(e2):find('at line 3, in d ← c ← b ← f', 1, true), MX.describe(e2))","file":"tests/mix_spec.lua"},"touched":["tests/mix_spec.lua"]},"decisions":[]},{"verb":"edit","id":"1791244083.661981-edit","bytes":697,"decided_by":"tactic","invocation":{"verb":"edit","args":{"before":"test('mix: the FORWARD-DECLARED recursive local","after":"test('mix: a table a CALLEE\\'s closure stores into is dynamic in the CALLER too — `local ids = {}` handed to it is allocated per run, never a shared constant (CART-1500)', function ()\n    ready()\n    local SRC = 'local function note(memo, k)\\n  local function set(v) memo[k] = (memo[k] or 0) + v end\\n  set(1)\\n  return memo[k]\\nend\\n'\n        .. 'local function f(x)\\n  local ids = {}\\n  return note(ids, x) + note(ids, x)\\nend\\n'\n    local want = original(SRC, 'f')\n    local r = residual(SRC, 'f', { 'D' }, {})\n    -- (twice: a memo lifted into the constant pool would keep counting across runs — 1+2, then 3+4)\n    eq(want('a'), r('a')); eq(want('a'), r('a')); eq(want('b'), r('b'))\nend)\n\ntest('mix: the FORWARD-DECLARED recursive local","file":"tests/mix_spec.lua"},"touched":["tests/mix_spec.lua"]},"decisions":[]},{"verb":"edit","id":"1791244106.049480-edit","bytes":2381,"decided_by":"tactic","invocation":{"verb":"edit","args":{"before":"test('mixalg: a closure mix cannot lower is REFUSED by name, never a Lua error","after":"test('mixalg: THROUGH THE BASIS — a captured table\\'s field or a captured alias that IS a definition of these files is followed and specialized with the rest; without opts.through it stays a primitive; opts.opaque keeps one (CART-1500)', function ()\n    ready()\n    local dir = vim.fn.tempname()\n    vim.fn.mkdir(dir .. '/lua/mxk1500', 'p')\n    local path = dir .. '/lua/mxk1500/fix.lua'\n    local fd = assert(io.open(path, 'w'))\n    fd:write(table.concat({\n        'local M = {}',\n        'function M.inc(x) return x + 1 end',\n        'function M.dbl(x) return x * 2 end',\n        'local B = { inc = M.inc, dbl = M.dbl }',\n        'local inc2 = M.inc',\n        'function M.use(a) return B.inc(a) + inc2(a) + B.dbl(a) end',\n        'return M', '' }, '\\n'))\n    fd:close()\n    local saved = package.path\n    package.path = dir .. '/lua/?.lua;' .. package.path\n    local okall, err = pcall(function ()\n        local plain = MA.program('M.use', { path })\n        ok(plain:find('fix__B.inc(', 1, true) and not plain:find('M_inc(', 1, true), 'without through: a primitive\\n' .. plain)\n        local thr, order = MA.program('M.use', { path }, { through = true })\n        ok(thr:find('M_inc(a)', 1, true) and thr:find('M_dbl(a)', 1, true), 'the field and the alias are the definitions\\n' .. thr)\n        ok(not thr:find('fix__B', 1, true) and not thr:find('inc2', 1, true), 'nothing opaque left\\n' .. thr)\n        ok(vim.tbl_contains(order, 'M.inc') and vim.tbl_contains(order, 'M.dbl'), 'and followed into the closure')\n        local op, _, _, _, _, prims = MA.program('M.use', { path }, { through = true, opaque = { ['M.dbl'] = true } })\n        ok(op:find('M_inc(a)', 1, true) and op:find('fix__B.dbl(', 1, true), 'M.dbl kept opaque\\n' .. op)\n        ok(prims['fix__B.dbl'] ~= nil, 'as a primitive')\n        -- (and the followed program specializes and equals the original)\n        local prog = MX_ and nil\n        local MX = require 'cartograph.mix'\n        local p2 = MX.lower(assert(R.read(thr, 'lua')))\n        local res = MX.specialize(p2, 'M_use', { 'D' }, {}, { budget = 2e5 })\n        local F = require 'cartograph.mixfn'\n        local f = assert(load(MX.print(res, p2.where), 'r', 't', F.env(res.pool, {})))()\n        eq(require('mxk1500.fix').use(5), f(5))\n    end)\n    package.path = saved\n    package.loaded['mxk1500.fix'] = nil\n    vim.fn.delete(dir, 'rf')\n    if not okall then error(err, 0) end\nend)\n\ntest('mixalg: a closure mix cannot lower is REFUSED by name, never a Lua error","file":"tests/mixalg_spec.lua"},"touched":["tests/mixalg_spec.lua"]},"decisions":[]},{"verb":"edit","id":"1791244259.943354-edit","bytes":887,"decided_by":"tactic","invocation":{"verb":"edit","args":{"before":"test('mixalg: a closure mix cannot lower is REFUSED by name, never a Lua error","after":"test('mixalg: THROUGH THE BASIS on the real derivation — D.match follows its basis into the algebra (join and beyond), lowers with nothing refused, and carries the algebra DATA it reads (M.OBSERVED) as a known (CART-1500)', function ()\n    ready()\n    require('cartograph.algebra.derive').apply_to(A, '')\n    local text, order, _, knowns = MA.program('derive.lua::D.match', nil, { snapshot = true, through = true })\n    local alg = 0\n    for _, k in ipairs(order) do if not k:match('^derive%.lua::') then alg = alg + 1 end end\n    ok(alg > 20, alg .. ' algebra definitions followed')\n    ok(not text:find('derive__B%.[%w_]+%('), 'no opaque basis call left')\n    ok(knowns['M.OBSERVED'] ~= nil, 'M.OBSERVED carried')\n    local got = {}\n    require('cartograph.mix').lower(assert(R.read(text, 'lua')), { collect = got })\n    eq({}, vim.tbl_map(function (g) return g.why end, got))\nend)\n\ntest('mixalg: a closure mix cannot lower is REFUSED by name, never a Lua error","file":"tests/mixalg_spec.lua"},"touched":["tests/mixalg_spec.lua"]},"decisions":[]},{"verb":"edit","id":"1791244378.493971-edit","bytes":1381,"decided_by":"tactic","invocation":{"verb":"edit","args":{"before":"`tests/fixpoint_spec.lua`. CART-1484, CART-1494, CART-1495, CART-1497, CART-1498, CART-1499 |","after":"`tests/fixpoint_spec.lua`. CART-1484, CART-1494, CART-1495, CART-1497, CART-1498, CART-1499 |\n| Can a derivation be specialized THROUGH its basis — `B.join` followed into the algebra's own code, so mix specializes it on a static template instead of calling it opaque? | `MA.program(key, nil, { snapshot = true, through = true [, opaque = { ['M.x'] = true }] })` (CART-1500): a captured table's FIELD (`B.join`) or a captured ALIAS (`local label = M.node_label`) whose value IS a definition of the program's files is followed into the closure and rewritten to its mangled name; the algebra's DATA fields the followed code reads (`M.OBSERVED`) become knowns; `opaque` keeps named definitions as primitives (a NARROWED domain). D.match through the basis: 84 definitions (64 from the algebra), every basis call followed, lowers with nothing refused. Mix gaps it surfaced, fixed: a callee's closure-stored parameter now forces the CALLER's variable dynamic (a `local ids = {}` handed to `content_id` — never a shared constant); a closure that keeps growing is retried DYNAMIC on a depth refusal too (a growing continuation `g(x-1, function (y) return k(y) + 1 end)` now specializes, equal to the original). OPEN: specializing D.match through join still refuses — unfolding the hand matcher via `admits` explodes the unfold budget; with `admits`/`match` opaque, join_domain's multi-value last argument (mix rung 3). `tests/mixalg_spec.lua`, `tests/mix_spec.lua`. CART-1500 |","file":".claude/skills/cartograph/references/questions.md"},"touched":[".claude/skills/cartograph/references/questions.md"]},"decisions":[]}]}
