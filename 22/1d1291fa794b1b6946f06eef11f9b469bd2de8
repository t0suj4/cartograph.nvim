UGH THE BASIS on the real derivation — D.match follows its basis into the algebra (join and beyond), lowers with nothing refused, and carries the algebra DATA it reads (M.OBSERVED) as a known (CART-1500)', function ()\n    ready()\n    require('cartograph.algebra.derive').apply_to(A, '')\n    local text, order, _, knowns = MA.program('derive.lua::D.match', nil, { snapshot = true, through = true })\n    local alg = 0\n    for _, k in ipairs(order) do if not k:match('^derive%.lua::') then alg = alg + 1 end end\n    ok(alg > 20, alg .. ' algebra definitions followed')\n    ok(not text:find('derive__B%.[%w_]+%('), 'no opaque basis call left')\n    ok(knowns['M.OBSERVED'] ~= nil, 'M.OBSERVED carried')\n    local got = {}\n    require('cartograph.mix').lower(assert(R.read(text, 'lua')), { collect = got })\n    eq({}, vim.tbl_map(function (g) return g.why end, got))\nend)\n\ntest('mixalg: a closure mix cannot lower is REFUSED by name, never a Lua error","file":"tests/mixalg_spec.lua"},"touched":["tests/mixalg_spec.lua"]}},{"verb":"edit","id":"1791244378.493971-edit","invocation":{"verb":"edit","args":{"before":"`tests/fixpoint_spec.lua`. CART-1484, CART-1494, CART-1495, CART-1497, CART-1498, CART-1499 |","after":"`tests/fixpoint_spec.lua`. CART-1484, CART-1494, CART-1495, CART-1497, CART-1498, CART-1499 |\n| Can a derivation be specialized THROUGH its basis — `B.join` followed into the algebra's own code, so mix specializes it on a static template instead of calling it opaque? | `MA.program(key, nil, { snapshot = true, through = true [, opaque = { ['M.x'] = true }] })` (CART-1500): a captured table's FIELD (`B.join`) or a captured ALIAS (`local label = M.node_label`) whose value IS a definition of the program's files is followed into the closure and rewritten to its mangled name; the algebra's DATA fields the followed code reads (`M.OBSERVED`) become knowns; `opaque` keeps named definitions as primitives (a NARROWED domain). D.match through the basis: 84 definitions (64 from the algebra), every basis call followed, lowers with nothing refused. Mix gaps it surfaced, fixed: a callee's closure-stored parameter now forces the CALLER's variable dynamic (a `local ids = {}` handed to `content_id` — never a shared constant); a closure that keeps growing is retried DYNAMIC on a depth refusal too (a growing continuation `g(x-1, function (y) return k(y) + 1 end)` now specializes, equal to the original). OPEN: specializing D.match through join still refuses — unfolding the hand matcher via `admits` explodes the unfold budget; with `admits`/`match` opaque, join_domain's multi-value last argument (mix rung 3). `tests/mixalg_spec.lua`, `tests/mix_spec.lua`. CART-1500 |","file":".claude/skills/cartograph/references/questions.md"},"touched":[".claude/skills/cartograph/references/questions.md"]}}],"explained":14474,"commit":"221d1291fa794b1b6946f06eef11f9b469bd2de8","entries":[{"verb":"edit","id":"1791242834.539520-edit","bytes":2369,"decided_by":"tactic","invocation":{"verb":"edit","args":{"before":"        return written_memo[key]\n    end\n    local knowns, prims, report = {}, {}, { known = {}, snapshots = {}, free = {} }","after":"        return written_memo[key]\n    end\n    -- the runtime object of a definition (nil: not loaded), and each loaded definition's key by its function object\n    local function fkey_of(d) return vim.fn.fnamemodify(path[d.file], ':p') .. ':' .. ((d.node:start()) + 1) end\n    local function obj_of(d)\n        local fk = fkey_of(d)\n        if not fobj[fk] then ensure_loaded(vim.fn.fnamemodify(path[d.file], ':p')) end\n        return fobj[fk]\n    end\n    local key_of_fn\n    -- THROUGH THE BASIS (opts.through, CART-1500): `B.join` where B is a captured table whose field IS a definition of\n    -- these files (the derivations' basis is the algebra's own functions) is that definition — followed into the\n    -- closure and rewritten to its mangled name, so mix specializes it with the rest instead of calling it opaque.\n    -- The table is read as knowns are: never written in its file, or a snapshot. -> the definition's key, or nil\n    local function through(cap, d)\n        if not opts.through or cap:type() ~= 'dot_index_expression' then return nil end\n        local obj, fld = cap:named_child(0), cap:field('field')[1]\n        if not (obj and fld and obj:type() == 'identifier') then return nil end\n        local nm = tx(obj, d.src)\n        if nm == 'M' or nm == 'SHARED' or nm == 'PARTS' or not outer_ref(obj, d) then return nil end\n        if written(d.file, nm) and not opts.snapshot then return nil end\n        local fo = obj_of(d)\n        if not fo then return nil end\n        local tbl\n        for i = 1, 255 do\n            local un, uv = debug.getupvalue(fo, i)\n            if not un then break end\n            if un == nm then tbl = uv; break end\n        end\n        if type(tbl) ~= 'table' then return nil end\n        local okf, fv = pcall(function () return tbl[tx(fld, d.src)] end)\n        if not okf or type(fv) ~= 'function' then return nil end\n        if not key_of_fn then\n            key_of_fn = {}\n            for k2, d2 in pairs(defs) do\n                local o2 = fobj[fkey_of(d2)]\n                if o2 then key_of_fn[o2] = k2 end\n            end\n        end\n        return key_of_fn[fv]\n    end\n    -- THE CLOSURE: calls and references-as-values (`local with_cursor = M.with_cursor`), and with opts.through the\n    -- basis fields that are definitions of these files\n    local rq = vim.treesitter.query.parse('lua', '[(dot_index_expression) @d (identifier) @d]')\n    local seen, order, todo = {}, {}, { root }\n    for _ = 1, 100000 do\n        if #todo == 0 then break end\n        local k = table.remove(todo, 1)\n        if not seen[k] then\n            seen[k] = true\n            order[#order + 1] = k\n            local d = defs[k]\n            for _, c in rq:iter_captures(d.node, d.src, 0, -1) do\n                local r = (c:type() ~= 'identifier' or outer_ref(c, d)) and resolve(tx(c, d.src), d.file)\n                if not r and c:type() == 'dot_index_expression' then r = through(c, d) end\n                if r and not seen[r] then todo[#todo + 1] = r end\n            end\n        end\n    end\n    local knowns, prims, report = {}, {}, { known = {}, snapshots = {}, free = {} }","file":"lua/cartograph/mixalg.lua"},"touched":["lua/cartograph/mixalg.lua"]},"decisions":[]},{"verb":"edit","id":"1791242834.630857-edit","bytes":121,"decided_by":"tactic","invocation":{"verb":"edit","args":{"before":"                    if not target and defs[d.file .. '::' .. t] then target = mangle(d.file .. '::' .. t) end","after":"                    if not target and defs[d.file .. '::' .. t] then target = mangle(d.file .. '::' .. t) end\n                    if not target then local th = through(cap, d); if th then target = mangle(th) end end -- (CART-1500)","file":"lua/cartograph/mixalg.lua"},"touched":["lua/cartograph/mixalg.lua"]},"decisions":[]},{"verb":"edit","id":"1791242834.719930-edit","bytes":216,"decided_by":"tactic","invocation":{"verb":"edit","args":{"before":"            table.sort(edits, function (a, b) return a[1] > b[1] end)","after":"            -- (from the end; at one start the LONGER edit — `B.join` rewritten whole, not its `B`)\n            table.sort(edits, function (a, b) if a[1] ~= b[1] then return a[1] > b[1] end return a[2] > b[2] end)","file":"lua/cartograph/mixalg.lua"},"touched":["lua/cartograph/mixalg.lua"]},"decisions":[]},{"verb":"edit","id":"1791242850.158643-edit","bytes":48,"decided_by":"tactic","invocation":{"verb":"edit","args":{"before":"    local ckey = root .. (files and ('\\0' .. table.concat(files, '\\0')) or '') .. (opts.snapshot and '\\0snap' or '')","after":"    local ckey = root .. (files and ('\\0' .. table.concat(files, '\\0')) or '') .. (opts.snapshot and '\\0snap' or '')\n        .. (opts.through and '\\0through' or '')","file":"lua/cartograph/mixalg.lua"},"touched":["lua/cartograph/m