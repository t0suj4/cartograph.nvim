{"entries":[{"id":"1791911428.879523-edit","bytes":111,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"file":"lua/cartograph/effects.lua","before":"    FLOW = (M.FLOW or require('cartograph.config').effects_flow) and require('cartograph.flowtype').of(store) or nil","after":"    FLOW = (M.FLOW or require('cartograph.config').effects_flow) and require('cartograph.flowtype').of(store) or nil\n    INDIRECT = {}; store._fxpwv = INDIRECT -- (var key -> { [caller fn id] = callee }: see M.indirect_writers)"},"touched":["lua/cartograph/effects.lua"],"verb":"edit"}},{"id":"1791911428.924720-edit","bytes":407,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"file":"lua/cartograph/effects.lua","before":"                        local kind, x = arg_target(store, c, pi, caller)\n                        if kind == 'var' then\n                            s_add(sum, x, 1)\n                        elseif kind == 'param' then","after":"                        local kind, x = arg_target(store, c, pi, caller)\n                        if kind == 'var' then\n                            s_add(sum, x, 1)\n                            -- (THIS caller hands module state to a mutated parameter: an indirect WRITER of it)\n                            local vid = x:match('^(.-)\\31')\n                            if vid and caller then\n                                local w = INDIRECT[vid]; if not w then w = {}; INDIRECT[vid] = w end\n                                w[caller.id] = to\n                            end\n                        elseif kind == 'param' then"},"touched":["lua/cartograph/effects.lua"],"verb":"edit"}},{"id":"1791911428.971602-edit","bytes":555,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"file":"lua/cartograph/effects.lua","before":"function M.summaries(store)","after":"--- WRITERS THROUGH A PARAMETER (CART-1670): the module vars a function hands to a callee that MUTATES that parameter —\n--- `add(M.cache, x)` into `local function add(t, k) t[k] = true end` writes M.cache, and the write edge is `add`'s on\n--- its own param, never M.cache's. Per CALLER, never per shared summary: a recursive group does not make every member a\n--- writer. -> { [var id] = { [fn id] = callee id } } (the summaries are computed if they were not)\nfunction M.indirect_writers(store)\n    M.summaries(store)\n    return store._fxpwv or {}\nend\n\nfunction M.summaries(store)"},"touched":["lua/cartograph/effects.lua"],"verb":"edit"}},{"id":"1791911440.288795-edit","bytes":99,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"before":"local FLOW","file":"lua/cartograph/effects.lua","after":"local FLOW\nlocal INDIRECT -- (the current summaries' writers through a parameter, by var: M.indirect_writers)"},"touched":["lua/cartograph/effects.lua"],"verb":"edit"}},{"id":"1791911440.364031-edit","bytes":859,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"file":"lua/cartograph/atlas.lua","before":"    -- derived reads are READS: a call with a literal key was SEEN, so each is a","after":"    -- WRITERS THROUGH A PARAMETER (CART-1670): a function handing this var to a callee that mutates that param\n    -- writes it, though no write edge says so — the edge is the callee's, on its own param. Counted as writers\n    -- (`nwi` of them), unguarded: a const / single-writer claim that ignored them was wrong, not conservative.\n    -- opts.indirect = false: the edges alone\n    local nwi = 0\n    if not (opts and opts.indirect == false) then\n        local seenw = {}\n        for _, w in ipairs(writers) do seenw[w] = true end\n        for fid in pairs(require('cartograph.effects').indirect_writers(store)[id] or {}) do\n            if not seenw[fid] then\n                seenw[fid] = true\n                nw = nw + 1; nwi = nwi + 1\n                writers[nw] = fid\n                gwmin = math.min(gwmin or 1, 1)\n            end\n        end\n    end\n    -- derived reads are READS: a call with a literal key was SEEN, so each is a"},"touched":["lua/cartograph/atlas.lua"],"verb":"edit"}},{"id":"1791911440.373601-edit","bytes":107,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"file":"lua/cartograph/atlas.lua","before":"    return { label = label, nr = nr, nw = nw, writers = writers, gw = gwmin,","after":"    return { label = label, nr = nr, nw = nw, nwi = nwi > 0 and nwi or nil, writers = writers, gw = gwmin,"},"touched":["lua/cartograph/atlas.lua"],"verb":"edit"}},{"id":"1791911553.923213-edit","bytes":1441,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"before":"test('atlas fields: a multi-writer var decomposes per field', function ()","file":"tests/atlas_spec.lua","after":"test('atlas: a var handed to a callee that MUTATES that parameter is WRITTEN — never const (CART-1670)', function ()\n    if not pcall(vim.treesitter.language.add, 'lua') then skip 'no lua parser' end\n    local root = vim.fn.tempname()\n    vim.fn.mkdir(root, 'p')\n    local fd = assert(io.open(root .. '/m.lua', 'w'))\n    fd:write(table.concat({\n        'local M = {}',\n        'local CACHE = {}',                                    -- written only through put's param\n        'local LIMITS = {}',                                   -- handed only to a reader\n        'local function put(t, k) t[k] = true end',\n        'local function size(t) return #t end',\n        'function M.add(k) put(CACHE, k) end',\n        'function M.has(k) return CACHE[k], size(LIMITS) end',\n        'return M', '' }, '\\n'))\n    fd:close()\n    store.ingest(require('cartograph.providers.treesitter').extract(root))\n    local by = {}\n    for _, n in ipairs(store.data.nodes) do if n.kind == 'var' then by[n.name] = n.id end end\n    eq('const', atlas.classify(store, by.CACHE, { indirect = false }).label, 'the write edges alone see no writer')\n    local c = atlas.classify(store, by.CACHE)\n    eq('single-writer', c.label, 'M.add writes it through put')\n    eq(1, c.nwi)\n    ok(tostring(c.writers[1]):find('M.add', 1, true), vim.inspect(c.writers))\n    eq('const', atlas.classify(store, by.LIMITS).label, 'a callee that only READS its param writes nothing')\nend)\n\ntest('atlas fields: a multi-writer var decomposes per field', function ()"},"touched":["tests/atlas_spec.lua"],"verb":"edit"}},{"id":"1791911795.415539-edit","bytes":962,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"file":".claude/skills/cartograph/references/questions.md","before":"| Which CACHES does a Lua tree hold in its processes","after":"| WHO WRITES this module var — counting the functions that write it THROUGH A PARAMETER (`add(M.cache, k)` into a helper that mutates its `t`), which no write edge shows? | `require('cartograph.atlas').classify(store, var_id)` now counts them: `writers` includes each function that hands the var to a callee whose effect summary mutates that parameter, `nwi` = how many (unguarded: no set-once); `opts.indirect = false` = the write edges alone. The facts: `require('cartograph.effects').indirect_writers(store)` -> `{ [var id] = { [fn id] = callee } }`, per CALLER (a recursive group does not make every member a writer). MEASURED (CART-1670): luajs/pack.js STDIN / STDOUT were `const` (FILE.read / FILE.write mutate them), forge's checkpoints_list `single-writer` (replace_key writes it) — nothing else moved on 4 corpora. An argument effects cannot NAME (a plain local) is resolved by flowtype only in the census: `tools/experiments/writers_census.lua`. |\n| Which CACHES does a Lua tree hold in its processes"},"touched":[".claude/skills/cartograph/references/questions.md"],"verb":"edit"}}],"hand":0,"commit":"71c2d5998dc0b25a871740b8db7ae6d671d60fc1","open_intents":[],"replay":[{"id":"1791911428.879523-edit","verb":"edit","invocation":{"args":{"file":"lua/cartograph/effects.lua","before":"    FLOW = (M.FLOW or require('cartograph.config').effects_flow) and requi