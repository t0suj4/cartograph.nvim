rb":"edit"},"decisions":[],"verb":"edit","id":"1791164816.226198-edit"},{"bytes":61,"decided_by":"tactic","invocation":{"args":{"before":"    local v = { runs = {} }","file":"lua/cartograph/tactics/ab-equivalence.lua","after":"    local v = { runs = {}, faster = p.faster == '1' or nil }"},"touched":["lua/cartograph/tactics/ab-equivalence.lua"],"verb":"edit"},"decisions":[],"verb":"edit","id":"1791164816.284749-edit"},{"bytes":359,"decided_by":"tactic","invocation":{"args":{"before":"            parts[#parts + 1] = ('%s: %d lines equal, A %.2fs / B %.2fs'):format(vim.fn.fnamemodify(r.corpus, ':t'), r.a.lines,\n                r.a.secs or -1, r.b.secs or -1)","after":"            -- (faster = 1: the change is a PERFORMANCE change, and equal output alone does not accept it)\n            if v.faster and not ((r.b.secs or math.huge) < (r.a.secs or 0)) then\n                return false, ('%s: outputs equal, but B (%s) is not faster: A %.3fs / B %.3fs'):format(r.corpus, v.b.ref, r.a.secs or -1, r.b.secs or -1)\n            end\n            parts[#parts + 1] = ('%s: %d lines equal, A %.2fs / B %.2fs'):format(vim.fn.fnamemodify(r.corpus, ':t'), r.a.lines,\n                r.a.secs or -1, r.b.secs or -1)","file":"lua/cartograph/tactics/ab-equivalence.lua"},"touched":["lua/cartograph/tactics/ab-equivalence.lua"],"verb":"edit"},"decisions":[],"verb":"edit","id":"1791164816.342466-edit"},{"bytes":87,"decided_by":"tactic","invocation":{"args":{"before":"        timeout = 'string?', repo = 'string?', keep = 'string?' },","file":"lua/cartograph/tactics/ab-equivalence.lua","after":"        timeout = 'string?', repo = 'string?', keep = 'string?', faster = 'string?' },"},"touched":["lua/cartograph/tactics/ab-equivalence.lua"],"verb":"edit"},"decisions":[],"verb":"edit","id":"1791164816.399773-edit"},{"bytes":542,"decided_by":"tactic","invocation":{"args":{"before":"warm = 1 shares caches; timeout = seconds per side',","file":"lua/cartograph/tactics/ab-equivalence.lua","after":"warm =