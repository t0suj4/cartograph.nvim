{"open_intents":[],"commit":"3722d170f865736eed385215974fed61908cbab5","explained":6251,"entries":[{"id":"1791335317.151278-edit","bytes":1364,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"file":"lua/cartograph/algebra/core.lua","after":"-- ★ A KEY STEP IS A LOOKUP, and costs one past KEYMAP_MIN kids (CART-1528): a weak node -> { key -> first index } map,\n-- rebuilt when the kid TABLE or its length changed, and a hit re-checked against its kid. Terms are values (EGAL,\n-- CART-1403), so the map is an OBSERVATION like content_id: under FREEZE it marks the node, and set_at — the in-place\n-- mutator that keeps the length — drops it. (A keyed node is the fact set / join index of a rule engine, CART-1525.)\nlocal KEYMAP, KEYMAP_MIN = setmetatable({}, { __mode = 'k' }), 16\nM.KEYMAP = KEYMAP\nfunction M.kid_by_key(t, key)\n    local kids = t.kids or {}\n    if #kids >= KEYMAP_MIN then\n        local m = KEYMAP[t]\n        if not m or m.kids ~= kids or m.n ~= #kids then\n            m = { kids = kids, n = #kids, at = {} }\n            for i, kid in ipairs(kids) do\n                local k = M.key_of(t, kid)\n                if k ~= nil and m.at[k] == nil then m.at[k] = i end\n            end\n            KEYMAP[t] = m\n            if M.FREEZE then M.OBSERVED[t] = true end\n        end\n        local i = m.at[key]\n        if i == nil then return nil end\n        if M.key_of(t, kids[i]) == key then return kids[i], i end\n        KEYMAP[t] = nil -- a stale hit (an owned term edited in place past set_at): the scan below is the answer\n    end\n    for i, kid in ipairs(kids) do if M.key_of(t, kid) == key then return kid, i end end\n    return nil\nend","before":"function M.kid_by_key(t, key)\n    for i, kid in ipairs(t.kids or {}) do if M.key_of(t, kid) == key then return kid, i end end\n    return nil\nend"},"verb":"edit","touched":["lua/cartograph/algebra/core.lua"]}},{"id":"1791335332.944871-edit","bytes":1519,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"before":"-- node takes kids as ARGUMENTS, seq as ONE LIST","after":"-- A KEY STEP IS A LOOKUP (CART-1528): a keyed node is a fact set / join index (CART-1525), and kid_by_key scanned\ntest('algebra seam: a key step on a large keyed node is a lookup, and stays right after an in-place edit', function ()\n    local A = need()\n    local N = 5000\n    local kids = {}\n    for i = 1, N do kids[i] = A.node('pair', A.lit('k' .. i), A.lit(i)) end\n    local db = A.keyed('db', kids)\n    -- every key found at its kid, a missing key absent\n    for _, i in ipairs({ 1, 17, 2500, N }) do\n        local kid, at = A.kid_by_key(db, 'k' .. i)\n        eq(i, kid.kids[2].v, 'k' .. i .. ' finds its kid'); ok(db.kids[at] == kid, 'and its index')\n    end\n    eq(nil, A.kid_by_key(db, 'nope'), 'a missing key is absent')\n    eq(N, A.locate_at(db, { 'k' .. N, 2 }).v, 'at() takes the key step through it')\n    -- the cost: N lookups on N kids — a scan per lookup is N^2/2 key_of calls (12.5M here)\n    local key_of, calls = A.key_of, 0\n    A.key_of = function (...) calls = calls + 1; return key_of(...) end\n    A.KEYMAP[db] = nil\n    for i = 1, N do A.kid_by_key(db, 'k' .. i) end\n    A.key_of = key_of\n    ok(calls <= 3 * N, ('N lookups cost %d key_of calls, not ~N^2/2'):format(calls))\n    -- an owned term edited in place past set_at: a stale HIT is re-checked, never returned\n    local own = A.keyed('own', vim.deepcopy(kids))\n    eq(5, A.kid_by_key(own, 'k5').kids[2].v)\n    own.kids[5] = A.node('pair', A.lit('moved'), A.lit(-5))\n    eq(nil, A.kid_by_key(own, 'k5'), 'the replaced key is gone')\n    eq(-5, A.kid_by_key(own, 'moved').kids[2].v, 'and the new one found')\n    -- set_at drops the map: the new kid's key is found\n    local own2 = A.keyed('own2', vim.deepcopy(kids))\n    eq(9, A.kid_by_key(own2, 'k9').kids[2].v)\n    A.set_at(own2, { 'k9' }, A.node('pair', A.lit('nine'), A.lit(99)))\n    eq(99, A.kid_by_key(own2, 'nine').kids[2].v, 'set_at: the new key is found')\n    eq(nil, A.kid_by_key(own2, 'k9'), 'and the old one is gone')\nend)\n\n-- node takes kids as ARGUMENTS, seq as ONE LIST","file":"tests/algebra_spec.lua"},"verb":"edit","touched":["tests/algebra_spec.lua"]}},{"id":"1791335372.069855-edit","bytes":117,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"before":"    parent.kids[last] = node\n    return root","after":"    parent.kids[last] = node\n    M.KEYMAP[parent] = nil -- AFTER the write: the key step above built the map, and this kid's key may have changed\n    return root","file":"lua/cartograph/algebra/core.lua"},"verb":"edit","touched":["lua/cartograph/algebra/core.lua"]}},{"id":"1791335372.167304-edit","bytes":508,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"file":"tests/algebra_spec.lua","after":"    -- the in-place mutator (set_at, under rewrite) resolves its key step through the map, THEN writes: a new key at\n    -- the same index must be found — a stale MISS is the one a re-check cannot catch\n    local T = A.template(A.keyed('own2', vim.deepcopy(kids)))\n    local T2 = assert(A.rewrite(T, { 'k9' }, A.node('pair', A.lit('nine'), A.lit(99))))\n    eq(99, A.kid_by_key(T2.body, 'nine').kids[2].v, 'rewrite: the new key is found')\n    eq(nil, A.kid_by_key(T2.body, 'k9'), 'and the old one is gone')\nend)","before":"    -- set_at drops the map: the new kid's key is found\n    local own2 = A.keyed('own2', vim.deepcopy(kids))\n    eq(9, A.kid_by_key(own2, 'k9').kids[2].v)\n    A.set_at(own2, { 'k9' }, A.node('pair', A.lit('nine'), A.lit(99)))\n    eq(99, A.kid_by_key(own2, 'nine').kids[2].v, 'set_at: the new key is found')\n    eq(nil, A.kid_by_key(own2, 'k9'), 'and the old one is gone')\nend)"},"verb":"edit","touched":["tests/algebra_spec.lua"]}},{"id":"1791335387.957530-edit","bytes":92,"decided_by":"tactic","decisions":[],"verb":"edit","invocation":{"args":{"file":"tests/algebra_spec.lua","after":"    local fresh = A.keyed('d