, 'partial' end\n            local out = {}\n            for o in each(ap) do\n                if o == EXT then return nil, 'external' end\n                out[#out + 1] = tostring(obinfo[o] or o)\n            end\n            return out\n        end\n    end"}},"verb":"edit"},{"bytes":114,"decided_by":"tactic","decisions":[],"id":"1791907686.012533-edit","invocation":{"verb":"edit","touched":["lua/cartograph/flowtype.lua"],"args":{"before":"    local ARGP = opts.argprobes and {} or nil","after":"    local ARGP = opts.argprobes and {} or nil\n    local ROOTS = ARGP and {} or nil -- (each walked file's TOP scope: name -> port, filled as the walk declares)","file":"lua/cartograph/flowtype.lua"}},"verb":"edit"},{"bytes":70,"decided_by":"tactic","decisions":[],"id":"1791907686.080794-edit","invocation":{"verb":"edit","touched":["lua/cartograph/flowtype.lua"],"args":{"before":"        local scopes = { {} }","after":"        local scopes = { {} }\n        if ROOTS and not clone then ROOTS[#ROOTS + 1] = scopes[1] end","file":"lua/cartograph/flowtype.lua"}},"verb":"edit"},{"bytes":1145,"decided_by":"tactic","decisions":[],"id":"1791907686.140672-edit","invocation":{"verb":"edit","touched":["lua/cartograph/flowtype.lua"],"args":{"before":"            local out = {}\n            for o in each(ap) do\n                if o == EXT then return nil, 'external' end\n                out[#out + 1] = tostring(obinfo[o] or o)\n            end\n            return out\n        end\n    end","after":"            local out, ids = {}, {}\n            for o in each(ap) do\n                if o == EXT then return nil, 'external' end\n                out[#out + 1] = tostring(obinfo[o] or o); ids[#ids + 1] = o\n            end\n            return out, ids\n        end\n        -- (MODULE STATE: every object reachable through fields from a module ROOT — a file's top-scope locals, a\n        -- global, a module's returned value. An object it reaches outlives the call that made it: a write into it