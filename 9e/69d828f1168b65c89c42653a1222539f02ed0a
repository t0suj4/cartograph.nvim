6 / 304 never module state (a removable hedge), 199 / 340 unknown;\n-- control: 11 of 11 resolved var arguments are module state.\nvim.opt.rtp:append(vim.fn.expand('~/.local/share/nvim/lazy/nvim-treesitter'))\nlocal store = require 'cartograph.store'\nstore.ingest(require('cartograph.providers.treesitter').extract(arg[1]))\nlocal E = require 'cartograph.effects'\nlocal callrec = require 'cartograph.callrec'\nlocal argv = require 'cartograph.argv'\nlocal want = arg[3] or 'opaque'\nlocal R = require('cartograph.flowtype').solve(store, { argprobes = true, open = arg[2] ~= 'closed' })\nlocal state = R.state_objs()\nprint('module-state objects: ' .. vim.tbl_count(state))\nlocal sums = E.summaries(store)\nlocal tally, ex = {}, {}\nlocal function bump(k, e) tally[k] = (tally[k] or 0) + 1; ex[k] = ex[k] or {}; if #ex[k] < 3 then ex[k][#ex[k] + 1] = e end end\nfor _, fnn in ipairs(store.data.nodes) do\n    for _, c in ipairs(store.topo():sites(fnn.id)) do\n        local to = callrec.to(c)\n        local cs = to and sums[to]\n        if cs and cs.pwx then\n            for pi in pairs(cs.pwx) do\n                if E._arg_target(store, c, pi, fnn) == want then\n                    local a = argv.at(c, pi)\n                    local where = ('%s:%d %s(#%d %s)'):format(callrec.file(c) or '?', callrec.line(c) or 0, (store.node(to) or {}).name or '?', pi, a and tostring(a.name or a.k) or '-')\n                    local keys, ids = R.arg_objs(c, pi)\n                    if not keys then bump('unknown: ' .. tostring(ids), where)\n                    elseif #ids == 0 then bump('no object reaches it', where)\n                    else\n                        local ins = 0\n                        for _, o in ipairs(ids) do if state[o] then ins = ins + 1 end end\n                        if ins == #ids then bump('MODULE STATE only', where)\n                        elseif ins > 0 then bump('module state + local objects', where)\n                        else bump('never module state', where) end\n                    end\n                end\n            end\n        end\n    end\nend\nlocal ks = vim.tbl_keys(tally); table.sort(ks, function (a, b) return tally[a] > tally[b] end)\nfor _, k in ipairs(ks) do print(('%5d  %-28s %s'):format(tally[k], k, table.concat(ex[k], ' | '))) end\n","file":"tools/experiments/writers_census.lua"}},"verb":"edit"}],"hand":0,"open_intents":[],"version":1,"replay":[{"id":"1791907406.987565-edit","verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/flowtype.lua"],"args":{"before":"    local CTXFNS = opts.ctxfns","file":"lua/cartograph/flowtype.lua","after":"    local CTXFNS = opts.ctxfns\n    -- (ARGUMENT PROBES, opts.argprobes — CART-1670: the ports of every resolved-or-not call's arguments, by call record\n    -- (a method's receiver is position 1, as in argv); R.arg_objs(c, i) answers which allocation sites reach one. The\n    -- writers census asks it: an opaque local handed to a param-mutating callee may hold a module table)\n    local ARGP = opts.argprobes and {} or nil"}}},{"id":"1791907407.060569-edit","verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/flowtype.lua"],"args":{"before":"            for _, a in ipairs(argn) do aps[#aps + 1] = expr(a) end","file":"lua/cartograph/flowtype.lua","after":"            for _, a in ipairs(argn) do aps[#aps + 1] = expr(a) end\n            if ARGP and c and not clone then ARGP[c] = aps end"}}},{"id":"1791907407.122779-edit","verb":"edit","invocation":{"verb":"edit","touched":["lua/cartograph/flowtype.lua"],"args":{"before":"    local R = { verdict = function (c) return verdicts[c] end, stats = stats, probes = probe_out }","file":"lua/cartograph/flowtype.lua","after":"    local R = { verdict = function (c) return verdicts[c] end, stats = stats, probes = probe_out }\n    -- (the allocation sites reaching argument i of call c -> { obinfo key… } | nil, why: a saturated or partial port,\n    -- an external value, no port — never a short list read a